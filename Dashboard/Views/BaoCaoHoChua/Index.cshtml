@using Dashboard.HtmlHelpers;
@using Dashboard.Models.HtmlHelpers
@{
    ViewBag.Title = "Báo cáo hồ chứa";
}
<section class="content">
    <div class="row">
        <div class="col-12">
            <div class="card card-primary">
                <div class="card-header">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <h3 class="card-title">Báo cáo hồ chứa</h3>
                        </div>
                        <div class="col-md-6">
                            <div class="row">
                                <div class="col-md-4">
                                    <select id="filterXaPhuong" class="form-control form-control-sm">
                                        <option value="">Tất cả Xã/Phường</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <select id="filterDonViQuanLy" class="form-control form-control-sm">
                                        <option value="">Tất cả Đơn vị quản lý</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <select id="filterPhanLoaiHo" class="form-control form-control-sm">
                                        <option value="">Tất cả Phân loại hồ</option>
                                        <option value="Nho">Nhỏ</option>
                                        <option value="Vua">Vừa</option>
                                        <option value="Lon">Lớn</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-tools">
                        <a class="btn btn-primary" href="#" onclick="exportBaoCao()">
                            <i class="fa fa-download"></i> Xuất Báo Cáo
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <table id="table" data-toggle="table" data-url="/BaoCaoHoChua/GetAll" data-pagination="true" data-side-pagination="server" data-page-list="[30, 50, 100, 200]" data-search="true" data-show-refresh="true" data-show-toggle="true" data-show-columns="true" data-sort-name="TenCongTrinh" data-sort-order="asc">
                        <thead>
                            <tr>
                                <th rowspan="2" data-field="Id" data-sortable="true" data-visible="false">ID</th>
                                <th rowspan="2" data-field="TT" data-sortable="true" data-formatter="sttFormatter">TT</th>
                                <th rowspan="2" data-field="TenCongTrinh" data-sortable="true">Tên công trình</th>
                                <th rowspan="2" data-field="Diadiem" data-sortable="true">Địa điểm</th>
                                <th rowspan="2" data-field="NamHoanThanhCongTrinh" data-sortable="true">Năm HT</th>
                                <th rowspan="2" data-field="DienTichLuuVuc_Km2" data-sortable="true">FLv (km²)</th>
                                <th colspan="2">F tưới (ha)</th>
                                <th rowspan="2" data-field="DungTichUngVoiMNDBT_TrieuM3" data-sortable="true">Dung tích ứng với MNDBT (triệu m³)</th>
                                <th colspan="3">Đập chính</th>
                                <th rowspan="2" data-field="SoDapPhu" data-sortable="true">Số đập phụ (cái)</th>
                                <th colspan="2">Cống lấy nước</th>
                                <th colspan="4">Tràn xã lũ</th>
                                <th rowspan="2" data-field="DungTichLongHoHienTai" data-sortable="true">Dung tích lòng hồ hiện tại</th>
                                <th rowspan="2" data-field="KhaNangDapUngNhuCauNuocThangToi" data-sortable="true">Khả năng đáp ứng nhu cầu nước tháng tới (%)</th>
                                <th rowspan="2" data-field="TrangThai" data-sortable="true">Trạng thái</th>
                                <th rowspan="2" data-field="operate" data-formatter="operateFormatter" data-events="operateEvents">Thao tác</th>
                            </tr>
                            <tr>
                                <th data-field="DienTichTuoiThucTe_Ha" data-sortable="true">TT</th>
                                <th data-field="DienTichTuoiThietKe_Ha" data-sortable="true">TK</th>
                                <th data-field="DapChinhHmax" data-sortable="true">Hmax (m)</th>
                                <th data-field="DapChinhB" data-sortable="true">B (m)</th>
                                <th data-field="DapChinhL" data-sortable="true">L (m)</th>
                                <th data-field="CongLayNuocKichThuoc" data-sortable="true">Kích thước (cm)</th>
                                <th data-field="CongLayNuocVatLieu" data-sortable="true">Vật liệu</th>
                                <th data-field="TranXaLuuCaoTrinh" data-sortable="true">Cao trình ngưỡng tràn (m)</th>
                                <th data-field="TranXaLuuB" data-sortable="true">B (m)</th>
                                <th data-field="TranXaLuuVatLieu" data-sortable="true">Vật liệu</th>
                                <th data-field="TranXaLuuHinhThuc" data-sortable="true">Hình thức</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
    </section>

    <script>
        var sttCounter = 0;

        function sttFormatter(value, row, index) {
            sttCounter++;
            return sttCounter;
        }

        function operateFormatter(value, row, index) {
            const btnEdit = `<button id='btn-edit' class='btn btn-primary btn-sm m-l-5 m-r-5 m-t-5 m-b-5'><i class='fa fa-edit'></i> Sửa</button>`;
            const btnDelete = `<button id='btn-delete' class='btn btn-danger btn-sm m-l-5 m-r-5 m-t-5 m-b-5'><i class='fa fa-trash'></i> Xóa</button>`;

            return [btnEdit + btnDelete].join("");
        }

        window.operateEvents = {
            'click #btn-edit': function (e, value, row, index) {
                window.location.href = '/BaoCaoHoChua/Form?id=' + row.Id;
            },
            'click #btn-delete': function (e, value, row, index) {
                if (confirm('Bạn có chắc chắn muốn xóa công trình này?')) {
                    $.ajax({
                        url: '/BaoCaoHoChua/Xoa',
                        type: 'POST',
                        data: { id: row.Id },
                        success: function (result) {
                            if (result) {
                                $('#table').bootstrapTable('refresh');
                                alert('Xóa thành công!');
                            } else {
                                alert('Xóa thất bại!');
                            }
                        },
                        error: function () {
                            alert('Có lỗi xảy ra khi xóa!');
                        }
                    });
                }
            }
        };

        $(document).ready(function () {
            // Load dữ liệu cho dropdown Xã/Phường
            loadXaPhuongOptions();

            // Load dữ liệu cho dropdown Đơn vị quản lý
            loadDonViQuanLyOptions();

            // Xử lý sự kiện thay đổi filter
            $('#filterXaPhuong, #filterDonViQuanLy, #filterPhanLoaiHo').on('change', function () {
                applyFilters();
            });
        });

        function loadXaPhuongOptions() {
            $.ajax({
                url: '/BaoCaoHoChua/GetAll',
                type: 'GET',
                data: { limit: 1000, offset: 0 },
                success: function (result) {
                    if (result && result.rows) {
                        var uniqueXaPhuong = [...new Set(result.rows.map(item => item.XaPhuong).filter(x => x))];
                        var select = $('#filterXaPhuong');
                        uniqueXaPhuong.forEach(function (xaPhuong) {
                            select.append('<option value="' + xaPhuong + '">' + xaPhuong + '</option>');
                        });
                    }
                }
            });
        }

        function loadDonViQuanLyOptions() {
            $.ajax({
                url: '/BaoCaoHoChua/GetAll',
                type: 'GET',
                data: { limit: 1000, offset: 0 },
                success: function (result) {
                    if (result && result.rows) {
                        var uniqueDonVi = [...new Set(result.rows.map(item => item.DonViQuanLy).filter(x => x))];
                        var select = $('#filterDonViQuanLy');
                        uniqueDonVi.forEach(function (donVi) {
                            select.append('<option value="' + donVi + '">' + donVi + '</option>');
                        });
                    }
                }
            });
        }

        function applyFilters() {
            var xaPhuong = $('#filterXaPhuong').val();
            var donViQuanLy = $('#filterDonViQuanLy').val();
            var phanLoaiHo = $('#filterPhanLoaiHo').val();

            // Reset counter khi filter
            sttCounter = 0;

            // Refresh table với filter parameters
            $('#table').bootstrapTable('refresh', {
                url: '/BaoCaoHoChua/GetAll',
                query: {
                    xaPhuong: xaPhuong,
                    donViQuanLy: donViQuanLy,
                    phanLoaiHo: phanLoaiHo
                }
            });
        }

        function exportBaoCao() {
            var xaPhuong = encodeURIComponent($('#filterXaPhuong').val() || '');
            var donViQuanLy = encodeURIComponent($('#filterDonViQuanLy').val() || '');
            var phanLoaiHo = encodeURIComponent($('#filterPhanLoaiHo').val() || '');
            // mở link tải file với các tham số filter hiện tại + chống cache
            var url = '/BaoCaoHoChua/Export?xaPhuong=' + xaPhuong + '&donViQuanLy=' + donViQuanLy + '&phanLoaiHo=' + phanLoaiHo + '&t=' + Date.now();
            window.location.href = url;
        }
    </script>
