@using Dashboard.HtmlHelpers
@{
    ViewBag.Title = "Quản lý công việc chung";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card card-primary">
                    <div class="card-header">
                        <div class="card-title">
                            <b>@ViewBag.Title</b>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-sm-2 col-xs-12">
                                <a href="/CongViecChung/Form?id=0" class="btn btn-success">
                                    <i class="fa fa-plus"></i> Thêm mới
                                </a>
                            </div>
                            <div class="col-sm-10 col-xs-12">
                                <div class="input-group">
                                    <input onkeypress="enterSearch(event);" id="txt-search" type="text" class="form-control" placeholder="Tìm kiếm">
                                    <div class="input-group-append">
                                        <button id="btn-search" onclick="search();" class="btn btn-primary" type="button">
                                            <i class="fa fa-search"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-sm-12 mt-2">
                                <table id="bs-table"
                                       data-mobile-responsive="true"
                                       data-check-on-init="true"
                                       data-toggle="table"
                                       data-toolbar="#get"
                                       data-url="/CongViecChung/GetList"
                                       data-pagination="true"
                                       data-side-pagination="server"
                                       data-page-size="30"
                                       data-page-list="[30, 50, 100, 200]"
                                       data-locale="vi-VN"
                                       data-query-params="queryParams"
                                       data-sort-name="Ten"
                                       data-sort-order="asc">
                                    <thead>
                                        <tr>
                                            <th data-field="Ten">Tên công việc</th>
                                            <th data-field="NgayTao" data-formatter="dateFormatter">Ngày tạo</th>
                                            <th data-field="ThanhVienNames">Thành viên</th>
                                            <th data-field="SoThanhVien" data-align="center">Số thành viên</th>
                                            <th data-field="operate" data-formatter="operateFormatter" data-events="operateEvents">&nbsp;</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    function dateFormatter(value) {
        if (value) {
            return moment(value).format('DD/MM/YYYY');
        }
        return '';
    }

    function operateFormatter(value, row, index) {
         return [
            `<a href="/CongViecChung/Form?id=${row.Id}" class="btn btn-primary btn-sm m-1"><i class="fa fa-pencil"></i></a>`,
            `<button class="btn btn-danger btn-sm m-1 delete-item"><i class="fa fa-trash"></i></button>`
        ].join('');
    }

    window.operateEvents = {
        'click .delete-item': function (e, value, row, index) {
            if (confirm('Bạn có chắc chắn muốn xóa?')) {
                $.post('/CongViecChung/Delete', { id: row.Id }, function (res) {
                    if (res) {
                        toastr.success('Xóa thành công');
                        search();
                    } else {
                        toastr.error('Có lỗi xảy ra');
                    }
                });
            }
        }
    };

    function queryParams(params) {
        params.keyword = $("#txt-search").val();
        return params;
    }

    function search() {
        $('#bs-table').bootstrapTable('refresh');
    }

    function enterSearch(e) {
        if (e.keyCode === 13) {
            search();
        }
    }
</script>
