@using Dashboard.HtmlHelpers;
@using Dashboard.Models.HtmlHelpers
@using System.Configuration;
@using Dashboard.Common;

<style>
    .clipboard-upload-zone {
        margin-top: 10px;
        padding: 16px;
        border: 2px dashed #17a2b8;
        border-radius: 6px;
        background-color: #f4fbfd;
        color: #0c5460;
        text-align: center;
        cursor: text;
        transition: background-color 0.2s ease, border-color 0.2s ease;
    }

    .clipboard-upload-zone:focus,
    .clipboard-upload-zone.is-active {
        outline: none;
        background-color: #e8f7fb;
        border-color: #138496;
    }

    .clipboard-upload-zone.is-dragover {
        background-color: #dff3f8;
        border-color: #0f6f7e;
    }

    .clipboard-upload-zone .hint {
        margin: 0;
    }
</style>

<div class="row">
    <div class="col-sm-12 text-right">
        <label class="btn btn-primary m-b-0" for="TaiLieuCuocHopUpload">
            <input id="TaiLieuCuocHopUpload" type="file" class="d-none" multiple accept="@Dashboard.Common.BienDungChung.AllowedFileExtensions">
            <i class="fa fa-upload"></i> Tải tài liệu
        </label>
        <p id="TaiLieuCuocHopError" class="text-danger m-b-0"></p>
    </div>
</div>
<div class="row">
    <div class="col-sm-12">
        <div id="TaiLieuCuocHopDropZone" class="clipboard-upload-zone" contenteditable="true" tabindex="0">
            <p class="hint"><i class="fa fa-clipboard"></i> Click vào đây rồi nhấn <b>Ctrl + V</b> để dán ảnh hoặc kéo thả file từ Windows vào đây</p>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-sm-12 p-t-15 tb-height-auto">
        <table id="bsTaiLieuCuocHop"
               data-locale="vi-VN">
            <thead>
                <tr>
                    <th data-field="Name">Tài liệu</th>
                    <th data-width="200" data-align="center" data-field="operate"
                        data-formatter="actionTaiLieuCuocHop">&nbsp;</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
<script type="text/javascript">
    var TaiLieuCuocHopDatas = [];

    function renderTaiLieuCuocHopTable() {
        $("#bsTaiLieuCuocHop").bootstrapTable("destroy");
        $("#bsTaiLieuCuocHop").bootstrapTable({ data: TaiLieuCuocHopDatas });
    }

    function addTaiLieuCuocHop(files) {
        if (!files || files.length === 0) {
            return;
        }

        $("#TaiLieuCuocHopError").text("");

        for (var i = 0; i < files.length; i++) {
            TaiLieuCuocHopDatas.unshift({
                "Id": new Date().getTime() + i,
                "Name": files[i].name,
                "File": files[i],
                "IsUpload": false
            });
        }

        renderTaiLieuCuocHopTable();
    }

    function getClipboardImageExtension(mimeType) {
        if (!mimeType) {
            return "png";
        }

        var mimeParts = mimeType.split("/");
        if (mimeParts.length < 2) {
            return "png";
        }

        return mimeParts[1].replace("jpeg", "jpg");
    }

    function resetTaiLieuCuocHopDropZone() {
        $("#TaiLieuCuocHopDropZone").html('<p class="hint"><i class="fa fa-clipboard"></i> Click vào đây rồi nhấn <b>Ctrl + V</b> để dán ảnh hoặc kéo thả file từ Windows vào đây</p>');
    }

    renderTaiLieuCuocHopTable();

    $("#TaiLieuCuocHopUpload").change(function () {
        let input = this;
        if (input.files && input.files.length > 0) {
            addTaiLieuCuocHop(input.files);
        }

        input.value = "";
    });

    $("#TaiLieuCuocHopDropZone")
        .on("focus", function () {
            $(this).addClass("is-active");
        })
        .on("blur", function () {
            $(this).removeClass("is-active");
            resetTaiLieuCuocHopDropZone();
        })
        .on("dragenter dragover", function (e) {
            e.preventDefault();
            e.stopPropagation();
            $(this).addClass("is-dragover");
        })
        .on("dragleave", function (e) {
            e.preventDefault();
            e.stopPropagation();
            $(this).removeClass("is-dragover");
        })
        .on("drop", function (e) {
            e.preventDefault();
            e.stopPropagation();
            $(this).removeClass("is-dragover");

            let dropEvent = e.originalEvent || e;
            let files = dropEvent.dataTransfer ? dropEvent.dataTransfer.files : null;

            resetTaiLieuCuocHopDropZone();

            if (!files || files.length === 0) {
                $("#TaiLieuCuocHopError").text("Không có file nào được kéo thả.");
                return;
            }

            addTaiLieuCuocHop(files);
        })
        .on("paste", function (e) {
            let clipboardEvent = e.originalEvent || e;
            let clipboardData = clipboardEvent.clipboardData;
            let files = [];

            if (!clipboardData || !clipboardData.items) {
                $("#TaiLieuCuocHopError").text("Trình duyệt không hỗ trợ dán ảnh từ clipboard.");
                return;
            }

            for (var i = 0; i < clipboardData.items.length; i++) {
                let item = clipboardData.items[i];
                if (item.kind === "file" && item.type.indexOf("image/") === 0) {
                    let blob = item.getAsFile();
                    if (blob) {
                        let extension = getClipboardImageExtension(blob.type);
                        let fileName = "clipboard-image-" + new Date().getTime() + "-" + i + "." + extension;
                        files.push(new File([blob], fileName, { type: blob.type }));
                    }
                }
            }

            e.preventDefault();
            resetTaiLieuCuocHopDropZone();

            if (files.length === 0) {
                $("#TaiLieuCuocHopError").text("Clipboard hiện không có ảnh để dán.");
                return;
            }

            addTaiLieuCuocHop(files);
        });

    function actionTaiLieuCuocHop(value, row, index) {
        let deleteBtn =
            `<button onclick="xoaTaiLieuCuocHop(${row.Id}, ${row.IsUpload} )" class='btn btn-danger btn-sm m-l-5 m-r-5 m-t-5 m-b-5'>
                <i class='fa fa-trash'></i> Xóa</button>`;

        let viewBtn = '';
        let downloadBtn = '';
        if (row.DuongDan && row.IsUpload) {
            downloadBtn = `<button onclick="downloadFromLink('${row.DuongDan}', '${row.Name}')" class='btn btn-primary btn-sm m-l-5 m-r-5 m-t-5 m-b-5'>
                <i class='fa fa-download'></i> Tải xuống</button>`;

            var filePath = row.DuongDan;
            var extension = filePath.split('.').pop().toLowerCase();
            var allowedViewExtensions = ['doc', 'docx', 'xls', 'xlsx', 'pdf', 'jpg', 'jpeg', 'png', 'gif', 'bmp', 'webp', 'svg'];

            if (allowedViewExtensions.includes(extension)) {
                viewBtn = `<button onclick="openViewFileModal('${row.DuongDan}', '${row.Name}')" class='btn btn-info btn-sm m-l-5 m-r-5 m-t-5 m-b-5'>
                    <i class='fa fa-eye'></i> Xem</button>`;
            }
        }

        if (row.IsUpload) {
            return viewBtn + downloadBtn + deleteBtn;
        }

        return deleteBtn;
    }

    function xoaTaiLieuCuocHop(id, isUpload) {
        if (confirm("Bạn có muốn xóa tài liệu này?") == true) {
            var index = TaiLieuCuocHopDatas.findIndex(x => x.Id === id);
            if (index >= 0) {
                TaiLieuCuocHopDatas.splice(index, 1);

                if (isUpload == true) {
                    $.ajax({
                        url: "/CuocHopDangKy/XoaTaiLieuCuocHop?id=" + id,
                        processData: false,
                        type: "GET",
                        success: function (data) {

                        },
                        error: function () {
                            toastr.error("Đã có lỗi xảy ra. Vui lòng tải lại trang.");
                        }
                    });
                }
            }

            renderTaiLieuCuocHopTable();
        }
    };

    function ajaxTaiLieuCuocHopServer() {
        TaiLieuCuocHopDatas = [];
        renderTaiLieuCuocHopTable();

        if ($("#Id").val() && $("#Id").val() > 0) {
            $.ajax({
                url: "/CuocHopDangKy/GetTaiLieuCuocHop?id=" + $("#Id").val(),
                processData: false,
                type: "GET",
                success: function (data) {
                    TaiLieuCuocHopDatas = data;
                    renderTaiLieuCuocHopTable();
                },
                error: function () {
                    toastr.error("Đã có lỗi xảy ra. Vui lòng tải lại trang.");
                }
            });
        }
        else {
            renderTaiLieuCuocHopTable();
        }
    }
</script>
