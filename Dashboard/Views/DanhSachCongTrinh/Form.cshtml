@using Dashboard.HtmlHelpers;
@using Dashboard.Models.HtmlHelpers
@{
    ViewBag.Title = "Form Danh sách công trình";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Thông tin công trình</h3>
            </div>
            <div class="card-body">
                <form id="form">
                    <input type="hidden" id="Id" name="Id" value="@ViewBag.Id" />

                    <div class="row">
                        @Html.CustomDropDownList(id: "LoaiCongTrinh", label: "Loại công trình", col: 6, required: true, options: new List<SelectListItem> {
                            new SelectListItem { Text = "--- Chọn ---", Value = "0" },
                            new SelectListItem { Text = "Hồ", Value = "1" },
                            new SelectListItem { Text = "Đập Dâng", Value = "2" },
                            new SelectListItem { Text = "Đập Ngăn Mặn", Value = "3" },
                            new SelectListItem { Text = "Trạm Khí Tượng", Value = "4" },
                            new SelectListItem { Text = "Trạm Thủy Văn", Value = "5" }
                        })
                        @Html.CustomTextBox(id: "TenCongTrinh", label: "Tên công trình", col: 6, length: 200, required: true)
                    </div>

                    <div class="row">
                        @Html.CustomTextBox(id: "Diadiem", label: "Địa điểm", col: 6, length: 200, required: true)
                        @Html.CustomTextBox(id: "NamXayDung", label: "Năm xây dựng", col: 6, length: 50)
                    </div>

                    <div class="row">
                        @Html.CustomTextBox(id: "ChuDauTu", label: "Chủ đầu tư", col: 6, length: 200)
                        @Html.CustomTextBox(id: "QuyMo", label: "Quy mô", col: 6, length: 200)
                    </div>

                    <div class="row">
                        @Html.CustomTextBox(id: "DienTich", label: "Diện tích", col: 6, length: 200)
                        @Html.CustomTextBox(id: "ThongSoKiThuat", label: "Thông số kỹ thuật", col: 6, length: 200)
                    </div>

                    <div class="row">
                        @Html.CustomTextArea(id: "GhiChu", label: "Ghi chú", col: 12, row: 3, maxlength: 1000)
                    </div>

                    <!-- Các trường đặc biệt cho loại Hồ -->
                    <div id="hoFields" style="display: none;">
                        <div class="card mt-3">
                            <div class="card-header">
                                <h4 class="card-title">Thông tin chi tiết Hồ</h4>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    @Html.CustomTextBox(id: "MucNuocChet_MNC", label: "Mực nước chết - MNC (m)", col: 6, length: 50)
                                    @Html.CustomTextBox(id: "MucNuocDangBinhThuong_MNDBT", label: "Mực nước dâng bình thường - MNDBT (m)", col: 6, length: 50)
                                </div>
                                <div class="row">
                                    @Html.CustomTextBox(id: "MucNuocLuuThietKe_MNLTK", label: "Mực nước lũ thiết kế - MNLTK (m)", col: 6, length: 50)
                                    @Html.CustomTextBox(id: "MucNuocLuuKiemTra", label: "Mực nước lũ kiểm tra (m)", col: 6, length: 50)
                                </div>
                                <div class="row">
                                    @Html.CustomTextBox(id: "NamHoanThanhCongTrinh", label: "Năm hoàn thành công trình", col: 4, length: 10)
                                    @Html.CustomTextBox(id: "LanNangCapSuaChua", label: "Lần nâng cấp, sửa chữa", col: 4, length: 10)
                                    @Html.CustomTextBox(id: "NamNangCapSuaChuaGanNhat", label: "Năm nâng cấp, sửa chữa gần nhất", col: 4, length: 10)
                                </div>
                                <div class="row">
                                    @Html.CustomTextBox(id: "DungTichChet_TrieuM3", label: "Dung tích chết (triệu m³)", col: 6, length: 50)
                                    @Html.CustomTextBox(id: "DungTichUngVoiMNDBT_TrieuM3", label: "Dung tích ứng với MNDBT (triệu m³)", col: 6, length: 50)
                                </div>
                                <div class="row">
                                    @Html.CustomTextBox(id: "DungTichUngVoiMNLTK_TrieuM3", label: "Dung tích ứng với MNLTK (triệu m³)", col: 6, length: 50)
                                    @Html.CustomTextBox(id: "DungTichHuuIch_TrieuM3", label: "Dung tích hữu ích (triệu m³)", col: 6, length: 50)
                                </div>
                                <div class="row">
                                    @Html.CustomTextBox(id: "DungTichPhongLuu_TrieuM3", label: "Dung tích phòng lũ (triệu m³)", col: 6, length: 50)
                                    @Html.CustomTextBox(id: "DienTichLuuVuc_Km2", label: "Diện tích lưu vực (km²)", col: 6, length: 50)
                                </div>
                                <div class="row">
                                    @Html.CustomTextBox(id: "DienTichTuoiThietKe_Ha", label: "Diện tích tưới thiết kế (ha)", col: 6, length: 50)
                                    @Html.CustomTextBox(id: "DienTichMatThoangUngVoiMNDBT_Ha", label: "Diện tích mặt thoáng ứng với MNDBT (ha)", col: 6, length: 50)
                                </div>
                                <div class="row">
                                    @Html.CustomTextBox(id: "DienTichMatThoangUngVoiMNC_Ha", label: "Diện tích mặt thoáng ứng với MNC (ha)", col: 6, length: 50)
                                    @Html.CustomTextBox(id: "XaPhuong", label: "Xã/Phường", col: 6, length: 200)
                                </div>
                                <div class="row">
                                    @Html.CustomTextBox(id: "DonViQuanLy", label: "Đơn vị quản lý", col: 6, length: 200)
                                    @Html.CustomTextBox(id: "NguoiDung", label: "Người dùng", col: 6, length: 200)
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Các trường đặc biệt cho loại Đập Dâng -->
                    <div id="dapDangFields" style="display: none;">
                        <div class="card mt-3">
                            <div class="card-header">
                                <h4 class="card-title">Thông tin chi tiết Đập Dâng</h4>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    @Html.CustomTextBox(id: "NamHoanThanhCongTrinh", label: "Năm hoàn thành công trình", col: 4, length: 10)
                                    @Html.CustomTextBox(id: "LanNangCapSuaChua", label: "Lần nâng cấp, sửa chữa", col: 4, length: 10)
                                    @Html.CustomTextBox(id: "NamNangCapSuaChuaGanNhat", label: "Năm nâng cấp, sửa chữa gần nhất", col: 4, length: 10)
                                </div>
                                <div class="row">
                                    @Html.CustomTextBox(id: "DienTichLuuVuc_Km2", label: "Diện tích lưu vực (km²)", col: 6, length: 50)
                                    @Html.CustomTextBox(id: "DienTichTuoiThietKe_Ha", label: "Diện tích tưới thiết kế (ha)", col: 6, length: 50)
                                </div>
                                <div class="row">
                                    @Html.CustomTextBox(id: "DienTichTuoiThucTe_Ha", label: "Diện tích tưới thực tế (ha)", col: 6, length: 50)
                                    @Html.CustomTextBox(id: "CaoTrinhNguongPhanKhongTran_M", label: "Cao trình ngưỡng phần không tràn (m)", col: 6, length: 50)
                                </div>
                                <div class="row">
                                    @Html.CustomTextBox(id: "ChieuCaoDapLonNhatTrenCongTrinhPhanKhongTran_M", label: "Chiều cao đập lớn nhất trên công trình phần không tràn (m)", col: 6, length: 50)
                                    @Html.CustomTextBox(id: "ChieuDaiPhanKhongTran_M", label: "Chiều dài phần không tràn (m)", col: 6, length: 50)
                                </div>
                                <div class="row">
                                    @Html.CustomTextBox(id: "CaoTrinhNguongPhanTran_M", label: "Cao trình ngưỡng phần tràn (m)", col: 6, length: 50)
                                    @Html.CustomTextBox(id: "ChieuCaoDapLonNhatTrenCongTrinhPhanTran_M", label: "Chiều cao đập lớn nhất trên công trình phần tràn (m)", col: 6, length: 50)
                                </div>
                                <div class="row">
                                    @Html.CustomTextBox(id: "ChieuDaiPhanTran_M", label: "Chiều dài phần tràn (m)", col: 6, length: 50)
                                    @Html.CustomTextBox(id: "CotNuocThietKeTrenCongTrinh_M", label: "Cột nước thiết kế trên công trình (m)", col: 6, length: 50)
                                </div>
                                <div class="row">
                                    @Html.CustomTextBox(id: "LuuLuongThietKe", label: "Lưu lượng thiết kế", col: 6, length: 50)
                                    @Html.CustomTextBox(id: "CaoTrinhNguongCongXaCat_M", label: "Cao trình ngưỡng cống xả cát (m)", col: 6, length: 50)
                                </div>
                                <div class="row">
                                    @Html.CustomTextBox(id: "KichThuocCongXaCat_Cm", label: "Kích thước cống xả cát (cm)", col: 6, length: 50)
                                    @Html.CustomTextBox(id: "VatLieuKetCauCongXaCat", label: "Vật liệu kết cấu cống xả cát", col: 6, length: 200)
                                </div>
                                <div class="row">
                                    @Html.CustomTextBox(id: "CaoTrinhNguongCongCapNuoc_M", label: "Cao trình ngưỡng cống cấp nước (m)", col: 6, length: 50)
                                    @Html.CustomTextBox(id: "LuuLuongThietKeCongCapNuoc", label: "Lưu lượng thiết kế cống cấp nước", col: 6, length: 50)
                                </div>
                                <div class="row">
                                    @Html.CustomTextBox(id: "KichThuocCongCapNuoc_Cm", label: "Kích thước cống cấp nước (cm)", col: 6, length: 50)
                                    @Html.CustomTextBox(id: "VatLieuCongCapNuoc", label: "Vật liệu cống cấp nước", col: 6, length: 200)
                                </div>
                                <div class="row">
                                    @Html.CustomTextBox(id: "DonViQuanLyCongTrinh", label: "Đơn vị quản lý công trình", col: 6, length: 200)
                                    @Html.CustomTextBox(id: "TinhTrangCongTrinh", label: "Tình trạng công trình", col: 6, length: 200)
                                </div>
                                <div class="row">
                                    @Html.CustomTextBox(id: "KinhDo_Longitude", label: "Kinh độ (Longitude)", col: 6, length: 50)
                                    @Html.CustomTextBox(id: "ViDo_Latitude", label: "Vĩ độ (Latitude)", col: 6, length: 50)
                                </div>
                                <div class="row">
                                    @Html.CustomTextBox(id: "XaPhuong", label: "Xã/Phường", col: 6, length: 200)
                                    @Html.CustomTextBox(id: "NguoiDung", label: "Người dùng", col: 6, length: 200)
                                </div>
                                <div class="row">
                                    @Html.CustomTextBox(id: "TrangThai", label: "Trạng thái", col: 6, length: 50)
                                    @Html.CustomTextBox(id: "ThuTuUuTien", label: "Thứ tự ưu tiên", col: 6, length: 10)
                                </div>
                                <div class="row">
                                    @Html.CustomTextArea(id: "GhiChu", label: "Ghi chú", col: 12, row: 3, maxlength: 1000)
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Các trường đặc biệt cho loại Đập Ngăn Mặn -->
                    <div id="dapNganManFields" style="display: none;">
                        <div class="card mt-3">
                            <div class="card-header">
                                <h4 class="card-title">Thông tin chi tiết Đập Ngăn Mặn</h4>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    @Html.CustomTextBox(id: "SoLanNangCapSuaChua", label: "Số lần nâng cấp sửa chữa", col: 6, length: 10)
                                    @Html.CustomTextBox(id: "NamNangCapSuaChuaGanNhat", label: "Năm nâng cấp sửa chữa gần nhất", col: 6, length: 10)
                                </div>
                                <div class="row">
                                    @Html.CustomTextBox(id: "SoKhoang", label: "Số khoang", col: 6, length: 10)
                                    @Html.CustomTextBox(id: "KichThuocKhoang_M", label: "Kích thước khoang (m)", col: 6, length: 50)
                                </div>
                                <div class="row">
                                    @Html.CustomTextBox(id: "KichThuocPhanTran_M", label: "Kích thước (Phần tràn) (m)", col: 6, length: 50)
                                    @Html.CustomTextBox(id: "TenSong", label: "Tên sông", col: 6, length: 200)
                                </div>
                                <div class="row">
                                    @Html.CustomTextBox(id: "ChieuCaoDinh_M", label: "Chiều cao đỉnh (m)", col: 6, length: 50)
                                    @Html.CustomTextBox(id: "DienTichNganMan_Ha", label: "Diện tích ngăn mặn (ha)", col: 6, length: 50)
                                </div>
                                <div class="row">
                                    @Html.CustomTextBox(id: "CaoTrinhDinhDapPhanKhongTran_M", label: "Cao trình đỉnh đập (Phần không tràn) (m)", col: 6, length: 50)
                                    @Html.CustomTextBox(id: "DienTichTuoiThietKe_Ha", label: "Diện tích tưới thiết kế (ha)", col: 6, length: 50)
                                </div>
                                <div class="row">
                                    @Html.CustomTextBox(id: "DienTichTuoiThucTe_Ha", label: "Diện tích tưới thực tế (ha)", col: 6, length: 50)
                                    @Html.CustomTextBox(id: "MucNuocLonNhat_M", label: "Mực nước lớn nhất (m)", col: 6, length: 50)
                                </div>
                                <div class="row">
                                    @Html.CustomTextBox(id: "ChieuDaiDapPhanKhongTran_M", label: "Chiều dài đập (Phần không tràn) (m)", col: 6, length: 50)
                                    @Html.CustomTextBox(id: "ChieuDaiDapPhanTran_M", label: "Chiều dài đập (Phần tràn) (m)", col: 6, length: 50)
                                </div>
                                <div class="row">
                                    @Html.CustomTextBox(id: "DonViQuanLyCongTrinh", label: "Đơn vị quản lý công trình", col: 6, length: 200)
                                    @Html.CustomTextBox(id: "TinhTrangCongTrinh", label: "Tình trạng công trình", col: 6, length: 200)
                                </div>
                                <div class="row">
                                    @Html.CustomTextBox(id: "KinhDo_Longitude", label: "Kinh độ (Longitude)", col: 6, length: 50)
                                    @Html.CustomTextBox(id: "ViDo_Latitude", label: "Vĩ độ (Latitude)", col: 6, length: 50)
                                </div>
                                <div class="row">
                                    @Html.CustomTextBox(id: "XaPhuong", label: "Xã/Phường", col: 6, length: 200)
                                    @Html.CustomTextBox(id: "NguoiDung", label: "Người dùng", col: 6, length: 200)
                                </div>
                                <div class="row">
                                    @Html.CustomTextBox(id: "TrangThai", label: "Trạng thái", col: 6, length: 50)
                                    @Html.CustomTextBox(id: "ThuTuUuTien", label: "Thứ tự ưu tiên", col: 6, length: 10)
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Các trường đặc biệt cho loại Trạm Khí Tượng -->
                    <div id="tramKhiTuongFields" style="display: none;">
                        <div class="card mt-3">
                            <div class="card-header">
                                <h4 class="card-title">Thông tin chi tiết Trạm Khí Tượng</h4>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    @Html.CustomTextBox(id: "LoaiTram", label: "Loại trạm", col: 6, length: 200)
                                    @Html.CustomTextBox(id: "KinhDo_Longitude", label: "Kinh độ (Longitude)", col: 6, length: 50)
                                </div>
                                <div class="row">
                                    @Html.CustomTextBox(id: "ViDo_Latitude", label: "Vĩ độ (Latitude)", col: 6, length: 50)
                                    @Html.CustomTextBox(id: "Song", label: "Sông", col: 6, length: 200)
                                </div>
                                <div class="row">
                                    @Html.CustomTextBox(id: "XaPhuong", label: "Xã/Phường", col: 6, length: 200)
                                    @Html.CustomTextBox(id: "Thiessen", label: "Thiessen", col: 6, length: 200)
                                </div>
                                <div class="row">
                                    @Html.CustomTextBox(id: "TrangThai", label: "Trạng thái", col: 6, length: 50)
                                    @Html.CustomTextBox(id: "ThuTuUuTien", label: "Thứ tự ưu tiên", col: 6, length: 10)
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Các trường đặc biệt cho loại Trạm Thủy Văn -->
                    <div id="tramThuyVanFields" style="display: none;">
                        <div class="card mt-3">
                            <div class="card-header">
                                <h4 class="card-title">Thông tin chi tiết Trạm Thủy Văn</h4>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    @Html.CustomTextBox(id: "LoaiTram", label: "Loại trạm", col: 6, length: 200)
                                    @Html.CustomTextBox(id: "KinhDo_Longitude", label: "Kinh độ (Longitude)", col: 6, length: 50)
                                </div>
                                <div class="row">
                                    @Html.CustomTextBox(id: "ViDo_Latitude", label: "Vĩ độ (Latitude)", col: 6, length: 50)
                                    @Html.CustomTextBox(id: "Song", label: "Sông", col: 6, length: 200)
                                </div>
                                <div class="row">
                                    @Html.CustomTextBox(id: "XaPhuong", label: "Xã/Phường", col: 6, length: 200)
                                    @Html.CustomTextBox(id: "Thiessen", label: "Thiessen", col: 6, length: 200)
                                </div>
                                <div class="row">
                                    @Html.CustomTextBox(id: "TrangThai", label: "Trạng thái", col: 6, length: 50)
                                    @Html.CustomTextBox(id: "ThuTuUuTien", label: "Thứ tự ưu tiên", col: 6, length: 10)
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        @Html.FileDinhKem(id: "FileDinhKem")
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <a class="btn btn-primary" href="javascript:void(0)" onclick="luu()">
                                <i class="fa fa-save"></i> Lưu
                            </a>
                            <a class="btn btn-light mr-2" href="/DanhSachCongTrinh">
                                <i class="fa fa-chevron-left"></i> Quay lại
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal thông báo thành công -->
<div class="modal fade" id="successModal" tabindex="-1" role="dialog" aria-labelledby="successModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="successModalLabel">
                    <i class="fa fa-check-circle"></i> Thành công
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body text-center">
                <div class="mb-3">
                    <i class="fa fa-check-circle text-success" style="font-size: 48px;"></i>
                </div>
                <h4 class="text-success">Thêm mới thành công!</h4>
                <p class="text-muted">Dữ liệu đã được lưu vào hệ thống.</p>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-success" data-dismiss="modal" onclick="redirectToList()">
                    <i class="fa fa-check"></i> Đồng ý
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal thông báo lỗi -->
<div class="modal fade" id="errorModal" tabindex="-1" role="dialog" aria-labelledby="errorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="errorModalLabel">
                    <i class="fa fa-exclamation-triangle"></i> Lỗi
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body text-center">
                <div class="mb-3">
                    <i class="fa fa-exclamation-triangle text-danger" style="font-size: 48px;"></i>
                </div>
                <h4 class="text-danger">Có lỗi xảy ra!</h4>
                <p class="text-muted" id="errorMessage">Vui lòng thử lại sau.</p>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-danger" data-dismiss="modal">
                    <i class="fa fa-times"></i> Đóng
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        var id = $('#Id').val();
        if (id > 0) {
            loadData();
        }
        
        // Show/hide fields based on LoaiCongTrinh selection
        $('#LoaiCongTrinh').change(function() {
            toggleSpecialFields();
        });
        
        // Initial check
        toggleSpecialFields();
    });
    
    function toggleSpecialFields() {
        var loaiCongTrinh = $('#LoaiCongTrinh').val();
        
        // Hide all special fields first
        $('#hoFields').hide();
        $('#dapDangFields').hide();
        $('#dapNganManFields').hide();
        $('#tramKhiTuongFields').hide();
        $('#tramThuyVanFields').hide();
        
        // Show appropriate fields based on selection
        if (loaiCongTrinh == '1') { // Hồ
            $('#hoFields').show();
        } else if (loaiCongTrinh == '2') { // Đập Dâng
            $('#dapDangFields').show();
        } else if (loaiCongTrinh == '3') { // Đập Ngăn Mặn
            $('#dapNganManFields').show();
        } else if (loaiCongTrinh == '4') { // Trạm Khí Tượng
            $('#tramKhiTuongFields').show();
        } else if (loaiCongTrinh == '5') { // Trạm Thủy Văn
            $('#tramThuyVanFields').show();
        }
    }

    function loadData() {
        var id = $('#Id').val();
        $.ajax({
            url: '/DanhSachCongTrinh/GetById',
            type: 'GET',
            data: { id: id },
            success: function (result) {
                if (result.Item) {
                    $('#TenCongTrinh').val(result.Item.TenCongTrinh);
                    $('#Diadiem').val(result.Item.Diadiem);
                    $('#LoaiCongTrinh').val(result.Item.LoaiCongTrinh);
                    $('#NamXayDung').val(result.Item.NamXayDung);
