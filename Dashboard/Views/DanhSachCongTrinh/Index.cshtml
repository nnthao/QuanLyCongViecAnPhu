@using Dashboard.HtmlHelpers;
@using Dashboard.Models.HtmlHelpers
@{
    ViewBag.Title = "Danh sách công trình";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Danh sách công trình</h3>
                <div class="card-tools">
                    <a class="btn btn-primary" href="/DanhSachCongTrinh/Form?id=0">
                        <i class="fa fa-plus"></i> Thêm mới
                    </a>
                </div>
            </div>
            <div class="card-body">
                <table id="table" data-toggle="table" data-url="/DanhSachCongTrinh/GetListDanhSachCongTrinh" data-pagination="true" data-side-pagination="server" data-page-list="[30, 50, 100, 200]" data-search="true" data-show-refresh="true" data-show-toggle="true" data-show-columns="true" data-sort-name="TenCongTrinh" data-sort-order="asc">
                    <thead>
                        <tr>
                            <th data-field="Id" data-sortable="true" data-visible="false">ID</th>
                            <th data-field="TenCongTrinh" data-sortable="true">Tên công trình</th>
                            <th data-field="Diadiem" data-sortable="true">Địa điểm</th>
                            <th data-field="LoaiCongTrinh" data-sortable="true" data-formatter="loaiCongTrinhFormatter">Loại công trình</th>
                            <th data-field="NamXayDung" data-sortable="true">Năm xây dựng</th>
                            <th data-field="ChuDauTu" data-sortable="true">Chủ đầu tư</th>
                            <th data-field="QuyMo" data-sortable="true">Quy mô</th>
                            <th data-field="DienTich" data-sortable="true">Diện tích</th>
                            <th data-field="ThongSoKiThuat" data-sortable="true">Thông số kỹ thuật</th>
                            <th data-field="GhiChu" data-sortable="true">Ghi chú</th>
                            <th data-field="operate" data-formatter="operateFormatter" data-events="operateEvents">Thao tác</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    function loaiCongTrinhFormatter(value, row, index) {
        var loaiCongTrinhMap = {
            0: '--- Chọn ---',
            1: 'Hồ',
            2: 'Đập Dâng',
            3: 'Đập Ngăn Mặn',
            4: 'Trạm Khí Tượng',
            5: 'Trạm Thủy Văn'
        };
        return loaiCongTrinhMap[value] || value;
    }

    function operateFormatter(value, row, index) {
        return [
            '<a class="btn btn-primary btn-sm" href="/DanhSachCongTrinh/Form?id=' + row.Id + '">',
            '<i class="fa fa-edit"></i> Sửa',
            '</a> ',
            '<a class="btn btn-danger btn-sm" href="javascript:void(0)" onclick="xoa(' + row.Id + ')">',
            '<i class="fa fa-trash"></i> Xóa',
            '</a>'
        ].join('');
    }

    window.operateEvents = {
        'click .btn-primary': function (e, value, row, index) {
            window.location.href = '/DanhSachCongTrinh/Form?id=' + row.Id;
        },
        'click .btn-danger': function (e, value, row, index) {
            xoa(row.Id);
        }
    };

    function xoa(id) {
        if (confirm('Bạn có chắc chắn muốn xóa?')) {
            $.ajax({
                url: '/DanhSachCongTrinh/Xoa',
                type: 'POST',
                data: { Id: id },
                success: function (result) {
                    if (result) {
                        alert('Xóa thành công!');
                        $('#table').bootstrapTable('refresh');
                    } else {
                        alert('Xóa thất bại!');
                    }
                },
                error: function () {
                    alert('Có lỗi xảy ra!');
                }
            });
        }
    }
</script>
