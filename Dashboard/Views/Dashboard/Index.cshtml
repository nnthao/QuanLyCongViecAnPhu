@{
    ViewBag.Title = "Tổng quan điều hành";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --navy-950: #1c2b3a;
        --navy-900: #26394d;
        --navy-800: #344b62;
        --blue-600: #3478d4;
        --blue-100: #e8f1fc;
        --teal-600: #13a6a1;
        --orange-600: #ff7628;
        --yellow-600: #e6aa16;
        --yellow-100: #fff7db;
        --purple-600: #6747c7;
        --red-600: #e5484d;
        --red-100: #fdebec;
        --green-600: #2da85b;
        --green-100: #e5f6eb;
        --ink-900: #203040;
        --ink-700: #526274;
        --ink-500: #7b8998;
        --line: #dfe5eb;
        --surface: #ffffff;
        --page: #f6f7f9;
    }

    .content-wrap-dashboard {
        max-width: 1600px;
        margin: 0 auto;
        padding: 10px 15px 30px;
    }

    .page-intro-dashboard {
        margin-bottom: 22px;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
    }

    .page-title-dashboard {
        margin: 0;
        color: var(--navy-950);
        font-size: 25px;
        font-weight: 750;
        letter-spacing: -0.4px;
    }

    .page-subtitle-dashboard {
        margin: 6px 0 0;
        color: var(--ink-500);
    }

    .filter-card {
        margin-bottom: 22px;
        padding: 16px 20px;
        border: 1px solid var(--line);
        border-radius: 14px;
        background: var(--surface);
        box-shadow: 0 6px 22px rgba(24, 51, 84, 0.055);
    }

    .filter-label {
        margin-bottom: 6px;
        color: var(--ink-700);
        font-size: 12px;
        font-weight: 700;
    }

    .select2-container--bootstrap4 .select2-selection--single {
        height: 38px !important;
        border-color: var(--line) !important;
        border-radius: 8px !important;
    }

    .select2-container--bootstrap4 .select2-selection--single .select2-selection__rendered {
        line-height: 36px !important;
        color: var(--ink-900) !important;
        font-size: 13px !important;
    }

    .checkbox-filter-box {
        display: flex;
        align-items: center;
        height: 38px;
        padding: 0 14px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--page);
        transition: all 0.2s ease;
        width: 100%;
    }

    .checkbox-filter-box:hover {
        border-color: var(--blue-600);
        background: #fff;
    }

    .checkbox-filter-box .custom-control {
        padding-left: 1.5rem;
        margin: 0;
        width: 100%;
    }

    .checkbox-filter-box .custom-control-label {
        cursor: pointer;
        user-select: none;
        color: var(--ink-900);
        font-size: 13px;
        font-weight: 600;
        line-height: 20px;
    }

    .metric-card {
        height: calc(100% - 20px);
        min-height: 128px;
        margin-bottom: 20px;
        padding: 18px;
        border: 1px solid var(--line);
        border-top-width: 4px;
        border-radius: 14px;
        background: var(--surface);
        box-shadow: 0 6px 22px rgba(24, 51, 84, 0.055);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .metric-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 26px rgba(24, 51, 84, 0.1);
    }

    .metric-card.metric-blue {
        border-top-color: var(--blue-600);
    }

    .metric-card.metric-green {
        border-top-color: var(--green-600);
    }

    .metric-card.metric-yellow {
        border-top-color: var(--yellow-600);
    }

    .metric-card.metric-red {
        border-top-color: var(--red-600);
    }

    .metric-card.metric-blue .metric-title,
    .metric-card.metric-blue .metric-value {
        color: var(--blue-600);
    }

    .metric-card.metric-green .metric-title,
    .metric-card.metric-green .metric-value {
        color: var(--green-600);
    }

    .metric-card.metric-yellow .metric-title,
    .metric-card.metric-yellow .metric-value {
        color: var(--yellow-600);
    }

    .metric-card.metric-red .metric-title,
    .metric-card.metric-red .metric-value {
        color: var(--red-600);
    }

    .metric-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
    }

    .metric-title {
        color: var(--ink-500);
        font-size: 12px;
        font-weight: 600;
    }

    .metric-icon {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        font-size: 14px;
    }

    .metric-icon.blue {
        color: var(--blue-600);
        background: var(--blue-100);
    }

    .metric-icon.red {
        color: var(--red-600);
        background: var(--red-100);
    }

    .metric-icon.green {
        color: var(--green-600);
        background: var(--green-100);
    }

    .metric-icon.yellow {
        color: var(--yellow-600);
        background: var(--yellow-100);
    }

    .metric-value {
        margin-top: 16px;
        font-size: 40px;
        font-weight: 750;
        line-height: 1;
        letter-spacing: -1.2px;
    }

    .progress-stat-row {
        display: grid;
        grid-template-columns: 130px minmax(120px, 1fr) 74px;
        gap: 14px;
        align-items: center;
        margin-bottom: 21px;
    }

    .progress-stat-row:last-child {
        margin-bottom: 0;
    }

    .progress-stat-label {
        color: var(--ink-700);
        font-size: 12px;
        font-weight: 650;
    }

    .progress-stat-track {
        height: 13px;
        display: flex;
        overflow: hidden;
        border-radius: 3px;
        background-color: #f0f2f5;
        background-image: linear-gradient(90deg, rgba(94, 111, 129, 0.13) 1px, transparent 1px);
        background-size: 24px 100%;
    }

    .progress-stat-fill {
        height: 100%;
        flex-shrink: 0;
    }

    .progress-stat-value {
        color: var(--ink-900);
        font-size: 12px;
        font-weight: 750;
        text-align: right;
    }

    .person-cell {
        display: flex;
        align-items: center;
        min-width: 180px;
    }

    .person-avatar {
        width: 30px;
        height: 30px;
        margin-right: 9px;
        flex: 0 0 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        color: #fff;
        background: var(--purple-600);
        font-size: 10px;
        font-weight: 750;
    }

    .person-name {
        color: var(--ink-900);
        font-size: 11px;
        font-weight: 700;
    }

    .person-department {
        color: var(--ink-500);
        font-size: 9px;
    }

    .count-cell {
        font-size: 12px;
        font-weight: 750;
        text-align: center;
    }

    .count-cell.warning {
        color: var(--orange-600);
    }

    .count-cell.danger {
        color: var(--red-600);
    }

    .panel {
        height: calc(100% - 20px);
        margin-bottom: 20px;
        border: 1px solid var(--line);
        border-radius: 14px;
        background: var(--surface);
        box-shadow: 0 6px 22px rgba(24, 51, 84, 0.055);
    }

    .panel-head {
        min-height: 64px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 15px 18px;
        border-bottom: 1px solid var(--line);
    }

    .panel-title {
        margin: 0;
        color: var(--navy-950);
        font-size: 15px;
        font-weight: 700;
    }

    .panel-caption {
        margin: 3px 0 0;
        color: var(--ink-500);
        font-size: 11px;
    }

    .panel-link {
        border: 0;
        color: var(--blue-600);
        background: transparent;
        font-size: 12px;
        font-weight: 650;
        cursor: pointer;
    }

    .panel-body {
        padding: 18px;
    }

    .status-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        margin-bottom: 22px;
    }

    .legend-item {
        color: var(--ink-500);
        font-size: 11px;
    }

    .legend-dot {
        width: 8px;
        height: 8px;
        margin-right: 5px;
        display: inline-block;
        border-radius: 50%;
    }

    .notice-item {
        display: flex;
        padding: 15px 0;
        border-bottom: 1px solid var(--line);
    }

    .notice-item:first-child {
        padding-top: 0;
    }

    .notice-item:last-child {
        padding-bottom: 0;
        border-bottom: 0;
    }

    .dashboard-scroll-body {
        max-height: 320px;
        overflow-y: auto;
    }

    .dashboard-scroll-body::-webkit-scrollbar {
        width: 6px;
        height: 6px;
    }

    .dashboard-scroll-body::-webkit-scrollbar-track {
        background: #f1f3f5;
        border-radius: 4px;
    }

    .dashboard-scroll-body::-webkit-scrollbar-thumb {
        background: #c1c9d2;
        border-radius: 4px;
    }

    .dashboard-scroll-body::-webkit-scrollbar-thumb:hover {
        background: #a0abb8;
    }

    .risk-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

    .risk-table th {
        position: sticky;
        top: 0;
        z-index: 10;
        background: var(--surface);
        padding: 10px 15px;
        border: 0;
        box-shadow: inset 0 -1px 0 var(--line);
        color: var(--ink-500);
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .risk-table td {
        padding: 12px 15px;
        border-top: 1px solid var(--line);
        color: var(--ink-700);
        font-size: 12px;
        vertical-align: middle;
        background: var(--surface);
    }

    .risk-table .work-name {
        color: var(--ink-900);
        font-weight: 650;
    }

    .schedule-block {
        position: relative;
        margin-bottom: 10px;
        padding: 10px 14px 10px 15px;
        overflow: hidden;
        border: 1px solid #eef2f6;
        border-radius: 10px;
        background: var(--surface);
        box-shadow: 0 3px 12px rgba(24, 51, 84, 0.03);
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }

    .schedule-block.clickable-schedule-item {
        cursor: pointer;
    }

    .schedule-block.clickable-schedule-item:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(24, 51, 84, 0.07);
        border-color: #cbd5e1;
    }

    .schedule-block::before {
        content: "";
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        width: 4px;
        background: #5d48eb;
        border-radius: 10px 0 0 10px;
    }

    .schedule-block.teal::before {
        background: var(--teal-600);
    }

    .schedule-block.orange::before {
        background: var(--orange-600);
    }

    .schedule-header {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 6px;
    }

    .schedule-date-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 3px 8px;
        background: #0066ff;
        color: #ffffff;
        font-size: 11px;
        font-weight: 600;
        border-radius: 6px;
        line-height: 1.2;
    }

    .schedule-time-box {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        color: #0066ff;
        font-size: 12px;
        font-weight: 650;
    }

    .schedule-time-box i {
        font-size: 12px;
    }

    .schedule-name {
        color: #0f172a;
        font-size: 13px;
        font-weight: 700;
        line-height: 1.4;
        letter-spacing: -0.2px;
    }

    .schedule-details-container {
        border-top: 1px solid #f1f5f9;
        padding-top: 8px;
        margin-top: 8px;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .schedule-detail-item {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .schedule-detail-icon {
        width: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .schedule-detail-icon.icon-participants {
        color: #4b5563;
        font-size: 14px;
    }

    .schedule-detail-icon.icon-location {
        color: #ef4444;
        font-size: 16px;
    }

    .schedule-detail-content {
        flex: 1;
        min-width: 0;
        border-left: 1.5px solid #cbd5e1;
        padding-left: 8px;
    }

    .schedule-detail-label {
        font-size: 10.5px;
        color: #64748b;
        font-weight: 500;
        line-height: 1.2;
        margin-bottom: 1px;
    }

    .schedule-detail-value {
        font-size: 11.5px;
        color: #334155;
        line-height: 1.35;
        word-break: break-word;
    }

    .schedule-detail-value.font-weight-bold {
        color: #0f172a;
        font-weight: 700 !important;
    }

    .notice-icon {
        width: 34px;
        height: 34px;
        margin-right: 11px;
        flex: 0 0 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        color: var(--blue-600);
        background: var(--blue-100);
    }

    .notice-title {
        margin-bottom: 3px;
        color: var(--ink-900);
        font-size: 12px;
        font-weight: 650;
        line-height: 1.45;
    }

    .notice-time {
        color: var(--ink-500);
        font-size: 10px;
    }

    @@media (max-width: 991.98px) {
        .progress-stat-row {
            grid-template-columns: 104px minmax(60px, 1fr) 32px;
            gap: 8px;
        }
    }

    @@media (max-width: 767.98px) {
        .content-wrap-dashboard {
            padding: 15px 10px 20px;
        }

        .risk-table {
            min-width: 500px;
        }

        .col-xs-12 {
            width: 100%;
        }
    }
</style>

<div class="content-wrap-dashboard">
    <section class="page-intro-dashboard">
        <div>
            <h1 class="page-title-dashboard">Tổng quan điều hành</h1>
            <p class="page-subtitle-dashboard">Theo dõi lịch làm việc, tiến độ và các nhiệm vụ cần chú ý trong năm.</p>
        </div>
    </section>

    @Html.Partial("_DashboardFilter")

    <section>
        @Html.Partial("_DashboardMetricCards")

        <div class="row">
            <div class="col-md-5 col-sm-12 col-xs-12">
                @Html.Partial("_DashboardDepartmentStats")
            </div>
            <div class="col-md-4 col-sm-12 col-xs-12">
                @Html.Partial("_DashboardTodaySchedule")
            </div>
            <div class="col-md-3 col-sm-12 col-xs-12">
                @Html.Partial("_DashboardNotifications")
            </div>
        </div>

        <div class="row">
            <div class="col-md-5 col-sm-12 col-xs-12">
                @Html.Partial("_DashboardRiskDepartments")
            </div>
            <div class="col-md-7 col-sm-12 col-xs-12">
                @Html.Partial("_DashboardRiskMembers")
            </div>
        </div>
    </section>
</div>

@Html.Partial("_ModalChiTietCongViecDashboard")

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var currentDate = new Date();
        var currentYear = currentDate.getFullYear();

        var $filterNam = $('#filterNam');
        if ($filterNam.length > 0) {
            $filterNam.empty();
            $filterNam.append(new Option("-- Chọn năm --", ""));
            for (var y = currentYear; y >= currentYear - 5; y--) {
                var isSelected = (y === currentYear);
                $filterNam.append(new Option(`Năm ${y}`, y, false, isSelected));
            }
        }

        if ($.fn.select2) {
            $('#filterPhongBan').select2({
                theme: 'bootstrap4',
                placeholder: "-- Tất cả phòng ban --",
                allowClear: true
            });
            $('#filterNam').select2({
                theme: 'bootstrap4',
                placeholder: "-- Chọn năm --",
                minimumResultsForSearch: Infinity
            });
        }

        function getFilterValues() {
            var namVal = $('#filterNam').val();
            return {
                Nam: namVal ? parseInt(namVal, 10) : currentYear,
                PhongBanId: $('#filterPhongBan').val() || null,
                IsCaNhan: $('#chkFilterCaNhan').is(':checked')
            };
        }

        function fetchDashboardData() {
            var params = getFilterValues();

            ajaxGet('/Dashboard/GetDashboardData', params, function (res) {
                if (!res || !res.success || !res.data) {
                    return;
                }

                var data = res.data;

                // 1. Thống kê Metrics Cards
                var summary = data.Summary || {};
                $('#valDangThucHien').text(summary.DangThucHien || 0);
                $('#valDaHoanThanh').text(summary.DaHoanThanh || 0);
                $('#valSapDenHan').text(summary.SapDenHan || 0);
                $('#valTreHan').text(summary.TreHan || 0);

                // 2. Thống kê theo phòng ban
                var deptStats = data.DepartmentStats || [];
                $('#lblDepartmentStatsCaption').text(`Phân bổ ${summary.TongCongViec || 0} lượt việc đã giao trong năm ${params.Nam}`);

                var $containerDept = $('#containerDepartmentProgress');
                if (deptStats.length === 0) {
                    $containerDept.html('<div class="text-center py-4 text-muted">Không có dữ liệu phòng ban</div>');
                } else {
                    var deptHtml = '';
                    for (var i = 0; i < deptStats.length; i++) {
                        var d = deptStats[i];
                        deptHtml += `<div class="progress-stat-row clickable-dept-row" data-phongbanid="${d.PhongBanId}" style="cursor:pointer;" title="Bấm để xem danh sách công việc phòng ${d.TenPhongBan}">
                            <span class="progress-stat-label">${d.TenPhongBan}</span>
                            <div class="progress-stat-track">
                                <div class="progress-stat-fill" style="width:${d.PhantramDangThucHien}%;background:#3478d4" title="Đang thực hiện: ${d.DangThucHien}"></div>
                                <div class="progress-stat-fill" style="width:${d.PhantramDaHoanThanh}%;background:#2da85b" title="Đã hoàn thành: ${d.DaHoanThanh}"></div>
                                <div class="progress-stat-fill" style="width:${d.PhantramSapDenHan}%;background:#e6aa16" title="Sắp đến hạn: ${d.SapDenHan}"></div>
                                <div class="progress-stat-fill" style="width:${d.PhantramTreHan}%;background:#e5484d" title="Trễ hạn: ${d.TreHan}"></div>
                            </div>
                            <span class="progress-stat-value">${d.Tong}</span>
                        </div>`;
                    }
                    $containerDept.html(deptHtml);
                }

                // 3. Lịch làm việc
                var schedule = data.TodaySchedule || [];
                var $containerSched = $('#containerTodaySchedule');
                $('#lblScheduleCaption').text(`${schedule.length} sự kiện & cuộc họp sắp tới`);

                if (schedule.length === 0) {
                    $containerSched.html('<div class="text-center py-4 text-muted">Không có cuộc họp nào sắp tới</div>');
                } else {
                    var schedHtml = '';
                    for (var s = 0; s < schedule.length; s++) {
                        var item = schedule[s];
                        var cleanName = item.TenCuocHop ? item.TenCuocHop.replace(/^Ghi\s*nhớ[:\s-]*/i, '').trim() : '';
                        var dateBadge = item.NgayStr ? `<span class="schedule-date-badge"><i class="fa fa-calendar-check-o"></i>${item.NgayStr}</span>` : '';

                        var hasParticipants = Boolean(item.ThanhPhanThamDu && item.ThanhPhanThamDu.trim());
                        var hasLocation = Boolean(item.DiaDiem && item.DiaDiem.trim());
                        var metaHtml = '';

                        if (hasParticipants || hasLocation) {
                            var itemsHtml = '';

                            if (hasParticipants) {
                                itemsHtml += `<div class="schedule-detail-item">
                                    <div class="schedule-detail-icon icon-participants">
                                        <i class="fa fa-users"></i>
                                    </div>
                                    <div class="schedule-detail-content">
                                        <div class="schedule-detail-label">Thành phần:</div>
                                        <div class="schedule-detail-value font-weight-bold" title="${item.ThanhPhanThamDu}">${item.ThanhPhanThamDu}</div>
                                    </div>
                                </div>`;
                            }

                            if (hasLocation) {
                                itemsHtml += `<div class="schedule-detail-item">
                                    <div class="schedule-detail-icon icon-location">
                                        <i class="fa fa-map-marker"></i>
                                    </div>
                                    <div class="schedule-detail-content">
                                        <div class="schedule-detail-label">Địa điểm:</div>
                                        <div class="schedule-detail-value" title="${item.DiaDiem}">${item.DiaDiem}</div>
                                    </div>
                                </div>`;
                            }

                            metaHtml = `<div class="schedule-details-container">${itemsHtml}</div>`;
                        }

                        schedHtml += `<div class="schedule-block ${item.ThemeClass} clickable-schedule-item" data-id="${item.Id}" title="Bấm để xem chi tiết lịch làm việc">
                            <div class="schedule-header">
                                ${dateBadge}
                                <div class="schedule-time-box">
                                    <i class="fa fa-clock-o"></i>
                                    <span>${item.GioBatDauStr} – ${item.GioKetThucStr}</span>
                                </div>
                            </div>
                            <div class="schedule-name">${cleanName}</div>
                            ${metaHtml}
                        </div>`;
                    }
                    $containerSched.html(schedHtml);
                }

                // 4. Thông báo mới
                var notifications = data.Notifications || [];
                var $containerNotif = $('#containerRecentNotifications');

                if (notifications.length === 0) {
                    $containerNotif.html('<div class="text-center py-4 text-muted">Không có thông báo mới</div>');
                } else {
                    var notifHtml = '';
                    for (var n = 0; n < notifications.length; n++) {
                        var notif = notifications[n];
                        notifHtml += `<div class="notice-item">
                            <span class="notice-icon"><i class="fa ${notif.IconClass}"></i></span>
                            <div>
                                <div class="notice-title">${notif.NoiDung}</div>
                                <div class="notice-time">${notif.ThoiGianAgo}</div>
                            </div>
                        </div>`;
                    }
                    $containerNotif.html(notifHtml);
                }

                // 5. Phòng ban có nhiều việc cần chú ý
                var riskDepts = data.RiskDepartments || [];
                var $tbodyRiskDepts = $('#tbodyRiskDepartments');

                if (riskDepts.length === 0) {
                    $tbodyRiskDepts.html('<tr><td colspan="4" class="text-center py-3 text-muted">Không có phòng ban nào quá hạn/sắp hạn</td></tr>');
                } else {
                    var riskDeptHtml = '';
                    for (var rd = 0; rd < riskDepts.length; rd++) {
                        var rItem = riskDepts[rd];
                        riskDeptHtml += `<tr class="clickable-dept-row" data-phongbanid="${rItem.PhongBanId}" style="cursor:pointer;" title="Xem danh sách công việc phòng ${rItem.TenPhongBan}">
                            <td class="work-name">${rItem.TenPhongBan}</td>
                            <td class="count-cell warning">${rItem.SapHanCount}</td>
                            <td class="count-cell danger">${rItem.TreHanCount}</td>
                            <td class="count-cell">${rItem.TongCount}</td>
                        </tr>`;
                    }
                    $tbodyRiskDepts.html(riskDeptHtml);
                }

                // 6. Nhân viên có nhiều việc cần chú ý
                var riskMembers = data.RiskMembers || [];
                var $tbodyRiskMembers = $('#tbodyRiskMembers');

                if (riskMembers.length === 0) {
                    $tbodyRiskMembers.html('<tr><td colspan="5" class="text-center py-3 text-muted">Không có nhân viên nào quá hạn/sắp hạn</td></tr>');
                } else {
                    var riskMemberHtml = '';
                    var avatarColors = ["#6747c7", "#3478d4", "#13a6a1", "#ff7628", "#e6aa16"];
                    for (var rm = 0; rm < riskMembers.length; rm++) {
                        var mItem = riskMembers[rm];
                        var bgCol = avatarColors[rm % avatarColors.length];
                        riskMemberHtml += `<tr class="clickable-member-row" data-thanhvienid="${mItem.ThanhVienId}" style="cursor:pointer;" title="Xem danh sách công việc của ${mItem.TenThanhVien}">
                            <td>
                                <div class="person-cell">
                                    <span class="person-avatar" style="background:${bgCol}">${mItem.AvatarInitials}</span>
                                    <div>
                                        <div class="person-name">${mItem.TenThanhVien}</div>
                                        <div class="person-department">${mItem.TenPhongBan || 'Chưa phân phòng'}</div>
                                    </div>
                                </div>
                            </td>
                            <td class="count-cell">${mItem.DangLamCount}</td>
                            <td class="count-cell warning">${mItem.SapHanCount}</td>
                            <td class="count-cell danger">${mItem.TreHanCount}</td>
                            <td class="count-cell">${mItem.TongCount}</td>
                        </tr>`;
                    }
                    $tbodyRiskMembers.html(riskMemberHtml);
                }

            }, function (err) {
                console.error("Lỗi khi tải dữ liệu Dashboard:", err);
            });
        }

        // Event listeners
        $('#filterPhongBan, #filterNam').on('change', function () {
            fetchDashboardData();
        });

        $('#chkFilterCaNhan').on('change', function () {
            fetchDashboardData();
        });

        $('#btnResetFilter').on('click', function () {
            $('#filterPhongBan').val(null).trigger('change');
            $('#filterNam').val(currentYear).trigger('change');
            $('#chkFilterCaNhan').prop('checked', false);
            fetchDashboardData();
        });

        // Open modal when clicking metric cards or view list buttons
        $(document).on('click', '.clickable-metric', function () {
            var status = $(this).data('status');
            var filters = getFilterValues();
            if (window.openModalChiTietCongViecDashboard) {
                window.openModalChiTietCongViecDashboard({
                    statusFilter: status,
                    nam: filters.Nam,
                    phongBanId: filters.PhongBanId,
                    isCaNhan: filters.IsCaNhan
                });
            }
        });

        $('#btnXemCongViecNam').on('click', function () {
            var filters = getFilterValues();
            if (window.openModalChiTietCongViecDashboard) {
                window.openModalChiTietCongViecDashboard({
                    statusFilter: "All",
                    nam: filters.Nam,
                    phongBanId: filters.PhongBanId,
                    isCaNhan: filters.IsCaNhan
                });
            }
        });

        $(document).on('click', '.btn-xem-chi-tiet-phong-ban', function () {
            var filters = getFilterValues();
            if (window.openModalChiTietCongViecDashboard) {
                window.openModalChiTietCongViecDashboard({
                    statusFilter: "All",
                    nam: filters.Nam,
                    phongBanId: filters.PhongBanId,
                    isCaNhan: filters.IsCaNhan
                });
            }
        });

        $(document).on('click', '.clickable-dept-row', function () {
            var pbId = $(this).data('phongbanid');
            var filters = getFilterValues();
            if (window.openModalChiTietCongViecDashboard) {
                window.openModalChiTietCongViecDashboard({
                    statusFilter: "All",
                    nam: filters.Nam,
                    phongBanId: pbId,
                    isCaNhan: filters.IsCaNhan
                });
            }
        });

        $(document).on('click', '.clickable-member-row, .btn-xem-chi-tiet-nhan-vien', function () {
            var tvId = $(this).data('thanhvienid');
            var filters = getFilterValues();
            if (window.openModalChiTietCongViecDashboard) {
                window.openModalChiTietCongViecDashboard({
                    statusFilter: "All",
                    nam: filters.Nam,
                    phongBanId: filters.PhongBanId,
                    thanhVienId: tvId,
                    isCaNhan: filters.IsCaNhan
                });
            }
        });

        $(document).on('click', '.clickable-schedule-item', function () {
            var id = $(this).data('id');
            if (id && typeof moFormChiTiet === 'function') {
                moFormChiTiet(id);
            }
        });

        // Initial fetch
        fetchDashboardData();
    });
</script>
