<div class="row">
    <div class="col-md-3 col-sm-6 col-xs-12">
        <article class="metric-card metric-blue clickable-metric" data-status="DangThucHien" style="cursor: pointer;" title="Bấm để xem danh sách công việc đang thực hiện">
            <div class="metric-head">
                <span class="metric-title">Đang thực hiện</span>
                <span class="metric-icon blue"><i class="fa fa-tasks"></i></span>
            </div>
            <div class="metric-value" id="valDangThucHien">0</div>
        </article>
    </div>
    <div class="col-md-3 col-sm-6 col-xs-12">
        <article class="metric-card metric-green clickable-metric" data-status="DaHoanThanh" style="cursor: pointer;" title="Bấm để xem danh sách công việc đã hoàn thành">
            <div class="metric-head">
                <span class="metric-title">Đã hoàn thành</span>
                <span class="metric-icon green"><i class="fa fa-check"></i></span>
            </div>
            <div class="metric-value" id="valDaHoanThanh">0</div>
        </article>
    </div>
    <div class="col-md-3 col-sm-6 col-xs-12">
        <article class="metric-card metric-yellow clickable-metric" data-status="SapDenHan" style="cursor: pointer;" title="Bấm để xem danh sách công việc sắp đến hạn">
            <div class="metric-head">
                <span class="metric-title">Sắp đến hạn</span>
                <span class="metric-icon yellow"><i class="fa fa-clock-o"></i></span>
            </div>
            <div class="metric-value" id="valSapDenHan">0</div>
        </article>
    </div>
    <div class="col-md-3 col-sm-6 col-xs-12">
        <article class="metric-card metric-red clickable-metric" data-status="TreHan" style="cursor: pointer;" title="Bấm để xem danh sách công việc trễ hạn">
            <div class="metric-head">
                <span class="metric-title">Trễ hạn</span>
                <span class="metric-icon red"><i class="fa fa-exclamation-triangle"></i></span>
            </div>
            <div class="metric-value" id="valTreHan">0</div>
        </article>
    </div>
</div>
