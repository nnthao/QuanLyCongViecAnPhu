@using Dashboard.HtmlHelpers;

<div class="modal fade" id="doKhanFormModal" tabindex="-1" role="dialog" aria-labelledby="doKhanFormModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="doKhanFormModalTitle"><b>Thêm độ khẩn</b></h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <input id="DoKhan_Id" value="0" type="hidden" />
                <div class="row">
                    @Html.CustomTextBox(id: "DoKhan_Ten", label: "Tên độ khẩn", col: 12, required: true, length: 500, moreClass: "col-sm-12 col-xs-12")
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-dismiss="modal">
                    <i class="fa fa-times"></i> Đóng
                </button>
                <button type="button" onclick="saveDoKhanForm()" class="btn btn-success" id="btnDoKhanSave">
                    <i class="fa fa-save"></i> <span id="btnDoKhanSaveText">Lưu</span>
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    function resetDoKhanForm() {
        $("#DoKhan_Id").val(0);
        $("#DoKhan_Ten").val('');
    }

    function openDoKhanFormModal(id) {
        resetDoKhanForm();
        showLoadingModal();

        ajaxGet("/DoKhan/GetById?id=" + id, function (res) {
            hideLoadingModal();
            if (id > 0) {
                $("#doKhanFormModalTitle").html("<b>Cập nhật độ khẩn</b>");
                $("#btnDoKhanSaveText").text("Cập nhật");
                if (res && res.Item) {
                    $("#DoKhan_Id").val(res.Item.Id);
                    $("#DoKhan_Ten").val(res.Item.Ten || '');
                }
            } else {
                $("#doKhanFormModalTitle").html("<b>Thêm mới độ khẩn</b>");
                $("#btnDoKhanSaveText").text("Thêm mới");
            }
            $("#doKhanFormModal").modal("show");
        }, function () {
            hideLoadingModal();
            toastr.error("Đã có lỗi xảy ra. Vui lòng thử lại.");
        });
    }

    function saveDoKhanForm() {
        showLoadingModal();
        var fd = new FormData();
        fd.append("Id", $("#DoKhan_Id").val());
        fd.append("Ten", $("#DoKhan_Ten").val());

        ajaxPostFormData("/DoKhan/ThemOrCapNhat", fd, function (data) {
            hideLoadingModal();
            if (data.Errors && data.Errors.length > 0) {
                var msg = data.Errors.map(function (item) { return item.Description; }).join("<br/>");
                toastr.error(msg);
            } else {
                toastr.success("Lưu thành công.");
                $("#doKhanFormModal").modal("hide");
                if (typeof search === 'function') {
                    search();
                }
            }
        }, function () {
            hideLoadingModal();
            toastr.error("Đã có lỗi xảy ra. Vui lòng thử lại.");
        });
    }
</script>
