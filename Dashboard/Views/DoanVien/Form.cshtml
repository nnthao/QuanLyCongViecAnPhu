@using Dashboard.HtmlHelpers;
@using Dashboard.Models.HtmlHelpers
@{
    var action = Model != 0 ? "Cập nhật" : "Thêm";
    ViewBag.Title = action + " đoàn viên";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model int

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card card-primary">
                    <div class="card-header">
                        <div class="card-title">
                            <b>@ViewBag.Title </b>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <input id="Id" value="@Model" type="hidden" />
                            @Html.CustomTextBox(id: "HoTen", label: "Họ tên", col: 5, required: true, length: 200, moreClass: "col-sm-5 col-xs-12")
                            @Html.CustomSelect2Empty(id: "GioiTinh", label: "Giới tính", col: 2, moreClass: "col-sm-2 col-xs-12", allowClear: true, required: true)
                            @Html.CustomDateTimePicker(id: "NgaySinh", label: "Ngày sinh", col: 2, moreClass: "col-sm-2 col-xs-12", required: true)
                            @Html.CustomSelect2Empty(id: "DanTocId", label: "Dân tộc", col: 3, moreClass: "col-sm-3 col-xs-12", allowClear: true, required: true)
                        </div>
                        <div class="row">
                            @Html.CustomTextBox(id: "QueQuan", label: "Quê quán", col: 6, length: 500, moreClass: "col-sm-6 col-xs-12")
                            @Html.CustomSelect2Empty(id: "DonViDoanId", label: "Đơn vị đoàn", col: 3, moreClass: "col-sm-3 col-xs-12", required: true)
                            @Html.CustomTextBox(id: "ChuyenMonNghiepVu", label: "Chuyên môn nghiệp vụ", col: 3, length: 500, moreClass: "col-sm-3 col-xs-12", required: true)
                        </div>
                        <div class="row">
                            @Html.CustomTextBox(id: "ChucVu", label: "Chức vụ", col: 4, length: 1000, moreClass: "col-sm-4 col-xs-12")
                            @Html.CustomTextBox(id: "LyLuanChinhTri", label: "Lý luận chính trị", col: 4, length: 500, moreClass: "col-sm-4 col-xs-12")
                            @Html.CustomTextBox(id: "NgayVaoDoan", label: "Ngày vào Đoàn", col: 2, moreClass: "col-sm-2 col-xs-12")
                            @Html.CustomTextBox(id: "NgayVaoDang", label: "Ngày vào Đảng", col: 2, moreClass: "col-sm-2 col-xs-12")
                        </div>
                        <div class="row">
                            @Html.CustomTextBox(id: "GhiChu", label: "Ghi chú", col: 12, length: 2000, moreClass: "col-sm-12 col-xs-12")
                        </div>
                        <div class="row">
                            @Html.CustomDateTimePicker(id: "ThoiGianDiemDanh", label: "Thời gian điểm danh", col: 3, moreClass: "col-sm-3 col-xs-12")
                        </div>


                        <div class="row">
                            <div class="col-sm-12">
                                <div class="modal-footer text-center d-block">
                                    <button id="btn-loading" type="button" class="btn btn-default invisible" data-dismiss="modal">
                                        <img src="~/Content/img/loading.gif" height="25" />
                                    </button>
                                    <a class="btn btn-light mr-2" href="/DoanVien"><i class="fa fa-chevron-left"></i> Quay lại</a>
                                    <button onclick="addOrUpdate()" class="btn btn-success"><i class="fa fa-save"></i> @action</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
<script>
    function loadData() {
        showLoadingModal();
        ajaxGet("/DoanVien/GetById?id=" + @Model, function funcCallback(res) {
            $("#DonViDoanId").select2({
                data: res.DonViDoan.Data,
                language: "vi",
                allowClear: true
            });

            $("#DanTocId").select2({
                data: res.DanToc.Data,
                language: "vi",
                allowClear: true
            });

            var gioiTinhData = [
                { id: 1, text: "Nam" },
                { id: 2, text: "Nữ" }
            ];
            $("#GioiTinh").select2({
                data: gioiTinhData,
                language: "vi",
                allowClear: true
            });

            if (res.Item) {
                $("#HoTen").val(res.Item.HoTen);
                $("#TenTrim").val(res.Item.TenTrim);
                $("#ChucVu").val(res.Item.ChucVu);
                $("#GhiChu").val(res.Item.GhiChu);
                $("#DonViDoanId").val(res.Item.DonViDoanId).trigger('change');
                $("#GioiTinh").val(res.Item.GioiTinh).trigger('change');
                $("#QueQuan").val(res.Item.QueQuan);
                $("#DanTocId").val(res.Item.DanTocId).trigger('change');
                $("#ChuyenMonNghiepVu").val(res.Item.ChuyenMonNghiepVu);
                $("#LyLuanChinhTri").val(res.Item.LyLuanChinhTri);
                $("#NgayVaoDoan").val(res.Item.NgayVaoDoan);
                $("#NgayVaoDang").val(res.Item.NgayVaoDang);
                if (res.Item.ThoiGianDiemDanhStr) {
                    $("#ThoiGianDiemDanh-Input").val(res.Item.ThoiGianDiemDanhStr);
                }
                if (res.Item.NgaySinhStr) {
                    $("#NgaySinh-Input").val(res.Item.NgaySinhStr);
                }
            }
            hideLoadingModal();
        }, function funcError() {
            toastr.error("Đã có lỗi xảy ra. Vui lòng tải lại trang.");
        })
    }

    function addOrUpdate() {
        showLoadingModal();
        var fd = new FormData();
        fd.append("Id", $("#Id").val());
        fd.append("HoTen", $("#HoTen").val());
        fd.append("ChucVu", $("#ChucVu").val());
        fd.append("GhiChu", $("#GhiChu").val());
        fd.append("DonViDoanId", $("#DonViDoanId").val() || 0);
        fd.append("GioiTinh", $("#GioiTinh").val() || 0);
        fd.append("QueQuan", $("#QueQuan").val());
        fd.append("DanTocId", $("#DanTocId").val() || 0);
        fd.append("ChuyenMonNghiepVu", $("#ChuyenMonNghiepVu").val());
        fd.append("LyLuanChinhTri", $("#LyLuanChinhTri").val());
        fd.append("NgaySinhStr", $("#NgaySinh-Input").val());
        fd.append("NgayVaoDoan", $("#NgayVaoDoan").val());
        fd.append("NgayVaoDang", $("#NgayVaoDang").val());
        fd.append("ThoiGianDiemDanhStr", $("#ThoiGianDiemDanh-Input").val());

        ajaxPostFormData("/DoanVien/ThemOrCapNhat", fd, function funcCallback(data) {
            hideLoadingModal();
            if (data.Errors && data.Errors.length > 0) {
                data.Errors.map((item) => {
                    var idError = "#" + item.Name;
                    $(idError).show();
                    $(idError).text(item.Description);

                    return "";
                });
            }
            else {
                window.location.href = "/DoanVien";
            }
        }, function funcError() {
            toastr.error("Đã có lỗi xảy ra. Vui lòng tải lại trang.");
        })
    }

    document.addEventListener('DOMContentLoaded', function () {
        loadData();
    });
</script>

