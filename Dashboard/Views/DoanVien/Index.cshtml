@using Dashboard.HtmlHelpers;
@using Dashboard.Models.HtmlHelpers
@{
    ViewBag.Title = "Đoàn viên";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card card-primary">
                    <div class="card-header">
                        <div class="card-title">
                            <b>@ViewBag.Title</b>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-sm-5 col-xs-12">
                                <a href="/DoanVien/Form?id=0" class="btn btn-success">
                                    <i class="fa fa-plus"></i> Thêm mới
                                </a>
                                <button class="btn btn-success m-l-5" onclick="importDanhSach();">
                                    <i class="fa fa-file-excel-o"></i> Import Excel
                                </button>
                                <button class="btn btn-warning m-l-5" onclick="resetDiemDanh();">
                                    <i class="fa fa-refresh"></i> Reset điểm danh
                                </button>
                                <a class="btn btn-infp m-l-5" href="/diemdanh/thongke" target="_blank">
                                    <i class="fa fa-refresh"></i> Thống kế điểm danh
                                </a>
                            </div>
                            @Html.CustomCheckBox(id: "DaXoaSearch", label: "Đã xoá", col: 3,
                                   moreClass: "col-sm-3 col-xs-12 p-t-15")
                            <div class="col-sm-4 col-xs-12">
                                <div class="input-group">
                                    <input onkeypress="enterSearch(event);" id="txt-search" type="text" class="form-control" placeholder="Tìm kiếm">
                                    <div class="input-group-append">
                                        <button id="btn-search" onclick="search();" class="btn btn-primary" type="button">
                                            <i class="fa fa-search"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-sm-12">
                                <table id="bs-table"
                                       data-mobile-responsive="true"
                                       data-check-on-init="true"
                                       data-toggle="table"
                                       data-toolbar="#get"
                                       data-url="/DoanVien/GetAll"
                                       data-pagination="true"
                                       data-side-pagination="server"
                                       data-page-size="30"
                                       data-page-list="[30, 50, 100, 200]"
                                       data-locale="vi-VN"
                                       data-query-params="queryParams"
                                       data-row-attributes="rowAttributes"
                                       data-sort-name="HoTen"
                                       data-sort-order="asc">
                                    <thead>
                                        <tr>
                                            <th data-field="HoTen">Họ tên</th>
                                            <th data-field="ChucVu">Chức vụ</th>
                                            <th data-field="TenDonViDoan">Đơn vị đoàn</th>
                                            <th data-field="ThoiGianDiemDanhStr">Thời gian điểm danh</th>
                                            <th class="width-20-per" data-field="operate" data-formatter="operateFormatter" data-events="operateEvents">&nbsp;</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
<script>
    var selectedId = 0;
    function rowAttributes(row, index) {
        return {
            'data-id': row.Id
        }
    }

    function operateFormatter(value, row, index) {
        const btnSua = `<a href="/DoanVien/Form?id=${row.Id}" class='btn btn-primary btn-sm m-l-5 m-r-5 m-t-5 m-b-5'><i class='fa fa-pencil'></i> Sửa</a>`;
        const btnXoa = `<button id='btn-delete-item' class='btn btn-danger btn-sm m-l-5 m-r-5 m-t-5 m-b-5'><i class='fa fa-trash'></i> Xóa</button>`;
        const btnKhoiPhuc = `<button id='btn-revert-item' class='btn btn-success btn-sm m-l-5 m-r-5 m-t-5 m-b-5'><i class='fa fa-refresh'></i> Khôi phục</button>`;
        const btnDiemDanh = `<button id='btn-diem-danh-item' class='btn btn-info btn-sm m-l-5 m-r-5 m-t-5 m-b-5'><i class='fa fa-check'></i> Điểm danh</button>`;

        if (row.IsDeleted) {
            return [
                btnSua + btnKhoiPhuc
            ].join("");
        }

        return [
            btnSua + btnDiemDanh + btnXoa
        ].join("");
    }

    window.operateEvents = {
        'click #btn-delete-item': function (e, value, row, index) {
            if (confirm("Bạn muốn xoá đoàn viên này?")) {
                showLoadingModal();

                var fd = new FormData();
                fd.append("Id", row.Id);

                ajaxPostFormData("/DoanVien/Xoa", fd, function funcCallback(data) {
                    hideLoadingModal();
                    toastr.success("Xoá thành công.");
                    search();
                }, function funcError() {
                    toastr.error("Đã có lỗi xảy ra. Vui lòng tải lại trang.");
                })
            }
        },
        'click #btn-revert-item': function (e, value, row, index) {
            if (confirm("Bạn muốn khôi phục đoàn viên này?")) {
                showLoadingModal();

                var fd = new FormData();
                fd.append("Id", row.Id);

                ajaxPostFormData("/DoanVien/KhoiPhuc", fd, function funcCallback(data) {
                    hideLoadingModal();
                    toastr.success("Khôi phục thành công.");
                    search();
                }, function funcError() {
                    toastr.error("Đã có lỗi xảy ra. Vui lòng tải lại trang.");
                })
            }
        },
        'click #btn-diem-danh-item': function (e, value, row, index) {
            if (confirm(`Bạn có chắc chắn muốn điểm danh cho ${row.HoTen}?`)) {
                showLoadingModal();

                var fd = new FormData();
                fd.append("Id", row.Id);

                ajaxPostFormData("/DoanVien/DiemDanhById", fd, function funcCallback(data) {
                    hideLoadingModal();
                    if (data.Errors && data.Errors.length > 0) {
                        var errorMessage = data.Errors.map(function (error) {
                            return error.Description;
                        }).join('\n');
                        toastr.error(errorMessage);
                    } else {
                        toastr.success("Điểm danh thành công.");
                        search();
                    }
                }, function funcError() {
                    hideLoadingModal();
                    toastr.error("Đã có lỗi xảy ra. Vui lòng tải lại trang.");
                })
            }
        }
    }

    function queryParams(params) {
        params.search = btoa(unescape(encodeURIComponent($("#txt-search").val())));
        params.DaXoaSearch = $('#DaXoaSearch').is(":checked");
        return params;
    };

    function search() {
        $('#bs-table').bootstrapTable('refresh');
    };

    function enterSearch(e) {
        if (e.keyCode === 13) {
            $('#bs-table').bootstrapTable('refresh');
        };
    };

    document.addEventListener('DOMContentLoaded', function () {
        $("#DaXoaSearch").change(function () {
            search();
        });
    });

    function importDanhSach() {
        $("#importExcelModal").modal("show");
        $("#customFileError").text("");
        $("#FileDinhKem").val("");
    }

    function taiFileMau() {
        window.location.href = "/DoanVien/TaiFileMau";
    }

    function resetDiemDanh() {
        if (confirm("Bạn có chắc chắn muốn reset tất cả điểm danh? Hành động này sẽ xóa thời gian điểm danh của tất cả đoàn viên.")) {
            showLoadingModal();

            var fd = new FormData();

            ajaxPostFormData("/DoanVien/ResetDiemDanh", fd, function funcCallback(data) {
                hideLoadingModal();
                toastr.success("Reset điểm danh thành công.");
                search();
            }, function funcError() {
                hideLoadingModal();
                toastr.error("Đã có lỗi xảy ra. Vui lòng tải lại trang.");
            });
        }
    }

    $(document).on('click', '#btn-Import', function () {
        var fileInput = $("#FileDinhKem")[0];
        if (!fileInput || !fileInput.files || fileInput.files.length === 0) {
            $("#customFileError").text("Vui lòng chọn file để import.");
            return;
        }

        $("#customFileError").text("");
        $("#btn-Import").prop("disabled", true);
        $("#btn-loading").removeClass("invisible");
        showLoadingModal();

        var fd = new FormData();
        fd.append("file", fileInput.files[0]);

        ajaxPostFormData("/DoanVien/ImportDanhSach", fd, function funcCallback(response) {
            $("#btn-Import").prop("disabled", false);
            $("#btn-loading").addClass("invisible");
            hideLoadingModal();

            if (response.Errors && response.Errors.length > 0) {
                var errorMessages = response.Errors.map(function (error) {
                    return error.Description;
                }).join('\n');
                $("#customFileError").text(errorMessages);
            } else if (response.Data) {
                var thanhCong = response.Data.filter(function (item) {
                    return item.Loi && item.Loi.indexOf("thành công") >= 0;
                }).length;
                var thatBai = response.Data.filter(function (item) {
                    return item.Loi && item.Loi.indexOf("thành công") < 0;
                }).length;

                var message = "Import hoàn tất. Thành công: " + thanhCong + ", Thất bại: " + thatBai;
                if (thatBai > 0) {
                    toastr.warning(message);
                } else {
                    toastr.success(message);
                }

                $("#importExcelModal").modal("hide");
                $("#FileDinhKem").val("");
                search();
            }
        }, function funcError() {
            $("#btn-Import").prop("disabled", false);
            $("#btn-loading").addClass("invisible");
            hideLoadingModal();
            toastr.error("Đã có lỗi xảy ra. Vui lòng tải lại trang.");
        });
    });
</script>
@Html.Partial("ImportExcel")


