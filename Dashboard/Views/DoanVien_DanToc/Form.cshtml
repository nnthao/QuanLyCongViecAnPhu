@using Dashboard.HtmlHelpers;
@using Dashboard.Models.HtmlHelpers
@{
    var action = Model != 0 ? "Cập nhật" : "Thêm";
    ViewBag.Title = action + " dân tộc";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model int

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card card-primary">
                    <div class="card-header">
                        <div class="card-title">
                            <b>@ViewBag.Title </b>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <input id="Id" value="@Model" type="hidden" />
                            @Html.CustomTextBox(id: "Ten", label: "Tên", col: 6, required: true, length: 200, moreClass: "col-sm-6 col-xs-12")
                        </div>

                        <div class="row">
                            <div class="col-sm-12">
                                <div class="modal-footer text-center d-block">
                                    <button id="btn-loading" type="button" class="btn btn-default invisible" data-dismiss="modal">
                                        <img src="~/Content/img/loading.gif" height="25" />
                                    </button>
                                    <a class="btn btn-light mr-2" href="/DoanVien_DanToc"><i class="fa fa-chevron-left"></i> Quay lại</a>
                                    <button onclick="addOrUpdate()" class="btn btn-success"><i class="fa fa-save"></i> @action</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
<script>
    function loadData() {
        showLoadingModal();
        ajaxGet("/DoanVien_DanToc/GetById?id=" + @Model, function funcCallback(res) {
            if (res.Item) {
                $("#Ten").val(res.Item.Ten);
            }
            hideLoadingModal();
        }, function funcError() {
            toastr.error("Đã có lỗi xảy ra. Vui lòng tải lại trang.");
        })
    }

    function addOrUpdate() {
        showLoadingModal();
        var fd = new FormData();
        fd.append("Id", $("#Id").val());
        fd.append("Ten", $("#Ten").val());

        ajaxPostFormData("/DoanVien_DanToc/ThemOrCapNhat", fd, function funcCallback(data) {
            hideLoadingModal();
            if (data.Errors && data.Errors.length > 0) {
                data.Errors.map((item) => {
                    var idError = "#" + item.Name;
                    $(idError).show();
                    $(idError).text(item.Description);

                    return "";
                });
            }
            else {
                window.location.href = "/DoanVien_DanToc";
            }
        }, function funcError() {
            toastr.error("Đã có lỗi xảy ra. Vui lòng tải lại trang.");
        })
    }

    document.addEventListener('DOMContentLoaded', function () {
        loadData();
    });
</script>

