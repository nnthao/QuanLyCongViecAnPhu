@using Dashboard.HtmlHelpers;
@using Dashboard.Models.HtmlHelpers
@{
    var action = Model != 0 ? "Cập nhật" : "Thêm";
    ViewBag.Title = action + " đơn vị";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model int

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card card-primary">
                    <div class="card-header">
                        <div class="card-title">
                            <b>@ViewBag.Title</b>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <input id="Id" value="@Model" type="hidden" />
                            @Html.CustomTextBox(id: "Ten", label: "Tên đơn vị", col: 6, required: true, length: 200, moreClass: "col-sm-6 col-xs-12")
                        </div>

                        <div class="row">
                            <div class="col-sm-12">
                                <div class="modal-footer text-center d-block">
                                    <button id="btn-loading" type="button" class="btn btn-default invisible" data-dismiss="modal">
                                        <img src="~/Content/img/loading.gif" height="25" />
                                    </button>
                                    <a class="btn btn-light mr-2" href="/DonVi"><i class="fa fa-chevron-left"></i> Quay lại</a>
                                    <button onclick="addOrUpdate()" class="btn btn-success"><i class="fa fa-save"></i> @action</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    function loadData() {
        showLoadingModal();
        ajaxGet("/DonVi/GetById?id=" + @Model, function (res) {
            if (res.Item) {
                $("#Ten").val(res.Item.Ten);
            }
            hideLoadingModal();
        }, function () {
            hideLoadingModal();
            toastr.error("Đã có lỗi xảy ra. Vui lòng tải lại trang.");
        });
    }

    function addOrUpdate() {
        showLoadingModal();
        var fd = new FormData();
        fd.append("Id", $("#Id").val());
        fd.append("Ten", $("#Ten").val());

        ajaxPostFormData("/DonVi/ThemOrCapNhat", fd, function (data) {
            hideLoadingModal();
            if (data.Errors && data.Errors.length > 0) {
                data.Errors.map(function (item) {
                    var idError = "#" + item.Id + "Error";
                    if ($(idError).length > 0) {
                        $(idError).text(item.Description);
                    }

                    return "";
                });
            }
            else {
                window.location.href = "/DonVi";
            }
        }, function () {
            hideLoadingModal();
            toastr.error("Đã có lỗi xảy ra. Vui lòng tải lại trang.");
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
        loadData();
    });
</script>
