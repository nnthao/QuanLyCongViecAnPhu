@using Dashboard.HtmlHelpers;
@using Dashboard.Models.HtmlHelpers
@{
    ViewBag.Title = "Đợt xét duyệt";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card card-primary">
                    <div class="card-header">
                        <div class="card-title">
                            <b>@ViewBag.Title</b>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-sm-3 col-xs-12">
                                <a href="/DotXetDuyet/Form?id=0" class="btn btn-success">
                                    <i class="fa fa-plus"></i> Thêm mới
                                </a>
                            </div>
                            @Html.CustomCheckBox(id: "DaXoaSearch", label: "Đã xoá", col: 3,
                                   moreClass: "col-sm-3 col-xs-12 p-t-15")
                            <div class="col-sm-6 col-xs-12">
                                <div class="input-group">
                                    <input onkeypress="enterSearch(event);" id="txt-search" type="text" class="form-control" placeholder="Tìm kiếm">
                                    <div class="input-group-append">
                                        <button id="btn-search" onclick="search();" class="btn btn-primary" type="button">
                                            <i class="fa fa-search"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-sm-3 col-xs-12 mb-2">
                                <label for="FilterTuNgay">Từ ngày</label>
                                <input type="date" id="FilterTuNgay" class="form-control" />
                            </div>
                            <div class="col-sm-3 col-xs-12 mb-2">
                                <label for="FilterDenNgay">Đến ngày</label>
                                <input type="date" id="FilterDenNgay" class="form-control" />
                            </div>
                            <div class="col-sm-6 col-xs-12 mb-2">
                                <label>&nbsp;</label>
                                <div>
                                    <button type="button" class="btn btn-info" onclick="luuKhoangThoiGian()">
                                        <i class="fa fa-save"></i> Lưu khoảng thời gian
                                    </button>
                                    <button type="button" class="btn btn-secondary" onclick="xoaKhoangThoiGian()">
                                        <i class="fa fa-eraser"></i> Xóa
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-sm-12">
                                <table id="bs-table"
                                       data-mobile-responsive="true"
                                       data-check-on-init="true"
                                       data-toggle="table"
                                       data-toolbar="#get"
                                       data-url="/DotXetDuyet/GetListDotXetDuyet"
                                       data-pagination="true"
                                       data-side-pagination="server"
                                       data-page-size="30"
                                       data-page-list="[30, 50, 100, 200]"
                                       data-locale="vi-VN"
                                       data-query-params="queryParams"
                                       data-row-attributes="rowAttributes"
                                       data-sort-name="TenDotXetDuyet"
                                       data-sort-order="asc">
                                    <thead>
                                        <tr>
                                            <th data-field="TenDotXetDuyet">Tên đợt xét duyệt</th>
                                            <th data-field="NamXetDuyet">Năm xét duyệt</th>
                                            <th data-field="TrangThai">Trạng thái</th>
                                            <th class="width-20-per" data-field="operate" data-formatter="operateFormatter" data-events="operateEvents">Thao tác</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<script>
    var selectedId = 0;
    let phanQuyenData = [];

    function rowAttributes(row, index) {
        return {
            'data-id': row.Id
        }
    }

    function operateFormatter(value, row, index) {
        const btnSua = `<a href="/DotXetDuyet/Form?id=${row.Id}" class='btn btn-primary btn-sm m-l-5 m-r-5 m-t-5 m-b-5'><i class='fa fa-pencil'></i> Sửa</a>`;
        const btnXoa = `<button id='btn-delete-item' class='btn btn-danger btn-sm m-l-5 m-r-5 m-t-5 m-b-5'><i class='fa fa-trash'></i> Xóa</button>`;
        const btnKhoiPhuc = `<button id='btn-revert-item' class='btn btn-success btn-sm m-l-5 m-r-5 m-t-5 m-b-5'><i class='fa fa-refresh'></i> Khôi phục</button>`;

        if (row.IsDeleted) {
            return [
                btnSua + btnKhoiPhuc
            ].join("");
        }

        return [
            btnSua + btnXoa
        ].join("");
    }

    window.operateEvents = {
        'click #btn-delete-item': function (e, value, row, index) {
            if (confirm("Bạn muốn xoá đợt xét duyệt này?")) {
                showLoadingModal();

                var fd = new FormData();
                fd.append("Id", row.Id);

                ajaxPostFormData("/DotXetDuyet/Xoa", fd, function funcCallback(data) {
                    hideLoadingModal();
                    toastr.success("Xoá thành công.");
                    search();
                }, function funcError() {
                    toastr.error("Đã có lỗi xảy ra. Vui lòng tải lại trang.");
                })
            }
        },
        'click #btn-revert-item': function (e, value, row, index) {
            if (confirm("Bạn muốn khôi phục đợt xét duyệt này?")) {
                showLoadingModal();

                var fd = new FormData();
                fd.append("Id", row.Id);

                ajaxPostFormData("/DotXetDuyet/KhoiPhuc", fd, function funcCallback(data) {
                    hideLoadingModal();
                    toastr.success("Khôi phục thành công.");
                    search();
                }, function funcError() {
                    toastr.error("Đã có lỗi xảy ra. Vui lòng tải lại trang.");
                })
            }
        }
    }

    function queryParams(params) {
        params.search = btoa(unescape(encodeURIComponent($("#txt-search").val())));
        params.DaXoaSearch = $('#DaXoaSearch').is(":checked");
        return params;
    };

    function search() {
        $('#bs-table').bootstrapTable('refresh');
    };

    function enterSearch(e) {
        if (e.keyCode === 13) {
            $('#bs-table').bootstrapTable('refresh');
        };
    };

    function luuKhoangThoiGian() {
        var tuNgay = $("#FilterTuNgay").val();
        var denNgay = $("#FilterDenNgay").val();

        if (!tuNgay || !denNgay) {
            toastr.warning("Vui lòng chọn đầy đủ từ ngày và đến ngày.");
            return;
        }

        if (new Date(tuNgay) > new Date(denNgay)) {
            toastr.warning("Từ ngày không được lớn hơn đến ngày.");
            return;
        }

        localStorage.setItem("DotXetDuyet_TuNgay", tuNgay);
        localStorage.setItem("DotXetDuyet_DenNgay", denNgay);
        toastr.success("Đã lưu khoảng thời gian. Các đợt xét duyệt nằm trong khoảng thời gian này sẽ hiển thị khi thêm sáng kiến.");
    }

    function xoaKhoangThoiGian() {
        localStorage.removeItem("DotXetDuyet_TuNgay");
        localStorage.removeItem("DotXetDuyet_DenNgay");
        $("#FilterTuNgay").val("");
        $("#FilterDenNgay").val("");
        toastr.success("Đã xóa khoảng thời gian.");
    }

    function loadKhoangThoiGian() {
        var tuNgay = localStorage.getItem("DotXetDuyet_TuNgay");
        var denNgay = localStorage.getItem("DotXetDuyet_DenNgay");
        if (tuNgay) {
            $("#FilterTuNgay").val(tuNgay);
        }
        if (denNgay) {
            $("#FilterDenNgay").val(denNgay);
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        $("#DaXoaSearch").change(function () {
            search();
        });
        loadKhoangThoiGian();
    });
</script>


