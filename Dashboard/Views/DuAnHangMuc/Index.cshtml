@{
    ViewBag.Title = "Cấu hình hạng mục công việc";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card card-primary">
                    <div class="card-header">
                        <div class="card-title"><b>@ViewBag.Title</b></div>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-sm-8">
                                <input type="text" id="keyword" class="form-control" placeholder="Nhập tên hoặc mô tả hạng mục..." />
                            </div>
                            <div class="col-sm-4 text-right">
                                <a href="/DuAnHangMuc/Form" class="btn btn-success"><i class="fa fa-plus"></i> Thêm hạng mục</a>
                            </div>
                        </div>
                        <table id="bsTable" data-locale="vi-VN">
                            <thead>
                                <tr>
                                    <th data-field="ThuTu" data-align="center" data-width="100">Thứ tự</th>
                                    <th data-field="TenHangMuc">Tên hạng mục</th>
                                    <th data-field="MoTa">Mô tả</th>
                                    <th data-field="Id" data-align="center" data-width="140" data-formatter="actionFormatter">Thao tác</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    function loadTable() {
        $("#bsTable").bootstrapTable("destroy");
        $("#bsTable").bootstrapTable({
            url: "/DuAnHangMuc/GetListDuAnHangMuc",
            pagination: true,
            sidePagination: "server",
            queryParams: function (params) {
                params.keyword = $("#keyword").val();
                return params;
            }
        });
    }

    function actionFormatter(value, row) {
        return '<a class="btn btn-sm btn-primary mr-1" href="/DuAnHangMuc/Form/' + row.Id + '"><i class="fa fa-edit"></i></a>' +
               '<button class="btn btn-sm btn-danger" onclick="xoa(' + row.Id + ')"><i class="fa fa-trash"></i></button>';
    }

    function xoa(id) {
        if (!confirm('Bạn có muốn xóa hạng mục này?')) {
            return;
        }

        $.post('/DuAnHangMuc/Xoa', { id: id }, function (res) {
            if (res) {
                toastr.success('Xóa thành công');
                loadTable();
            } else {
                toastr.error('Có lỗi xảy ra');
            }
        });
    }

    $(document).ready(function () {
        loadTable();
        $('#keyword').on('keyup', function (e) {
            if (e.keyCode === 13) {
                loadTable();
            }
        });
    });
</script>