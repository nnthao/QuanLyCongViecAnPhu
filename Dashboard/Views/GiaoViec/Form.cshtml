@using Dashboard.HtmlHelpers;
@using Dashboard.Models.HtmlHelpers
@using Dashboard.Models.HtmlHelpers.Input
@using Dashboard.Models.Entities
@{
    ViewBag.Title = Model.Id != 0 ? "Cập nhật công việc đã giao" : "Tạo việc";
    var actionName = Model.Id != 0 ? "Cập nhật" : "Tạo việc";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model GiaoViecFormQueryViewModel
<style>
    /* Style cho table văn bản đã chọn */
    #listVanBan tr {
        transition: background-color 0.3s ease;
    }

        #listVanBan tr:hover {
            background-color: #f8f9fa;
        }

    #listVanBan td {
        vertical-align: middle;
    }

    /* Style cho các button trong modal */
    .modal-footer .btn {
        margin-left: 5px;
    }

    /* Style cho checkbox column */
    .bootstrap-table .bs-checkbox {
        text-align: center;
    }

    .goi-y-dropdown {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 1060;
        background: #ffffff;
        border: 1px solid #ced4da;
        border-radius: 0.25rem;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        max-height: 220px;
        overflow-y: auto;
        display: none;
        margin-top: 2px;
    }

    .goi-y-item {
        padding: 8px 12px;
        cursor: pointer;
        border-bottom: 1px solid #f1f1f1;
        font-size: 13px;
        line-height: 1.4;
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: background-color 0.15s ease-in-out;
    }

    .goi-y-item:last-child {
        border-bottom: none;
    }

    .goi-y-item:hover,
    .goi-y-item.active {
        background-color: #e9ecef;
        color: #0056b3;
    }

    .goi-y-text {
        flex: 1;
        word-break: break-word;
    }
</style>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card card-primary">
                    <div class="card-header">
                        <div class="card-title">
                            <b>@ViewBag.Title </b>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <input id="Id" type="hidden" value="@Model.Id"/>
                            <input id="IofficeNumber" type="hidden" value="@(Model.IofficeNumber ?? "")"/>
                            <input id="VanBanId" type="hidden" value="@(Model.VanBanId ?? "")"/>
                            @{
                                string tenCongViecValue = "";
                                string ghiChuValue = "";

                                if (Model.Id == 0 && (!string.IsNullOrEmpty(Model.SoKyHieu) || !string.IsNullOrEmpty(Model.TrichYeu) || !string.IsNullOrEmpty(Model.VanBanId)))
                                {
                                    tenCongViecValue = string.Join(" - ", new[] { Model.SoKyHieu, Model.TrichYeu }.Where(v => !string.IsNullOrWhiteSpace(v)));
                                    ghiChuValue = "Nhiệm vụ tạo từ iOffice";
                                }
                            }
                            <div class="col-sm-7 col-xs-12">
                                 <div class="row">
                                      @Html.CustomTextBox(id: "TenCongViec", label: "Tên công việc", col: 12, required: true, length: 10000, moreClass: "col-sm-12 col-xs-12", value: tenCongViecValue)
                                      @Html.CustomTextArea(id: "NoiDung", label: "Nội dung công việc", col: 12, moreClass: "col-sm-12 col-xs-12", row: 3)
                                      @Html.CustomTextArea(id: "GhiChu", label: "Ghi chú", col: 12, moreClass: "col-sm-12 col-xs-12", row: 3, value: ghiChuValue)
                                 </div>
                               
                            </div>
                            <div class="col-sm-5 col-xs-12">
                                  @Html.Partial("~/Views/GiaoViec/FileDinhKem.cshtml")
                            </div>
                        </div>
                        @Html.Partial("~/Views/GiaoViec/NguoiNhanViec.cshtml")
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="modal-footer text-center d-block">
                                    <button id="btn-loading" type="button" class="btn btn-default invisible" data-dismiss="modal">
                                        <img src="~/Content/img/loading.gif" height="25" />
                                    </button>
                                    <a class="btn btn-light mr-2" href="/GiaoViec"><i class="fa fa-chevron-left"></i> Quay lại</a>
                                    <button onclick="addOrUpdate()" class="btn btn-success"><i class="fa fa-save"></i> @actionName</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

@*@Html.Partial("~/Views/GiaoViec/VanBanModal.cshtml")
@Html.Partial("~/Views/TraCuuThongTin/VanBanChiTietModal.cshtml")*@

<script>
    const textFields = ["Id", "TenCongViec", "NoiDung", "GhiChu", "IofficeNumber", "VanBanId"];
    const selectFields = [];
    const radioFields = [];
    const checkBoxFields = [];
    const select2MultiFields = [];

    function loadData() {
        @if (Model.Id == 0 && (!string.IsNullOrEmpty(Model.SoKyHieu) || !string.IsNullOrEmpty(Model.TrichYeu) || !string.IsNullOrEmpty(Model.VanBanId)))
        {
            <text>
            @if (!string.IsNullOrEmpty(Model.VanBanId))
            {
                <text>
                loadIofficeFiles('@Model.VanBanId');
                </text>
            }
            return;
            </text>
        }
        else if (Model.Id > 0)
        {
            <text>
            showLoadingModal();
            ajaxGet("/GiaoViec/GetById?id=" + @Model.Id, function funcCallback(res) {
                if (res.Item) {
                    FormHelper.setValueForUpdate(res.Item, textFields, selectFields, radioFields, checkBoxFields);
                    if (res.Item.GiaoViecFiles && res.Item.GiaoViecFiles.length > 0) {
                        TaiLieuDinhKemDatas = res.Item.GiaoViecFiles.map(function (f) {
                            return {
                                Id: f.Id,
                                TenFile: f.TenFile,
                                DuongDan: f.DuongDan,
                                IsUpload: true
                            };
                        });
                        $("#bsTaiLieuDinhKem").bootstrapTable("destroy");
                        $("#bsTaiLieuDinhKem").bootstrapTable({ data: TaiLieuDinhKemDatas });
                    }
                    if (res.Item.GiaoViecVanBanLienQuans) {
                        setVanBanLienQuan(res.Item.GiaoViecVanBanLienQuans);
                    }
                    if (res.Item.GiaoViecThanhViens) {
                        setThanhVienNhanViec(res.Item.GiaoViecThanhViens);
                    }
                    hideLoadingModal();
                }
            }, function funcError() {
                hideLoadingModal();
                toastr.error("Đã có lỗi xảy ra. Vui lòng tải lại trang.");
            });
            </text>
        }
    }

    function loadIofficeFiles(vanBanId) {
        if (!vanBanId) return;
        showLoadingModal();
        ajaxGet("/GiaoViec/GetFileAttachFromIoffice?vanBanId=" + encodeURIComponent(vanBanId), function (res) {
            hideLoadingModal();
            if (res && res.data && res.data.length > 0) {
                if (typeof addIofficeFilesToTaiLieuDinhKem === 'function') {
                    addIofficeFilesToTaiLieuDinhKem(res.data);
                }
            }
        }, function () {
            hideLoadingModal();
            toastr.error("Không thể lấy danh sách file đính kèm từ iOffice.");
        });
    }

    function getThongTinNhanViecArray() {
        if (typeof window.getThongTinNhanViecArray === 'function') {
            return window.getThongTinNhanViecArray();
        }
        var arr = [];
        $('#thongTinNhanViec tr[data-user-id]').each(function () {
            var userId = $(this).data('user-id');
            var tenNhanVien = $(this).find('td:first').text().trim();
            var noiDungNhiemVu = $(this).find('.noi-dung-nhiem-vu').val() || '';
            var hanXuLy = $(this).find('.han-xu-ly').val() || '';
            var vaiTroXuLyId = $(this).find('.vai-tro-xu-ly').val() || '';
            var vaiTroXuLyIdValue = vaiTroXuLyId ? parseInt(vaiTroXuLyId, 10) : null;
            arr.push({
                ThanhVienId: parseInt(userId, 10),
                ThanhVien: tenNhanVien,
                NoiDungNhiemVu: noiDungNhiemVu,
                HanXuLyStr: hanXuLy,
                VaiTroXuLyId: vaiTroXuLyIdValue
            });
        });
        return arr;
    }

    function getFormData() {
        var fd = FormHelper.getFormData(textFields, selectFields, radioFields, checkBoxFields);

        // Lấy danh sách văn bản từ DOM thay vì từ selectedVanBanList
        if (typeof getSelectedVanBanFromDOM !== 'undefined') {
            var selectedVanBanList = getSelectedVanBanFromDOM();
            var vanBanIds = selectedVanBanList.map(vb => vb.Id);
            fd.append("VanBanLienQuanIds", vanBanIds.join(","));
        }

        //lay file ID
        let listIds = TaiLieuDinhKemDatas.map(x => x.Id);
        fd.append("TaiLieuDinhKemIds", listIds.join(','));
        // save file
        let iofficeFiles = [];
        for (let i = 0; i < TaiLieuDinhKemDatas.length; i++) {
            let item = TaiLieuDinhKemDatas[i];
            if (item.IsIofficeFile && item.IofficeFileId) {
                iofficeFiles.push({
                    FileId: item.IofficeFileId.toString(),
                    FileName: item.TenFile
                });
            } else if (item.IsUpload == false && item.File) {
                fd.append("FileDinhKems", item.File, item.TenFile || item.File.name);
            }
        }
        if (iofficeFiles.length > 0) {
            fd.append("IofficeFileStr", JSON.stringify(iofficeFiles));
        }

        fd.append("ThanhVienStr", JSON.stringify(getThongTinNhanViecArray()));

        return fd;
    }

    function addOrUpdate() {
        showLoadingModal();

        var selectAll = selectFields.concat(select2MultiFields);
        FormHelper.clearError(textFields, selectAll, radioFields, checkBoxFields);

        ajaxPostFormData("/GiaoViec/ThemOrCapNhat", getFormData(), function funcCallback(data) {
            hideLoadingModal();
            if (data.Errors && data.Errors.length > 0) {
                data.Errors.map((item) => {
                    var idError = "#" + item.Name;
                    $(idError).show();
                    $(idError).html(item.Description);
                    return "";
                });
            } else {
                window.location.href = "/GiaoViec";
            }
        }, function funcError() {
            toastr.error("Đã có lỗi xảy ra. Vui lòng tải lại trang.");
        });
    }


    var goiYTimeoutForm = null;
    var selectedGoiYIndexForm = -1;

    function initFormNoiDungAutocomplete() {
        var $textarea = $("#NoiDung");
        if ($textarea.length === 0) return;

        var $parent = $textarea.closest(".form-group");
        $parent.css("position", "relative");

        if ($("#formNoiDungSuggestions").length === 0) {
            $textarea.after('<div id="formNoiDungSuggestions" class="goi-y-dropdown"></div>');
        }

        var $dropdown = $("#formNoiDungSuggestions");

        $textarea.off("input.goiy focus.goiy keydown.goiy")
            .on("input.goiy focus.goiy", function () {
                var keyword = $(this).val();
                if (goiYTimeoutForm) clearTimeout(goiYTimeoutForm);
                goiYTimeoutForm = setTimeout(function () {
                    loadFormGoiYNoiDung(keyword);
                }, 200);
            })
            .on("keydown.goiy", function (e) {
                var $items = $dropdown.find(".goi-y-item");
                if (!$dropdown.is(":visible") || $items.length === 0) return;

                if (e.key === "ArrowDown") {
                    e.preventDefault();
                    selectedGoiYIndexForm = (selectedGoiYIndexForm + 1) % $items.length;
                    updateFormGoiYSelection($items);
                } else if (e.key === "ArrowUp") {
                    e.preventDefault();
                    selectedGoiYIndexForm = (selectedGoiYIndexForm - 1 + $items.length) % $items.length;
                    updateFormGoiYSelection($items);
                } else if (e.key === "Enter") {
                    if (selectedGoiYIndexForm >= 0 && selectedGoiYIndexForm < $items.length) {
                        e.preventDefault();
                        $items.eq(selectedGoiYIndexForm).trigger("mousedown");
                    }
                } else if (e.key === "Escape") {
                    hideFormNoiDungSuggestions();
                }
            });
    }

    function updateFormGoiYSelection($items) {
        $items.removeClass("active");
        if (selectedGoiYIndexForm >= 0 && selectedGoiYIndexForm < $items.length) {
            var $active = $items.eq(selectedGoiYIndexForm);
            $active.addClass("active");
            if ($active[0] && typeof $active[0].scrollIntoView === 'function') {
                $active[0].scrollIntoView({ block: "nearest" });
            }
        }
    }

    function loadFormGoiYNoiDung(keyword) {
        var url = "/GiaoViec/GetGoiYNoiDung?Keyword=" + encodeURIComponent(keyword || '') + "&Limit=10&Loai=1";
        ajaxGet(url, function (res) {
            var $dropdown = $("#formNoiDungSuggestions");
            selectedGoiYIndexForm = -1;
            if (res && res.length > 0) {
                var html = "";
                for (var i = 0; i < res.length; i++) {
                    var item = res[i];
                    var safeText = $('<div>').text(item.NoiDung).html();
                    var encodedText = encodeURIComponent(item.NoiDung);
                    html += `<div class="goi-y-item" data-text="${encodedText}">
                                <span class="goi-y-text">${safeText}</span>
                             </div>`;
                }
                $dropdown.html(html).show();

                $dropdown.find(".goi-y-item").on("mousedown", function (e) {
                    e.preventDefault();
                    var text = decodeURIComponent($(this).data("text"));
                    $("#NoiDung").val(text).trigger("change");
                    hideFormNoiDungSuggestions();
                });
            } else {
                hideFormNoiDungSuggestions();
            }
        });
    }

    function hideFormNoiDungSuggestions() {
        $("#formNoiDungSuggestions").hide();
        selectedGoiYIndexForm = -1;
    }

    document.addEventListener("DOMContentLoaded", function () {
        loadData();
        initFormNoiDungAutocomplete();

        $(document).on("click", function (e) {
            if (!$(e.target).closest("#NoiDung, #formNoiDungSuggestions").length) {
                hideFormNoiDungSuggestions();
            }
        });
    });
</script>

