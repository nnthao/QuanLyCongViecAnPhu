@using Dashboard.HtmlHelpers;
@using Dashboard.Models.HtmlHelpers
@{
    ViewBag.Title = "Công việc đã chuyển giao";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card card-primary">
                    <div class="card-header">
                        <div class="card-title">
                            <b>@ViewBag.Title</b>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            @Html.CustomDatePicker(id: "TuNgayStr", label: "Ngày chuyển giao từ ", col: 2, moreClass:"col-xs-12", required: false)
                            @Html.CustomDatePicker(id: "DenNgayStr", label: "Đến ngày", col: 2, moreClass: "col-xs-12", required: false)
                            @Html.CustomSelect2Empty(id: "NguoiNhanChuyenGiaoId", label: "Người được giao", col: 3, moreClass: "col-sm-3 col-xs-12")
                            <div class="col-sm-3 col-xs-12">
                                <div class="form-group">
                                    <label for="TrangThaiSearch">Trạng thái</label>
                                    <select id="TrangThaiSearch" class="form-control">
                                        <option value="0">-- Chọn --</option>
                                        <option value="1">Đã hoàn thành</option>
                                        <option value="2">Chưa hoàn thành</option>
                                    </select>
                                </div>
                            </div>
                             <div class="col-sm-2 col-xs-12">
                                <div class="form-group">
                                    <label for="txt-search" style="width:100%">&nbsp;</label>
                                    <div class="input-group">
                                        <input onkeypress="enterSearch(event);" id="txt-search" type="text" class="form-control" placeholder="Tìm kiếm">
                                        <div class="input-group-append">
                                            <button id="btn-search" onclick="search();" class="btn btn-primary" type="button">
                                                <i class="fa fa-search"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-sm-12">
                                <table id="bs-table"
                                       data-mobile-responsive="true"
                                       data-check-on-init="true"
                                       data-columns-hidden="['GhiChu']"
                                       data-toggle="table"
                                       data-toolbar="#get"
                                       data-url="/GiaoViecDaChuyenGiao/GetListCongViecDaChuyenGiao"
                                       data-pagination="true"
                                       data-side-pagination="server"
                                       data-page-size="30"
                                       data-page-list="[30, 50, 100, 200]"
                                       data-locale="vi-VN"
                                       data-query-params="queryParams"
                                       data-row-attributes="rowAttributes"
                                       data-sort-name="NgayChuyenGiao"
                                       data-sort-order="desc">
                                    <thead>
                                        <tr>
                                            <th data-field="TenCongViec" data-formatter="tenCongViecChiTietFormatter">Tên công việc</th>
                                            <th data-field="NguoiGiao">Người giao việc</th>
                                            <th data-field="NoiDung">Nội dung</th>
                                            <th data-field="NgayTaoStr">Ngày giao</th>
                                            <th data-field="ThanhVienStrs" data-formatter="thanhVienFormatter">Người nhận</th>
                                            <th data-field="NgayChuyenGiaoStr">Ngày chuyển giao</th>
                                            <th data-field="GhiChu">Ghi chú</th>
                                            <th class="width-20-per" data-field="operate" data-formatter="operateFormatter" data-events="operateEvents">&nbsp;</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@Html.Partial("~/Views/GiaoViec/XemThongTinModal.cshtml")

<!-- Modal Nhắc nhở -->
<div class="modal fade" id="nhacNhoModal" tabindex="-1" role="dialog" aria-labelledby="nhacNhoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="nhacNhoModalLabel">Nhắc nhở thành viên</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label><strong id="tenCongViecModal"></strong></label>
                </div>
                <div class="form-group">
                    <label>Chọn thành viên cần nhắc nhở:</label>
                    <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                        <table class="table table-bordered table-hover">
                            <thead>
                                <tr>
                                    <th style="width: 50px;" class="text-center">
                                        <input type="checkbox" id="checkAllThanhVien" />
                                    </th>
                                    <th>Thành viên</th>
                                    <th>Hạn xử lý</th>
                                    <th>Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody id="danhSachThanhVien">
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><i class="fa fa-times"></i> Đóng</button>
                <button type="button" class="btn btn-primary" id="btnGuiNhacNho"><i class="fa fa-bell"></i> Gửi nhắc nhở</button>
            </div>
        </div>
    </div>
</div>

<script>
    function rowAttributes(row, index) {
        return {
            'data-id': row.Id
        };
    }

    var currentRowData = null;

    function operateFormatter(value, row, index) {
        var html = `<button id="btn-nhac-nho" class='btn btn-warning btn-sm m-l-5 m-r-5 m-t-5 m-b-5'><i class='fa fa-bell'></i> Nhắc nhở</button>`;
        if (row.GiaoViecThanhViens && row.GiaoViecThanhViens.length > 0) {
            html += `<button id="btn-lay-lai" class='btn btn-info btn-sm m-l-5 m-r-5 m-t-5 m-b-5'><i class='fa fa-undo'></i> Lấy lại</button>`;
        }
        return html;
    }

    function thanhVienFormatter(value, row, index) {
        if (!row.GiaoViecThanhViens || row.GiaoViecThanhViens.length === 0) {
            return '';
        }

        let html = ``;
        for (let i = 0; i < row.GiaoViecThanhViens.length; i++) {
            let item = row.GiaoViecThanhViens[i];

            var hanXuLy = `- Hạn xử lý: <b>${item.HanXuLyStr || ''}</b>`;
            var statusHtml = '';

            if (item.IsHoanThanh) {
                // Đã hoàn thành
                statusHtml = `<span class="text-success text-bold">✅ Đã hoàn thành</span> ${hanXuLy}`;
            } else {
                // Chưa hoàn thành
                if (item.SoNgayConLai >= 0) {
                    // Còn thời gian
                    statusHtml = `<span class="text-warning text-bold">⏳ Chưa hoàn thành</span> ${hanXuLy} (Còn lại ${item.SoNgayConLai} ngày)`;
                } else {
                    // Trễ hạn
                    statusHtml = `<span class="text-danger text-bold">❌ Trễ hạn</span> ${hanXuLy} (Trễ ${Math.abs(item.SoNgayConLai)} ngày)`;
                }
            }

            html += `<p><b><a href="javascript:void(0)" onclick="openXemThongTinModal(${item.Id}, ${row.GiaoViecId}, ${item.ThanhVienId})">${item.ThanhVien || ''}</a></b> - ${statusHtml}</p>`;
        }
        return html;
    }

    function hanXulyFormatter(value, row, index) {
        var hanXuLyStr = row.HanXuLyStr || '';
        if (row.IsHoanThanh) {
            return `<span class="text-success text-bold">✅ Đã hoàn thành</span> - Hạn xử lý: <b>${hanXuLyStr}</b>`;
        }
        if (row.SoNgayConLai >= 0) {
            return `<span class="text-warning text-bold">⏳ Chưa hoàn thành</span> - Hạn xử lý: <b>${hanXuLyStr}</b> (Còn lại ${row.SoNgayConLai} ngày)`;
        }
        return `<span class="text-danger text-bold">❌ Trễ hạn</span> - Hạn xử lý: <b>${hanXuLyStr}</b> (Trễ ${Math.abs(row.SoNgayConLai)} ngày)`;
    }

    window.operateEvents = {
        'click #btn-nhac-nho': function (e, value, row, index) {
            currentRowData = row;
            openNhacNhoModal(row);
        },
        'click #btn-lay-lai': function (e, value, row, index) {
            layLaiCongViec(row);
        }
    }

    function openNhacNhoModal(row) {
        if (!row.GiaoViecThanhViens || row.GiaoViecThanhViens.length === 0) {
            toastr.warning("Không có thành viên để nhắc nhở.");
            return;
        }

        $("#tenCongViecModal").text(row.TenCongViec || '');
        var tbody = $("#danhSachThanhVien");
        tbody.empty();

        row.GiaoViecThanhViens.forEach(function (item) {
            var statusText = '';
            var statusClass = '';
            if (item.IsHoanThanh) {
                statusText = 'Đã hoàn thành';
                statusClass = 'text-success';
            } else {
                if (item.SoNgayConLai >= 0) {
                    statusText = `Chưa hoàn thành ${item.PhanTramHoanThanh || 0}% (Còn lại ${item.SoNgayConLai} ngày)`;
                    statusClass = 'text-warning';
                } else {
                    statusText = 'Trễ hạn';
                    statusClass = 'text-danger';
                }
            }

            var tr = $(`
                <tr class="row-clickable" style="cursor: pointer;">
                    <td class="text-center">
                        <input type="checkbox" class="checkbox-thanh-vien" data-giao-viec-thanh-vien-id="${item.Id}" data-thanh-vien-id="${item.ThanhVienId}" data-han-xu-ly="${item.HanXuLyStr || ''}" ${item.IsHoanThanh ? 'disabled' : ''} />
                    </td>
                    <td>${item.ThanhVien || ''}</td>
                    <td>${item.HanXuLyStr || ''}</td>
                    <td class="${statusClass}">${statusText}</td>
                </tr>
            `);
            tbody.append(tr);

            tr.on('click', function (e) {
                if ($(e.target).is('input[type="checkbox"]')) {
                    return;
                }
                var checkbox = $(this).find('.checkbox-thanh-vien');
                if (!checkbox.is(':disabled')) {
                    checkbox.prop('checked', !checkbox.prop('checked'));
                }
            });
        });

        $("#checkAllThanhVien").prop('checked', false);
        $("#nhacNhoModal").modal('show');
    }

    function guiNhacNho() {
        var selectedThanhViens = [];
        $(".checkbox-thanh-vien:checked").each(function () {
            selectedThanhViens.push({
                GiaoViecThanhVienId: $(this).data('giao-viec-thanh-vien-id'),
                ThanhVienId: $(this).data('thanh-vien-id'),
                HanXuLy: $(this).data('han-xu-ly')
            });
        });

        if (selectedThanhViens.length === 0) {
            toastr.warning("Vui lòng chọn ít nhất một thành viên để nhắc nhở.");
            return;
        }

        if (!currentRowData) {
            toastr.error("Không tìm thấy thông tin công việc.");
            return;
        }

        showLoadingModal();

        var fd = new FormData();
        fd.append("GiaoViecId", currentRowData.GiaoViecId);
        fd.append("TenCongViec", currentRowData.TenCongViec);
        fd.append("ThanhViens", JSON.stringify(selectedThanhViens));

        ajaxPostFormData("/GiaoViecDaChuyenGiao/GuiNhacNho", fd, function funcCallback(data) {
            hideLoadingModal();
            if (data.Errors && data.Errors.length > 0) {
                var errorMsg = data.Errors.map(function (e) { return e.Description; }).join("<br/>");
                toastr.error(errorMsg);
            } else {
                toastr.success("Gửi nhắc nhở thành công.");
                $("#nhacNhoModal").modal('hide');
            }
        }, function funcError() {
            hideLoadingModal();
            toastr.error("Đã có lỗi xảy ra. Vui lòng thử lại.");
        });
    }

    function queryParams(params) {
        params.search = btoa(unescape(encodeURIComponent($("#txt-search").val())));
        params.DaXoaSearch = $('#DaXoaSearch').is(":checked");
        params.TuNgayStr = $("#TuNgayStr").val();
        params.DenNgayStr = $("#DenNgayStr").val();
        params.TrangThaiSearch = $("#TrangThaiSearch").val();
        params.NguoiNhanChuyenGiaoId = $("#NguoiNhanChuyenGiaoId").val();
        return params;
    };

    function search() {
        $('#bs-table').bootstrapTable('refresh');
    };

    function enterSearch(e) {
        if (e.keyCode === 13) {
            $('#bs-table').bootstrapTable('refresh');
        };
    };

    function layLaiCongViec(row) {
        if (!row.GiaoViecThanhViens || row.GiaoViecThanhViens.length === 0) {
            toastr.warning("Không có công việc để lấy lại.");
            return;
        }

        if (!confirm(`Bạn có chắc chắn muốn lấy lại công việc "${row.TenCongViec}"?`)) {
            return;
        }

        showLoadingModal();
        var fd = new FormData();
        fd.append("giaoViecThanhVienId", row.GiaoViecThanhViens[0].Id);

        ajaxPostFormData("/GiaoViecDaChuyenGiao/LayLaiCongViecChuyenGiao", fd, function funcCallback(data) {
            hideLoadingModal();
            if (data.Errors && data.Errors.length > 0) {
                toastr.error(data.Errors.map(e => e.Description).join("<br/>"));
            } else {
                toastr.success("Lấy lại công việc thành công.");
            }
            search();
        }, function funcError() {
            hideLoadingModal();
            toastr.error("Đã có lỗi xảy ra.");
            search();
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
        $("#DaXoaSearch").change(function () {
            search();
        });

        $("#TrangThaiSearch, #NguoiNhanChuyenGiaoId").change(function () {
            search();
        });

        ajaxGet("/GiaoViecDaChuyenGiao/GetNguoiNhanChuyenGiaoLookup", function funcCallback(res) {
            var data = [{ id: '', text: '-- Chọn --' }].concat(res || []);
            $("#NguoiNhanChuyenGiaoId").select2({
                data: data,
                language: "vi",
                placeholder: "-- Chọn --",
                allowClear: true
            });
        }, function funcError() {
            toastr.error("Đã có lỗi xảy ra. Vui lòng tải lại trang.");
        });

        $("#checkAllThanhVien").change(function () {
            var isChecked = $(this).is(':checked');
            $(".checkbox-thanh-vien:not(:disabled)").prop('checked', isChecked);
        });

        $("#btnGuiNhacNho").click(function () {
            guiNhacNho();
        });
    });
</script>

