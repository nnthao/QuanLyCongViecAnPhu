@using Dashboard.HtmlHelpers;
@using Dashboard.Models.HtmlHelpers
@using Dashboard.Models.HtmlHelpers.Input
@using Dashboard.Models.Entities
@using System.Linq
@using Dashboard.Common
@{
    ViewBag.Title = "Thống kê mức độ hoàn thành theo phòng ban";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var dauThang = Dashboard.Common.DateTimeHelper.NgayDauThang(DateTime.Now).ToString("dd/MM/yyyy");
    var cuoiThang = Dashboard.Common.DateTimeHelper.NgayCuoiThang(DateTime.Now).ToString("dd/MM/yyyy");


    var identity = (System.Security.Claims.ClaimsIdentity)User.Identity;
    var phongBanCurrentId = UserClaimHelper.GetPhongBanId(identity);
    var isSystemUser = UserClaimHelper.GetIsSystemUser(identity);
    var isQuyenGiaoViecTatCaPhongBan = UserClaimHelper.IsQuyenAllow(identity, QuyenMoRong.QuyenGiaoViecTatCaPhongBan.ToString());

    var phongBanList = new List<Dashboard.Models.Entities.PhongBanGridVo>();
    var phongBanIds = new List<int>();

    if (isSystemUser || isQuyenGiaoViecTatCaPhongBan)
    {
        phongBanList = UltiHelper.GetPhongBanTreeSorted(0, true);
        phongBanIds = phongBanList.Select(pb => pb.Id).ToList();
    }
    else if (phongBanCurrentId != 0)
    {
        var allPhongBans = CacheManagerHelper.GetPhongBanCache();
        var phongBanCurrent = allPhongBans.FirstOrDefault(pb => pb.Id == phongBanCurrentId && pb.IsDeleted != true && pb.IsPhongNhanViec != false);

        // Thêm phòng ban hiện tại trước
        if (phongBanCurrent != null)
        {
            phongBanList.Add(phongBanCurrent);
            phongBanIds.Add(phongBanCurrent.Id);
        }

        // Lấy danh sách phòng ban con đã được sắp xếp theo cấu trúc cây (giống LichHop)
        var phongBanChildrenLookups = UltiHelper.GetPhongBanChildrenSorted(phongBanCurrentId);
        var phongBanChildren = phongBanChildrenLookups
            .Select(lookup => allPhongBans.FirstOrDefault(pb => pb.Id == lookup.id && pb.IsDeleted != true && pb.IsPhongNhanViec != false))
            .Where(pb => pb != null)
            .ToList();

        phongBanList.AddRange(phongBanChildren);
        phongBanIds.AddRange(phongBanChildren.Select(pb => pb.Id));
    }

    var phongBans = phongBanList;

    // Lọc users chỉ lấy các user thuộc các phòng ban được phép
    var allUsers = Dashboard.Common.CacheManagerHelper.GetListUserFromCacheNotDeleted();
    var users = (isSystemUser || isQuyenGiaoViecTatCaPhongBan)
        ? allUsers
        : allUsers.Where(u => u.PhongBanId.HasValue && phongBanIds.Contains(u.PhongBanId.Value)).ToList();
    
    // Tạo danh sách ID phòng ban dạng string để dùng trong JavaScript
    var phongBanIdsStr = string.Join(",", phongBanIds);
    
    // Tạo danh sách trạng thái
    var trangThais = new List<MultiSelectItem>
    {
        new MultiSelectItem { Id = 1, Text = "Hoàn thành sớm hạn" },
        new MultiSelectItem { Id = 2, Text = "Hoàn thành đúng hạn" },
        new MultiSelectItem { Id = 5, Text = "Hoàn thành trễ hạn" },
        new MultiSelectItem { Id = 3, Text = "Chưa hoàn thành Còn hạn" },
        new MultiSelectItem { Id = 4, Text = "Chưa hoàn thành trễ hạn" }
    };
}
<style>
    #thongKeTable th {
        text-align: center;
    }
</style>
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card card-primary">
                    <div class="card-header">
                        <div class="card-title">
                            <b>@ViewBag.Title</b>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            @Html.CustomDatePicker(id: "TuNgayStr", label: "Ngày giao Từ ngày", col: 4, required: true, moreClass: "col-sm-4 col-xs-12", value: dauThang)
                            @Html.CustomDatePicker(id: "DenNgayStr", label: "Đến ngày", col: 4, required: true, moreClass: "col-sm-4 col-xs-12", value: cuoiThang)
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="form-group">
                                    <label>
                                        &nbsp;
                                    </label>
                                    <div class="input-group">
                                        <button onclick="thongKe();" class="btn btn-primary mr-2"><i class="fa fa-check"></i> Thống kê</button>
                                        <button onclick="xuatExcel();" class="btn btn-success mr-2"><i class="fa fa-file-excel-o"></i> Xuất Excel</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            @Html.CustomMultiSelect(
                                id: "phongBanMultiSelect",
                                label: "Chọn phòng ban",
                                items: phongBans,
                                getId: pb => pb.Id,
                                getText: pb => pb.Ten,
                                col: 4,
                                placeHolderText: "--- Chọn phòng ban ---",
                                moreClass: "col-sm-4 col-xs-12",
                                selectAllText: "Lựa chọn tất cả phòng ban",
                                onChangeCallback: "onPhongBanChange"
                            )
                            @Html.CustomMultiSelect(
                                id: "caNhanMultiSelect",
                                label: "Chọn cá nhân",
                                items: users,
                                getId: u => u.Id,
                                getText: u => u.Name,
                                col: 4,
                                placeHolderText: "--- Chọn cá nhân ---",
                                moreClass: "col-sm-4 col-xs-12",
                                selectAllText: "Lựa chọn tất cả cá nhân",
                                dataAttributeName: "phongban",
                                getDataAttributeValue: u => u.PhongBanId?.ToString() ?? ""
                            )
                            @Html.CustomMultiSelect(
                                id: "trangThaiMultiSelect",
                                label: "Chọn trạng thái",
                                items: trangThais,
                                col: 4,
                                placeHolderText: "--- Chọn trạng thái hoàn thành ---",
                                moreClass: "col-sm-4 col-xs-12",
                                selectAllText: "Lựa chọn tất cả trạng thái"
                            )
                        </div>
                        <div class="row">
                            <div class="col-sm-12">
                                <table id="bs-tableVanBan"
                                       data-toggle="table"
                                       data-toolbar="#get"
                                       data-url="/GiaoViecThongKe/GetListChiTietHoanThanhCongViecTheoTrangThai"
                                       data-pagination="true"
                                       data-side-pagination="server"
                                       data-page-size="30"
                                       data-page-list="[30, 50, 100, 200]"
                                       data-locale="vi-VN"
                                       data-query-params="queryParamsChiTietCongViec"
                                       data-sort-name="HanXuLy"
                                       data-id-field="Id">
                                    <thead>
                                        <tr>
                                            <th data-field="PhongBan">Phòng ban</th>
                                            <th data-field="ThanhVien">Người thưc hiện</th>
                                            <th data-field="TenCongViec">Tên công việc</th>
                                            <th data-field="NoiDungNhiemVu">Nội dung</th>
                                            <th data-field="NgayGiaoViecStr">Ngày giao việc</th>
                                            <th data-field="NgayHoanThanhStr">Ngày hoàn thành</th>
                                            <th data-field="HanXuLyStr" data-class="text-danger">Hạn xử lý</th>
                                            <th data-field="TrangThaiHoanThanh" data-formatter="trangThaiHoanThanhFormatter">Trạng thái</th>
                                            <th data-width="200" data-formatter="operateFormatter">&nbsp;</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
@Html.Partial("~/Views/GiaoViec/XemThongTinModal.cshtml")

<script>
    // ===========================================
    // MULTI-SELECT HELPER FUNCTIONS
    // ===========================================
    
    // Danh sách ID phòng ban có thể có (từ server-side)
    var allPhongBanIds = '@phongBanIdsStr'.split(',').filter(id => id.trim() !== '');

    // Function để lấy danh sách ID phòng ban đã chọn
    // Nếu không có phòng ban nào được check, trả về tất cả ID phòng ban có thể có
    function getSelectedPhongBanIds() {
        // Lấy trực tiếp từ DOM để đảm bảo lấy được tất cả các checkbox đã checked (không filter visible)
        var selectedCheckboxes = $('#phongBanMultiSelect_options input[type="checkbox"]:not([value="all"]):checked');
        if (selectedCheckboxes.length > 0) {
            return selectedCheckboxes.map(function() {
                return $(this).val();
            }).get().join(',');
        }
        // Nếu không có phòng ban nào được check, trả về tất cả ID phòng ban có thể có
        return allPhongBanIds.join(',');
    }

    // Function để lấy danh sách ID cá nhân đã chọn
    function getSelectedCaNhanIds() {
        // Lấy trực tiếp từ DOM để đảm bảo lấy được tất cả các checkbox đã checked (không filter visible)
        var selectedCheckboxes = $('#caNhanMultiSelect_options input[type="checkbox"]:not([value="all"]):checked');
        if (selectedCheckboxes.length > 0) {
            return selectedCheckboxes.map(function() {
                return $(this).val();
            }).get().join(',');
        }
        return '';
    }

    // Function để lấy danh sách trạng thái đã chọn
    function getSelectedTrangThaiValues() {
        // Lấy trực tiếp từ DOM để đảm bảo lấy được tất cả các checkbox đã checked (không filter visible)
        var selectedCheckboxes = $('#trangThaiMultiSelect_options input[type="checkbox"]:not([value="all"]):checked');
        if (selectedCheckboxes.length > 0) {
            return selectedCheckboxes.map(function() {
                return $(this).val();
            }).get().join(',');
        }
        return '';
    }

    // Callback khi phòng ban thay đổi
    function onPhongBanChange() {
        if (typeof filterMultiSelectOptionsBySource === 'function') {
            filterMultiSelectOptionsBySource('caNhanMultiSelect', 'phongBanMultiSelect', 'phongban');
        }
    }

    // Add event listeners to checkboxes
    $(document).ready(function() {
        // Gọi filterMultiSelectOptionsBySource khi trang load để hiển thị tất cả cá nhân (vì không có phòng ban nào được check)
        if (typeof filterMultiSelectOptionsBySource === 'function') {
            filterMultiSelectOptionsBySource('caNhanMultiSelect', 'phongBanMultiSelect', 'phongban');
        }
    });

    function queryParamsChiTietCongViec(params) {
        params.TuNgayStr = $("#TuNgayStr").val() || "";
        params.DenNgayStr = $("#DenNgayStr").val() || "";
        params.PhongBanId = $("#PhongBanId").val() || "";
        params.IsHoanThanhType = $("#IsHoanThanhType").val() || "";
        params.PhongBanIdsStr = getSelectedPhongBanIds();
        params.IsHoanThanhTypeListStr = getSelectedTrangThaiValues();
        params.ThanhVienIdListStr = getSelectedCaNhanIds();
        
        return params;
    }

    function searchChiTietCongViec() {
        $('#bs-tableVanBan').bootstrapTable('refresh');
    }

    function thongKe() {
        searchChiTietCongViec();
    }

    function xuatExcel() {
        // Get selected values
        var phongBanIds = getSelectedPhongBanIds();
        var trangThaiValues = getSelectedTrangThaiValues();
        var caNhanIds = getSelectedCaNhanIds();
       
        var fd = new FormData();
        fd.append("TuNgayStr", $("#TuNgayStr").val());
        fd.append("DenNgayStr", $("#DenNgayStr").val());
        fd.append("PhongBanIdsStr", phongBanIds);
        fd.append("IsHoanThanhTypeListStr", trangThaiValues);
        fd.append("ThanhVienIdListStr", caNhanIds);

        showLoadingModal();
        ajaxPostFormData("/GiaoViecThongKe/XuatExcelChiTietCongViecTheoTrangThai", fd,
            function funcCallback(response) {
            hideLoadingModal();

            if (response.success === false) {
                // Handle validation errors
                if (response.Errors && response.Errors.length > 0) {
                    var errorMessages = response.Errors.map(function (error) {
                        return error.Description;
                    }).join('\n');
                    alert(errorMessages);
                } else if (response.message) {
                    alert(response.message);
                }
            } else if (response.downloadUrl) {
                downloadFromLink(response.downloadUrl, response.fileName)
                toastr.success(response.message || "Xuất Excel thành công");
            }
        }, function funcError() {
            hideLoadingModal();
            toastr.error("Đã có lỗi xảy ra. Vui lòng tải lại trang.");
        })
    }

    function trangThaiHoanThanhFormatter(value, row, index) {
        if (!value) return `<span class="badge badge-secondary">-</span>`;
        var badgeClass = 'badge-secondary';
        var valLower = value.toString().toLowerCase();
        if (valLower.indexOf('sớm') !== -1) {
            badgeClass = 'badge-success';
        } else if (valLower.indexOf('đúng') !== -1) {
            badgeClass = 'badge-primary';
        } else if (valLower.indexOf('còn') !== -1) {
            badgeClass = 'badge-info';
        } else if (valLower.indexOf('trễ') !== -1 || valLower.indexOf('quá') !== -1) {
            badgeClass = 'badge-danger';
        }
        return `<span class="badge ${badgeClass}">${value}</span>`;
    }

    function operateFormatter(value, row, index) {
        return `<button type="button" onclick="openXemThongTinModal(${row.Id}, ${row.GiaoViecId}, ${row.ThanhVienId})" class='btn btn-info btn-sm m-l-5 m-r-5 m-t-5 m-b-5'>
                <i class='fa fa-eye'></i> Xem thông tin</button>`;
    }
</script>
