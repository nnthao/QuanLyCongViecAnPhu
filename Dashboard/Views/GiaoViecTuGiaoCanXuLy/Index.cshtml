@using Dashboard.HtmlHelpers;
@using Dashboard.Models.HtmlHelpers
@{
    ViewBag.Title = "Công việc tự giao cần xử lý";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card card-primary">
                    <div class="card-header">
                        <div class="card-title">
                            <b>@ViewBag.Title</b>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            @Html.CustomDatePicker(id: "TuNgayStr", label: "Ngày giao từ ", col: 2, moreClass:"col-xs-12", required: false)
                            @Html.CustomDatePicker(id: "DenNgayStr", label: "Đến ngày", col: 2, moreClass: "col-xs-12", required: false)
                            <div class="col-sm-3 col-xs-12">
                                <div class="form-group">
                                    <label for="TrangThaiSearch">Trạng thái</label>
                                    <select id="TrangThaiSearch" class="form-control">
                                        <option value="0">-- Chọn --</option>
                                        <option value="1">Đã hoàn thành</option>
                                        <option value="2" selected>Chưa hoàn thành</option>
                                        <option value="3">Hoàn thành trễ hạn</option>
                                    </select>
                                </div>
                            </div>
                             <div class="col-sm-5 col-xs-12">
                                <div class="form-group">
                                    <label for="txt-search" style="width:100%">&nbsp;</label>
                                    <div class="input-group">
                                        <input onkeypress="enterSearch(event);" id="txt-search" type="text" class="form-control" placeholder="Tìm kiếm">
                                        <div class="input-group-append">
                                            <button id="btn-search" onclick="search();" class="btn btn-primary" type="button">
                                                <i class="fa fa-search"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-sm-12">
                                <table id="bs-table"
                                       data-mobile-responsive="true"
                                       data-check-on-init="true"
                                       data-columns-hidden="['GhiChu']"
                                       data-toggle="table"
                                       data-toolbar="#get"
                                       data-url="/GiaoViecTuGiaoCanXuLy/GetListCongViecTuGiaoCanXuLy"
                                       data-pagination="true"
                                       data-side-pagination="server"
                                       data-page-size="30"
                                       data-page-list="[30, 50, 100, 200]"
                                       data-locale="vi-VN"
                                       data-query-params="queryParams"
                                       data-row-attributes="rowAttributes"
                                       data-sort-name="NgayTao"
                                       data-sort-order="desc">
                                    <thead>
                                        <tr>
                                            <th data-field="TenCongViec">Tên công việc</th>
                                            <th data-field="NoiDung">Nội dung</th>
                                            <th data-field="HanXuLyStr" data-formatter="hanXulyFormatter">Hạn xử lý</th>
                                            <th data-field="GhiChu" data-formatter="ghiChuFormatter">Ghi chú</th>
                                            <th data-field="NgayTaoStr">Ngày giao</th>
                                            <th data-field="IsHoanThanh" data-formatter="tiendoFormatter">Tiến độ</th>
                                            <th class="width-20-per" data-field="operate" data-formatter="operateFormatter" data-events="operateEvents">&nbsp;</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    function rowAttributes(row, index) {
        return {
            'data-id': row.Id
        };
    }

    function operateFormatter(value, row, index) {
        var btnSua = `<a href="/GiaoViec/Form?id=${row.GiaoViecId}" class='btn btn-warning btn-sm m-l-5 m-r-5 m-t-5 m-b-5'><i class='fa fa-edit'></i> Sửa</a>`;
        
        var btnXoa = `<button id='btn-delete-item' class='btn btn-danger btn-sm m-l-5 m-r-5 m-t-5 m-b-5'><i class='fa fa-trash'></i> Xóa</button>`;

        if (row.IsHoanThanh) {
            var btnXemThongTin = ``;
            return btnSua + btnXemThongTin + btnXoa;
        }

        var btnXuLy = `<a href="/GiaoViecCanXuLy/Form?id=${row.Id}&giaoViecId=${row.GiaoViecId}" class='btn btn-primary btn-sm m-l-5 m-r-5 m-t-5 m-b-5'><i class='fa fa-send'></i> Xử lý</a>`;
        return btnSua + btnXuLy + btnXoa;
    }

    function tiendoFormatter(value, row, index) {
        if (row.IsHoanThanh) {
            return `<span class="badge bg-success">Đã hoàn thành</span>`;
        }
        if (row.SoNgayConLai >= 0) {
            return `<span class="badge bg-warning">Chưa hoàn thành</span>`;
        }
        return `<span class="badge bg-danger">Trễ hạn</span>`;
    }

    function hanXulyFormatter(value, row, index) {
        var hanXuLyStr = row.HanXuLyStr || '';
        if (row.IsHoanThanh) {
            return `<span class="text-success text-bold">✅ Đã hoàn thành</span> - Hạn xử lý: <b>${hanXuLyStr}</b>`;
        }
        if (row.SoNgayConLai >= 0) {
            return `<span class="text-warning text-bold">⏳ Chưa hoàn thành</span> - Hạn xử lý: <b>${hanXuLyStr}</b> (Còn lại ${row.SoNgayConLai} ngày)`;
        }
        return `<span class="text-danger text-bold">❌ Trễ hạn</span> - Hạn xử lý: <b>${hanXuLyStr}</b> (Trễ ${Math.abs(row.SoNgayConLai)} ngày)`;
    }

    function ghiChuFormatter(value, row, index) {
        var ghiChu = (value || '').toString().trim();
        var parts = [];

        if (row.NguoiChuyenGiao && row.NguoiChuyenGiao.toString().trim() !== '') {
            parts.push(`<b>- Người chuyển giao:</b> ${row.NguoiChuyenGiao}`);
        }

        if (row.NguoiThucHien && row.NguoiThucHien.toString().trim() !== '') {
            parts.push(`<b>- Người thực hiện:</b> ${row.NguoiThucHien}`);
        }

        if (ghiChu !== '') {
            if (parts.length > 0) {
                parts.push(`<b>- Ghi chú:</b> ${ghiChu}`);
            } else {
                return ghiChu;
            }
        }

        return parts.join('<br/>');
    }

    window.operateEvents = {
        'click #btn-delete-item': function (e, value, row, index) {
            if (confirm("Bạn muốn xoá công việc này?") == true) {
                showLoadingModal();

                var fd = new FormData();
                fd.append("giaoViecId", row.GiaoViecId);

                ajaxPostFormData("/GiaoViecTuGiaoCanXuLy/Xoa", fd, function funcCallback(data) {
                    hideLoadingModal();
                    if (!data) {
                        toastr.error("Không thể xoá công việc này.");
                        return;
                    }
                    toastr.success("Xoá thành công.");
                    search();
                }, function funcError() {
                    hideLoadingModal();
                    toastr.error("Đã có lỗi xảy ra. Vui lòng tải lại trang.");
                })
            }
        }
    }

    function queryParams(params) {
        params.search = btoa(unescape(encodeURIComponent($("#txt-search").val())));
        params.DaXoaSearch = $('#DaXoaSearch').is(":checked");
        params.TuNgayStr = $("#TuNgayStr").val();
        params.DenNgayStr = $("#DenNgayStr").val();
        params.TrangThaiSearch = $("#TrangThaiSearch").val();
        return params;
    };

    function search() {
        $('#bs-table').bootstrapTable('refresh');
    };

    function enterSearch(e) {
        if (e.keyCode === 13) {
            $('#bs-table').bootstrapTable('refresh');
        };
    };

    document.addEventListener('DOMContentLoaded', function () {
        $("#TrangThaiSearch").change(function () {
            search();
        });
    });
</script>
