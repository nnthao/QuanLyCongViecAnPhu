@using Dashboard.HtmlHelpers;
@using Dashboard.Models.HtmlHelpers
@using Dashboard.Models.HtmlHelpers.Input
@{
    var action = Model != 0 ? "Cập nhật" : "Thêm";
    ViewBag.Title = action + " hình thức văn bản";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model int

<style>
    .tbVaiTroGrid th, .tbVaiTroGrid td {
        padding: 5px 10px;
    }
</style>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card card-primary">
                    <div class="card-header">
                        <div class="card-title">
                            <b>@ViewBag.Title </b>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <input id="Id" value="@Model" type="hidden" />
                            @Html.CustomTextBox(id: "Ten", label: "Tên", col: 6, required: true, length: 500)
                        </div>

                        <div class="row">
                            <div class="col-sm-12">
                                <div class="modal-footer text-center d-block">
                                    <button id="btn-loading" type="button" class="btn btn-default invisible" data-dismiss="modal">
                                        <img src="~/Content/img/loading.gif" height="25" />
                                    </button>
                                    <a class="btn btn-light mr-2" href="/HinhThucVanBan"><i class="fa fa-chevron-left"></i> Quay lại</a>
                                    <button onclick="addOrUpdate()" class="btn btn-success"><i class="fa fa-save"></i> @action</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
<script>
    function loadData() {
         showLoadingModal();
             $.get("/HinhThucVanBan/GetById?id=" + @Model, function (res) {
                 if (res.Item) {
                     $("#Ten").val(res.Item.Ten);
                 }
                 hideLoadingModal();
              })
    }

    function addOrUpdate() {
        showLoadingModal();
        $.post("/HinhThucVanBan/ThemOrCapNhat", {
            Id: $("#Id").val(),
            Ten: $("#Ten").val(),
        }, function (data) {
            hideLoadingModal();
            if (data.Errors && data.Errors.length > 0) {
                data.Errors.map((item) => {
                    var idError = "#" + item.Name;
                    $(idError).show();
                    $(idError).text(item.Description);

                    return "";
                });
            }
            else {
                window.location.href="/HinhThucVanBan";
            }
        })
    }

    document.addEventListener('DOMContentLoaded', function () {
        loadData();
    });
</script>