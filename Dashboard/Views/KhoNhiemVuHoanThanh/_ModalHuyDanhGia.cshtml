@using Dashboard.HtmlHelpers;
@using Dashboard.Models.HtmlHelpers;

<div class="modal fade" id="modalHuyDanhGia" tabindex="-1" role="dialog" aria-labelledby="modalHuyDanhGiaTitle" aria-hidden="true">
    <div class="modal-dialog modal-md" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalHuyDanhGiaTitle"><b>Huỷ đánh giá nhiệm vụ</b></h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="HuyDanhGia_GiaoViecThanhVienId" value="0" />

                <div class="row">
                    <div class="col-sm-12 col-xs-12">
                        <p class="mb-1">Tên công việc: <b id="HuyDanhGia_TenCongViec"></b></p>
                        <p class="mb-1">Người thực hiện: <b id="HuyDanhGia_ThanhVien"></b></p>
                        <p class="mb-1">Người đánh giá: <b id="HuyDanhGia_NguoiDanhGia"></b></p>
                        <p class="mb-3">Ngày đánh giá: <b id="HuyDanhGia_NgayDanhGia"></b></p>
                    </div>
                </div>

                <div class="row">
                    <div class="col-sm-12 col-xs-12">
                        <div class="txt-middle-line"><span><b>Xác nhận huỷ đánh giá</b></span></div>
                    </div>
                    <div class="col-sm-12 col-xs-12">
                        <div class="form-group">
                            <label for="HuyDanhGia_LyDoHuy">Lý do huỷ (nếu có)</label>
                            <textarea id="HuyDanhGia_LyDoHuy" class="form-control" rows="3" placeholder="Nhập lý do huỷ đánh giá để thực hiện đánh giá lại..."></textarea>
                        </div>
                        <div class="alert alert-warning mb-0 p-2">
                            <small><i class="fa fa-info-circle"></i> Khi huỷ đánh giá, nhiệm vụ sẽ được chuyển về trạng thái <b>Chờ đánh giá</b> để người giao/theo dõi thực hiện đánh giá lại.</small>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-dismiss="modal">
                    <i class="fa fa-times"></i> Đóng
                </button>
                <button type="button" onclick="xacNhanHuyDanhGia()" class="btn btn-warning" id="btnThucHienHuy">
                    <i class="fa fa-undo"></i> Huỷ đánh giá
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    function openModalHuyDanhGia(id, tenCongViec, thanhVien, nguoiDanhGia, ngayDanhGia) {
        $("#HuyDanhGia_GiaoViecThanhVienId").val(id);
        $("#HuyDanhGia_TenCongViec").text(tenCongViec || '');
        $("#HuyDanhGia_ThanhVien").text(thanhVien || '');
        $("#HuyDanhGia_NguoiDanhGia").text(nguoiDanhGia || '');
        $("#HuyDanhGia_NgayDanhGia").text(ngayDanhGia || '');
        $("#HuyDanhGia_LyDoHuy").val('');
        $("#modalHuyDanhGia").modal("show");
    }

    function xacNhanHuyDanhGia() {
        var id = $("#HuyDanhGia_GiaoViecThanhVienId").val();
        var lyDo = $("#HuyDanhGia_LyDoHuy").val();

        var fd = new FormData();
        fd.append("GiaoViecThanhVienId", id);
        fd.append("LyDoHuy", lyDo);

        showLoadingModal();
        ajaxPostFormData("/KhoNhiemVuHoanThanh/HuyDanhGia", fd, function (data) {
            hideLoadingModal();
            if (data && data.Errors && data.Errors.length > 0) {
                var errorMsg = data.Errors.map(function (e) { return e.Description; }).join("<br/>");
                toastr.error(errorMsg);
            } else {
                toastr.success("Huỷ đánh giá thành công. Nhiệm vụ đã được chuyển về Chờ đánh giá.");
                $("#modalHuyDanhGia").modal("hide");
                search();
            }
        }, function () {
            hideLoadingModal();
            toastr.error("Đã có lỗi xảy ra. Vui lòng thử lại.");
        });
    }
</script>

