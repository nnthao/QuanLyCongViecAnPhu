@using Dashboard.HtmlHelpers;
@using Dashboard.Models.HtmlHelpers
@using System.Configuration;
@using Dashboard.Common;


<div class="row">
    <div class="col-sm-12 p-t-15 tb-height-auto">
        <table id="bsTaiLieuCuocHop"
               data-locale="vi-VN">
            <thead>
                <tr>
                    <th data-field="Name">Tài liệu</th>
                    <th data-width="200" data-align="center" data-field="operate"
                        data-formatter="actionTaiLieuCuocHop">&nbsp;</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
<script type="text/javascript">
    function actionTaiLieuCuocHop(value, row, index) {
        // Chỉ hiển thị nút Tải xuống nếu file đã lưu trên server (có DuongDan)
        if (row.DuongDan) {
            let downloadBtn =
                `<button onclick="downloadFromLink('${row.DuongDan}', '${row.Name}')" class='btn btn-primary btn-sm m-l-5 m-r-5 m-t-5 m-b-5'>
                    <i class='fa fa-download'></i> Tải xuống</button>`;
            return downloadBtn;
        }
        return '';
    }
</script>
