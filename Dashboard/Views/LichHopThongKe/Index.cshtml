@using Dashboard.HtmlHelpers;
@using Dashboard.Models.HtmlHelpers
@using Dashboard.Common;
@using Dashboard.Models.ViewModel;
@using Dashboard.Models.Entities;
@using System.Linq;
@using System.Security.Claims;
@{
    ViewBag.Title = "Thống kê lịch";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var dauThang = Dashboard.Common.DateTimeHelper.NgayDauThang(DateTime.Now).ToString("dd/MM/yyyy");
    var cuoiThang = Dashboard.Common.DateTimeHelper.NgayCuoiThang(DateTime.Now).ToString("dd/MM/yyyy");

    var phongBanCurrentId = UserClaimHelper.GetPhongBanId((ClaimsIdentity)User.Identity);
    var phongBanCache = CacheManagerHelper.GetPhongBanCache().Where(pb => pb.IsDeleted != true).ToList();
    var phongBanList = new List<PhongBanGridVo>();

    if (phongBanCurrentId != 0)
    {
        var phongBanCurrent = phongBanCache.FirstOrDefault(pb => pb.Id == phongBanCurrentId);
        if (phongBanCurrent != null)
        {
            phongBanList.Add(phongBanCurrent);
        }

        var phongBanChildrenLookups = UltiHelper.GetPhongBanChildrenSorted(phongBanCurrentId);
        foreach (var lookup in phongBanChildrenLookups)
        {
            var child = phongBanCache.FirstOrDefault(pb => pb.Id == lookup.id);
            if (child != null)
            {
                phongBanList.Add(child);
            }
        }
    }

    if (phongBanList.Count == 0)
    {
        phongBanList = UltiHelper.GetPhongBanTreeSorted(0);
    }

    var phongBanIds = phongBanList.Select(pb => pb.Id).ToList();
    var phongBanIdsStr = string.Join(",", phongBanIds);

    var lyDoCache = CacheManagerHelper.GetLyDoCache().Where(ld => ld.IsDeleted != true).OrderBy(ld => ld.Ten).ToList();
    var lyDoIds = lyDoCache.Select(ld => ld.Id).ToList();
    var lyDoIdsStr = string.Join(",", lyDoIds);
}

@model ParamControllerToView

<style>
    .multi-select-container {
        position: relative;
        width: 100%;
    }

    .multi-select-dropdown {
        position: relative;
        border: 1px solid #ced4da;
        border-radius: .25rem;
        background: #fff;
        min-height: calc(2.25rem + 2px);
    }

    .multi-select-header {
        min-height: calc(2.25rem + 2px);
        padding: .375rem .75rem;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: transparent;
    }

    .multi-select-header:hover {
        background: #f8f9fa;
    }

    .multi-select-dropdown.open .multi-select-header {
        border-bottom: 1px solid #ced4da;
        border-bottom-left-radius: 0;
        border-bottom-right-radius: 0;
    }

    .multi-select-placeholder {
        color: #495057;
        font-size: 14px;
        line-height: 1.5;
    }

    .multi-select-arrow {
        font-size: 12px;
        color: #495057;
        transition: transform 0.3s ease;
        margin-left: 8px;
    }

    .multi-select-dropdown.open .multi-select-arrow {
        transform: rotate(180deg);
    }

    .multi-select-content {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: white;
        border: 1px solid #ced4da;
        border-top: none;
        border-radius: 0 0 4px 4px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        z-index: 1000;
        max-height: 300px;
        overflow: hidden;
    }

    .multi-select-dropdown.open .multi-select-content {
        display: block;
    }

    .multi-select-search {
        padding: 8px;
        border-bottom: 1px solid #eee;
        position: relative;
    }

    .multi-select-search input {
        width: 100%;
        padding: 6px 30px 6px 30px;
        border: 1px solid #ddd;
        border-radius: 4px;
        font-size: 14px;
        outline: none;
    }

    .search-icon {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #666;
        font-size: 14px;
    }

    .clear-search {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #666;
        cursor: pointer;
        font-size: 14px;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: #ccc;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .clear-search:hover {
        background: #999;
        color: #fff;
    }

    .multi-select-options {
        max-height: 220px;
        overflow-y: auto;
    }

    .multi-select-option {
        display: block;
        padding: 8px 12px;
        cursor: pointer;
        border-bottom: 1px solid #f0f0f0;
        margin: 0;
        font-size: 14px;
    }

    .multi-select-option:last-child {
        border-bottom: none;
    }

    .multi-select-option:hover {
        background: #f8f9fa;
    }

    .multi-select-option input[type="checkbox"] {
        margin-right: 8px;
        transform: scale(1.1);
    }
</style>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="card card-primary" style="width:100%">
                <div class="card-header">
                    <div class="card-title">
                        <b>@ViewBag.Title</b>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        @Html.CustomDatePicker(id: "TuNgayStr", label: "Từ ngày", col: 2, required: true, moreClass: "col-sm-4 col-xs-12", value: dauThang)
                        @Html.CustomDatePicker(id: "DenNgayStr", label: "Đến ngày", col: 2, required: true, moreClass: "col-sm-4 col-xs-12", value: cuoiThang)
                        <div class="col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>Chọn phòng ban</label>
                                <div class="multi-select-container">
                                    <div class="multi-select-dropdown" id="phongBanMultiSelect">
                                        <div class="multi-select-header" onclick="toggleDropdown()">
                                            <span class="multi-select-placeholder">--- Chọn một phòng ban ---</span>
                                            <span class="multi-select-arrow">▼</span>
                                        </div>
                                        <div class="multi-select-content" id="multiSelectContent">
                                            <div class="multi-select-search">
                                                <input type="text" placeholder="Tìm kiếm" id="multiSelectSearch" onkeyup="filterOptions()">
                                                <span class="search-icon">🔍</span>
                                                <span class="clear-search" onclick="clearSearch()">✕</span>
                                            </div>
                                            <div class="multi-select-options" id="multiSelectOptions">
                                                <label class="multi-select-option">
                                                    <input type="checkbox" value="all" onchange="toggleAll()">
                                                    <span><b>Lựa chọn tất cả phòng ban</b></span>
                                                </label>
                                                @foreach (var phongBan in phongBanList)
                                                {
                                                    <label class="multi-select-option">
                                                        <input type="checkbox" value="@phongBan.Id">
                                                        <span>@phongBan.Ten</span>
                                                    </label>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                        </div>
           
                        <div class="col-sm-2 col-xs-12">
                            <div class="form-group">
                                <label>Chọn lý do</label>
                                <div class="multi-select-container">
                                    <div class="multi-select-dropdown" id="lyDoMultiSelect">
                                        <div class="multi-select-header" onclick="toggleDropdownLyDo()">
                                            <span class="multi-select-placeholder">--- Chọn một lý do ---</span>
                                            <span class="multi-select-arrow">▼</span>
                                        </div>
                                        <div class="multi-select-content" id="multiSelectContentLyDo">
                                            <div class="multi-select-search">
                                                <input type="text" placeholder="Tìm kiếm" id="multiSelectSearchLyDo" onkeyup="filterOptionsLyDo()">
                                                <span class="search-icon">🔍</span>
                                                <span class="clear-search" onclick="clearSearchLyDo()">✕</span>
                                            </div>
                                            <div class="multi-select-options" id="multiSelectOptionsLyDo">
                                                <label class="multi-select-option">
                                                    <input type="checkbox" value="all" onchange="toggleAllLyDo()">
                                                    <span><b>Lựa chọn tất cả lý do</b></span>
                                                </label>
                                                @foreach (var lyDo in lyDoCache)
                                                {
                                                    <label class="multi-select-option">
                                                        <input type="checkbox" value="@lyDo.Id">
                                                        <span>@lyDo.Ten</span>
                                                    </label>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2 col-sm-4 col-xs-12">
                            <div class="form-group">
                                <label>
                                    &nbsp;
                                </label>
                                <div class="input-group">
                                    <button onclick="thongKe();" class="btn btn-primary"><i class="fa fa-check"></i> Thống kê</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-6 col-md-12">
                            <div class="card card-outline card-primary h-100">
                                <div class="card-header">
                                    <h5 class="card-title mb-0">Biểu đồ lý do cuộc họp</h5>
                                </div>
                                <div class="card-body">
                                    <div class="chart-container" style="position: relative; height: 360px;">
                                        <canvas id="thongKeLyDoChart"></canvas>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6 col-md-12">
                            <div class="card card-outline card-success h-100">
                                <div class="card-header">
                                    <h5 class="card-title mb-0">Top 5 người có nhiều lý do</h5>
                                </div>
                                <div class="card-body">
                                    <ul class="list-group list-group-flush" id="topNguoiList">
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-12">
                            <div class="card card-outline card-secondary">
                                <div class="card-header d-flex align-items-center justify-content-between">
                                    <h5 class="card-title mb-0">Danh sách chi tiết</h5>
                                </div>
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table id="bs-table-chi-tiet"
                                               data-toggle="table"
                                               data-url="/LichHopThongKe/GetChiTietLyDoCuocHop"
                                               data-pagination="true"
                                               data-side-pagination="server"
                                               data-page-size="30"
                                               data-page-list="[30, 50, 100, 200]"
                                               data-locale="vi-VN"
                                               data-query-params="queryParamsChiTiet"
                                               data-sort-name="ThoiGianBatDau"
                                               data-sort-order="asc">
                                            <thead>
                                                <tr>
                                                    <th data-formatter="sttFormatter" data-align="center">STT</th>
                                                    <th data-field="TenPhongBan" data-sortable="true">Phòng</th>
                                                    <th data-field="TenNguoi" data-sortable="true">Tên người</th>
                                                    <th data-field="ThoiGianBatDauStr" data-align="center" data-sortable="true">Thời gian</th>
                                                    <th data-field="TenLyDo" data-sortable="true">Lý do</th>
                                                </tr>
                                            </thead>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    const valueLabelsPlugin = {
        id: 'valueLabelsPlugin',
        afterDatasetsDraw(chart, args, pluginOptions) {
            const { ctx, data, chartArea } = chart;
            if (!data || !data.datasets || !chartArea) return;

            ctx.save();
            ctx.font = (pluginOptions && pluginOptions.font) ? pluginOptions.font : '12px sans-serif';
            ctx.fillStyle = (pluginOptions && pluginOptions.color) ? pluginOptions.color : '#ffffff';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';

            const type = chart.config.type;

            if (type === 'bar') {
                data.datasets.forEach((dataset, datasetIndex) => {
                    const meta = chart.getDatasetMeta(datasetIndex);
                    if (!meta || meta.hidden) return;
                    meta.data.forEach((element, index) => {
                        const raw = dataset.data[index];
                        const value = typeof raw === 'number' ? raw : (raw && raw.y != null ? raw.y : null);
                        if (value == null || value === 0) return;

                        const x = element.x;
                        const y = element.y;
                        const height = element.height;

                        const centerX = x;
                        const centerY = y - (height / 2);

                        ctx.shadowColor = 'rgba(0, 0, 0, 0.5)';
                        ctx.shadowBlur = 2;
                        ctx.shadowOffsetX = 1;
                        ctx.shadowOffsetY = 1;

                        ctx.fillStyle = '#ffffff';
                        ctx.font = 'bold 12px Arial';

                        ctx.fillText(value, centerX, centerY);

                        ctx.shadowColor = 'transparent';
                        ctx.shadowBlur = 0;
                        ctx.shadowOffsetX = 0;
                        ctx.shadowOffsetY = 0;
                    });
                });
            }

            ctx.restore();
        }
    };

    let isDropdownOpen = false;
    let isDropdownLyDoOpen = false;
    const allPhongBanIds = '@phongBanIdsStr'.split(',').filter(id => id !== '');
    const allLyDoIds = '@lyDoIdsStr'.split(',').filter(id => id !== '');

    function toggleDropdown() {
        const dropdown = document.getElementById('phongBanMultiSelect');
        const content = document.getElementById('multiSelectContent');

        isDropdownOpen = !isDropdownOpen;
        if (isDropdownOpen) {
            dropdown.classList.add('open');
            content.style.display = 'block';
        } else {
            dropdown.classList.remove('open');
            content.style.display = 'none';
        }
    }

    function toggleDropdownLyDo() {
        const dropdown = document.getElementById('lyDoMultiSelect');
        const content = document.getElementById('multiSelectContentLyDo');

        isDropdownLyDoOpen = !isDropdownLyDoOpen;
        if (isDropdownLyDoOpen) {
            dropdown.classList.add('open');
            content.style.display = 'block';
        } else {
            dropdown.classList.remove('open');
            content.style.display = 'none';
        }
    }

    function filterOptions() {
        const searchTerm = document.getElementById('multiSelectSearch').value.toLowerCase();
        const options = document.querySelectorAll('#multiSelectOptions .multi-select-option');
        options.forEach(option => {
            const text = option.querySelector('span').textContent.toLowerCase();
            option.style.display = text.includes(searchTerm) ? 'block' : 'none';
        });
    }

    function clearSearch() {
        document.getElementById('multiSelectSearch').value = '';
        filterOptions();
    }

    function toggleAll() {
        const selectAllCheckbox = document.querySelector('#multiSelectOptions input[value="all"]');
        const otherCheckboxes = document.querySelectorAll('#multiSelectOptions input[type="checkbox"]:not([value="all"])');
        otherCheckboxes.forEach(checkbox => {
            checkbox.checked = selectAllCheckbox.checked;
        });
        updatePlaceholder();
    }

    function updatePlaceholder() {
        const placeholder = document.querySelector('#phongBanMultiSelect .multi-select-placeholder');
        const selectedCheckboxes = document.querySelectorAll('#multiSelectOptions input[type="checkbox"]:not([value="all"]):checked');

        if (selectedCheckboxes.length === 0) {
            placeholder.textContent = '--- Chọn một phòng ban ---';
        } else if (selectedCheckboxes.length === 1) {
            placeholder.textContent = selectedCheckboxes[0].parentElement.querySelector('span').textContent;
        } else {
            placeholder.textContent = `Đã chọn ${selectedCheckboxes.length} phòng ban`;
        }
    }

    function getSelectedPhongBanIds() {
        const selectedCheckboxes = document.querySelectorAll('#multiSelectOptions input[type="checkbox"]:not([value="all"]):checked');
        if (selectedCheckboxes.length === 0) {
            return allPhongBanIds;
        }
        return Array.from(selectedCheckboxes).map(checkbox => checkbox.value);
    }

    function filterOptionsLyDo() {
        const searchTerm = document.getElementById('multiSelectSearchLyDo').value.toLowerCase();
        const options = document.querySelectorAll('#multiSelectOptionsLyDo .multi-select-option');
        options.forEach(option => {
            const text = option.querySelector('span').textContent.toLowerCase();
            option.style.display = text.includes(searchTerm) ? 'block' : 'none';
        });
    }

    function clearSearchLyDo() {
        document.getElementById('multiSelectSearchLyDo').value = '';
        filterOptionsLyDo();
    }

    function toggleAllLyDo() {
        const selectAllCheckbox = document.querySelector('#multiSelectOptionsLyDo input[value="all"]');
        const otherCheckboxes = document.querySelectorAll('#multiSelectOptionsLyDo input[type="checkbox"]:not([value="all"])');
        otherCheckboxes.forEach(checkbox => {
            checkbox.checked = selectAllCheckbox.checked;
        });
        updatePlaceholderLyDo();
    }

    function updatePlaceholderLyDo() {
        const placeholder = document.querySelector('#lyDoMultiSelect .multi-select-placeholder');
        const selectedCheckboxes = document.querySelectorAll('#multiSelectOptionsLyDo input[type="checkbox"]:not([value="all"]):checked');

        if (selectedCheckboxes.length === 0) {
            placeholder.textContent = '--- Chọn một lý do ---';
        } else if (selectedCheckboxes.length === 1) {
            placeholder.textContent = selectedCheckboxes[0].parentElement.querySelector('span').textContent;
        } else {
            placeholder.textContent = `Đã chọn ${selectedCheckboxes.length} lý do`;
        }
    }

    function getSelectedLyDoIds() {
        const selectedCheckboxes = document.querySelectorAll('#multiSelectOptionsLyDo input[type="checkbox"]:not([value="all"]):checked');
        if (selectedCheckboxes.length === 0) {
            return allLyDoIds;
        }
        return Array.from(selectedCheckboxes).map(checkbox => checkbox.value);
    }

    document.addEventListener('click', function (event) {
        const dropdown = document.getElementById('phongBanMultiSelect');
        if (dropdown && !dropdown.contains(event.target) && isDropdownOpen) {
            toggleDropdown();
        }

        const dropdownLyDo = document.getElementById('lyDoMultiSelect');
        if (dropdownLyDo && !dropdownLyDo.contains(event.target) && isDropdownLyDoOpen) {
            toggleDropdownLyDo();
        }
    });

    document.addEventListener('DOMContentLoaded', function () {
        const phongBanCheckboxes = document.querySelectorAll('#multiSelectOptions input[type="checkbox"]:not([value="all"])');
        phongBanCheckboxes.forEach(checkbox => {
            checkbox.addEventListener('change', updatePlaceholder);
        });
        updatePlaceholder();

        const lyDoCheckboxes = document.querySelectorAll('#multiSelectOptionsLyDo input[type="checkbox"]:not([value="all"])');
        lyDoCheckboxes.forEach(checkbox => {
            checkbox.addEventListener('change', updatePlaceholderLyDo);
        });
        updatePlaceholderLyDo();
    });

    function thongKe() {
        loadThongKeData();
    }

    function loadThongKeData() {
        $("#TuNgayStrError").empty();
        $("#DenNgayStrError").empty();

        showLoadingModal();

        var fd = new FormData();
        fd.append("TuNgayStr", $("#TuNgayStr").val());
        fd.append("DenNgayStr", $("#DenNgayStr").val());
        var phongBanIds = getSelectedPhongBanIds();
        if (phongBanIds.length > 0) {
            fd.append("PhongBanIdsStr", phongBanIds.join(','));
        }
        var lyDoIds = getSelectedLyDoIds();
        if (lyDoIds.length > 0) {
            fd.append("LyDoIdsStr", lyDoIds.join(','));
        }

        ajaxPostFormData("/LichHopThongKe/GetThongKeLyDoCuocHop", fd, function funcCallback(response) {
            hideLoadingModal();
            if (response.Errors && response.Errors.length > 0) {
                response.Errors.map((item) => {
                    var idError = "#" + item.Id + "Error";
                    $(idError).show();
                    $(idError).text(item.Description);
                    return "";
                });
            } else if (response.success) {
                renderChart(response.data);
                renderTopNguoiList(response.top10Nguoi);
                refreshChiTietTable();
            }
        }, function funcError() {
            hideLoadingModal();
            toastr.error("Đã có lỗi xảy ra. Vui lòng tải lại trang.");
        })
    }

    function renderChart(data) {
        var ctx = document.getElementById('thongKeLyDoChart').getContext('2d');

        if (window.thongKeLyDoChart && typeof window.thongKeLyDoChart.destroy === 'function') {
            window.thongKeLyDoChart.destroy();
        }

        var backgroundColors = data.MaMauData.map(function (mau) {
            if (!mau || mau === '') {
                return 'rgba(128, 128, 128, 0.8)';
            }
            var rgb = hexToRgb(mau);
            if (rgb) {
                return `rgba(${rgb.r}, ${rgb.g}, ${rgb.b}, 0.8)`;
            }
            return 'rgba(128, 128, 128, 0.8)';
        });

        var borderColors = data.MaMauData.map(function (mau) {
            if (!mau || mau === '') {
                return 'rgba(128, 128, 128, 1)';
            }
            var rgb = hexToRgb(mau);
            if (rgb) {
                return `rgba(${rgb.r}, ${rgb.g}, ${rgb.b}, 1)`;
            }
            return 'rgba(128, 128, 128, 1)';
        });

        window.thongKeLyDoChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: data.Labels,
                datasets: [
                    {
                        label: 'Số lượng cuộc họp',
                        data: data.SoLuongData,
                        backgroundColor: backgroundColors,
                        borderColor: borderColors,
                        borderWidth: 1
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    x: {
                        title: {
                            display: true,
                            text: 'Lý do'
                        }
                    },
                    y: {
                        beginAtZero: true,
                        ticks: {
                            stepSize: 1,
                            callback: function (value) {
                                return Number.isInteger(value) ? value : null;
                            }
                        },
                        title: {
                            display: true,
                            text: 'Số lượng'
                        }
                    }
                },
                plugins: {
                    title: {
                        display: true,
                        text: 'Thống kê các loại lý do'
                    },
                    legend: {
                        display: false
                    },
                    tooltip: {
                        callbacks: {
                            label: function (context) {
                                return 'Số lượng: ' + context.parsed.y;
                            }
                        }
                    }
                }
            },
            plugins: [valueLabelsPlugin]
        });
    }

    function renderTopNguoiList(data) {
        var list = $('#topNguoiList');
        list.empty();

        if (!data || data.length === 0) {
            list.append('<li class="list-group-item text-center text-muted">Không có dữ liệu</li>');
            return;
        }

        data.slice(0, 5).forEach(function (item, index) {
            var tenNguoi = item.TenNguoi || 'Không xác định';
            var soLuong = item.SoLuong || 0;
            var badgeClass = index === 0 ? 'badge badge-danger' : 'badge badge-primary';
            var itemHtml = '<li class="list-group-item d-flex justify-content-between align-items-center">' +
                '<div>' +
                '<span class="font-weight-bold mr-2">' + (index + 1) + '.</span>' +
                '<span>' + tenNguoi + '</span>' +
                '</div>' +
                '<span class="' + badgeClass + '">' + soLuong + '</span>' +
                '</li>';
            list.append(itemHtml);
        });
    }

    function queryParamsChiTiet(params) {
        params.TuNgayStr = $("#TuNgayStr").val();
        params.DenNgayStr = $("#DenNgayStr").val();
        params.PhongBanIdsStr = getSelectedPhongBanIds().join(',');
        params.LyDoIdsStr = getSelectedLyDoIds().join(',');
        return params;
    }

    function refreshChiTietTable() {
        $('#bs-table-chi-tiet').bootstrapTable('refresh');
    }

    function hexToRgb(hex) {
        var result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
        return result ? {
            r: parseInt(result[1], 16),
            g: parseInt(result[2], 16),
            b: parseInt(result[3], 16)
        } : null;
    }

    document.addEventListener("DOMContentLoaded", function () {
        loadThongKeData();
    })

    function sttFormatter(value, row, index) {
        const tableOptions = $('#bs-table-chi-tiet').bootstrapTable('getOptions');
        const pageNumber = tableOptions.pageNumber || 1;
        const pageSize = tableOptions.pageSize || 10;
        return (pageNumber - 1) * pageSize + index + 1;
    }
</script>

