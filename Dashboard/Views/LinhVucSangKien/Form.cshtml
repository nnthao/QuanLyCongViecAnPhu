@using Dashboard.HtmlHelpers;
@using Dashboard.Models.HtmlHelpers
@using Dashboard.Models.HtmlHelpers.Input
@{
    var action = Model != 0 ? "Cập nhật" : "Thêm";
    ViewBag.Title = action + " lĩnh vực sáng kiến";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model int

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card card-primary">
                    <div class="card-header">
                        <div class="card-title">
                            <b>@ViewBag.Title </b>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <input id="Id" value="@Model" type="hidden" />
                            @Html.CustomTextBox(id: "TenLinhVuc", label: "Tên lĩnh vực", col: 12, required: true, length: 500)
                        </div>

                        <div class="row">
                            <div class="col-sm-12">
                                <div class="modal-footer text-center d-block">
                                    <button id="btn-loading" type="button" class="btn btn-default invisible" data-dismiss="modal">
                                        <img src="~/Content/img/loading.gif" height="25" />
                                    </button>
                                    <a class="btn btn-light mr-2" href="/LinhVucSangKien"><i class="fa fa-chevron-left"></i> Quay lại</a>
                                    <button onclick="addOrUpdate()" class="btn btn-success"><i class="fa fa-save"></i> @action</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
<script>
    function loadData() {
        if (@Model > 0) {
            showLoadingModal();
            $.get("/LinhVucSangKien/GetById?id=" + @Model, function (res) {
                if (res.Item) {
                    setTimeout(function () {
                        $("#TenLinhVuc").val(res.Item.TenLinhVuc);
                    }, 200);
                }
                hideLoadingModal();
            }).fail(function () {
                hideLoadingModal();
                toastr.error("Đã có lỗi xảy ra khi tải dữ liệu.");
            });
        }
    }

    function addOrUpdate() {
        showLoadingModal();
        $.post("/LinhVucSangKien/ThemOrCapNhat", {
            Id: $("#Id").val(),
            TenLinhVuc: $("#TenLinhVuc").val(),
        }, function (data) {
            hideLoadingModal();
            if (data.Errors && data.Errors.length > 0) {
                data.Errors.map((item) => {
                    var idError = "#" + item.Name;
                    $(idError).show();
                    $(idError).text(item.Description);

                    return "";
                });
            }
            else {
                window.location.href="/LinhVucSangKien";
            }
        })
    }

    document.addEventListener('DOMContentLoaded', function () {
        loadData();
    });
</script>

