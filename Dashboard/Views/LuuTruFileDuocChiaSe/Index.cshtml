@using Dashboard.Common
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var drivePageUrl = ViewBag.DrivePageUrl as string ?? "/LuuTruFile";
    var driveApiBaseUrl = ViewBag.DriveApiBaseUrl as string ?? "/LuuTruFile";
}

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card card-primary">
                    <div class="card-header">
                        <div class="card-title">
                            <b>@ViewBag.Title</b>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row mb-2">
                            <div class="col-md-12">
                                <nav aria-label="breadcrumb">
                                    <ol class="breadcrumb" id="breadcrumb-nav"></ol>
                                </nav>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <div class="input-group">
                                    <input type="text" id="drive-search-keyword" class="form-control" placeholder="Tìm thư mục, file trong thư mục hiện tại" />
                                    <div class="input-group-append">
                                        <button id="btn-search-drive" type="button" class="btn btn-primary">
                                            <i class="fa fa-search"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover">
                                <thead>
                                    <tr>
                                        <th>Tên</th>
                                        <th>Chủ sở hữu</th>
                                        <th>Ngày tạo</th>
                                        <th>Kích cỡ tệp</th>
                                        <th style="width:200px">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody id="drive-body"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    var drivePageUrl = '@drivePageUrl';
    var driveApiBaseUrl = '@driveApiBaseUrl';
    var currentFolderId = null;
    var allowedViewExtensions = ['doc', 'docx', 'xls', 'xlsx', 'pdf', 'jpg', 'jpeg', 'png', 'gif', 'bmp', 'webp', 'svg'];
    function escapeHtml(text) {
        if (text === null || text === undefined) {
            return '';
        }

        return String(text)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function getQueryFolderId() {
        var params = new URLSearchParams(window.location.search);
        return params.get('folderId') || null;
    }

    function canViewFile(filePath) {
        if (!filePath) {
            return false;
        }

        var extension = filePath.split('.').pop().toLowerCase();
        return allowedViewExtensions.includes(extension);
    }

    function navigateFolder(id) {
        if (!id) {
            window.location.href = drivePageUrl;
            return;
        }

        window.location.href = drivePageUrl + '?folderId=' + id;
    }

    function renderBreadcrumb(items) {
        var $ol = $('#breadcrumb-nav');
        var breadcrumbItems = [{ Id: null, Name: 'Gốc' }];
        $ol.empty();

        (items || []).forEach(function (item) {
            if (item && item.Name !== 'Gốc') {
                breadcrumbItems.push(item);
            }
        });

        breadcrumbItems.forEach(function (item, idx) {
            var $li = $('<li class="breadcrumb-item"></li>');
            if (idx === breadcrumbItems.length - 1) {
                $li.addClass('active').text(item.Name);
            } else {
                var $a = $('<a href="#"></a>').text(item.Name);
                $a.on('click', function (e) {
                    e.preventDefault();
                    navigateFolder(item.Id);
                });
                $li.append($a);
            }
            $ol.append($li);
        });
    }

    function renderTable(folders, files) {
        var $body = $('#drive-body');
        $body.empty();

        folders.forEach(function (folder) {
            var nameHtml = '<i class="fa fa-folder text-warning mr-1"></i>' + escapeHtml(folder.Name);
            var $tr = $('<tr></tr>');
            $tr.append($('<td></td>').append(
                $('<a href="#"></a>')
                    .html(nameHtml)
                    .on('click', function (e) {
                        e.preventDefault();
                        navigateFolder(folder.Id);
                    })
            ));
            $tr.append($('<td></td>').text(folder.OwnerName || ''));
            $tr.append($('<td></td>').text(folder.CreatedAtStr || ''));
            $tr.append($('<td></td>').text(''));
            $tr.append($('<td></td>'));
            $body.append($tr);
        });

        files.forEach(function (file) {
            var $tr = $('<tr></tr>');
            $tr.append($('<td></td>').text(file.FileName || ''));
            $tr.append($('<td></td>').text(file.OwnerName || ''));
            $tr.append($('<td></td>').text(file.UploadDateStr || ''));
            $tr.append($('<td></td>').text(file.FileSizeStr || ''));

            var $actions = $('<td></td>');
            if (canViewFile(file.DuongDan)) {
                $actions.append($('<button type="button" class="btn btn-sm btn-info mr-1"></button>')
                    .html('<i class="fa fa-eye"></i> Xem')
                    .attr('data-view-file-path', file.DuongDan || '')
                    .attr('data-view-file-name', file.FileName || ''));
            }
            if (file.CanDownload) {
                $actions.append($('<a class="btn btn-sm btn-primary"></a>')
                    .attr('href', driveApiBaseUrl + '/DownloadFile?id=' + file.Id)
                    .html('<i class="fa fa-download"></i> Tải'));
            }
            if ($actions.children().length === 0) {
                $actions.html('<span class="text-muted">Chỉ xem</span>');
            }

            $tr.append($actions);
            $body.append($tr);
        });
    }

    function getSearchKeyword() {
        return ($('#drive-search-keyword').val() || '').trim();
    }

    function loadDrive() {
        currentFolderId = getQueryFolderId();
        var searchKeyword = getSearchKeyword();
        var queryString = '?folderId=' + encodeURIComponent(currentFolderId || '');
        queryString += '&searchKeyword=' + encodeURIComponent(searchKeyword);
        ajaxGet(driveApiBaseUrl + '/GetDriveList' + queryString, function (res) {
            renderBreadcrumb(res.Breadcrumbs || []);
            renderTable(res.Folders || [], res.Files || []);
        }, function () {
            toastr.error('Không tải được danh sách Drive.');
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
        loadDrive();
        document.getElementById('btn-search-drive').addEventListener('click', function () {
            loadDrive();
        });
        document.getElementById('drive-search-keyword').addEventListener('keydown', function (event) {
            if (event.key !== 'Enter') {
                return;
            }

            event.preventDefault();
            loadDrive();
        });
    });

    $(document).on('click', 'button[data-view-file-path]', function () {
        openViewFileModal($(this).attr('data-view-file-path'), $(this).attr('data-view-file-name'));
    });
</script>
