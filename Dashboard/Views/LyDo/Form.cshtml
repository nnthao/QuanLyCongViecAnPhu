@using Dashboard.HtmlHelpers;
@{
    var action = Model != null && Model != 0 ? "Cập nhật" : "Thêm";
    ViewBag.Title = action + " lý do";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/vendor/AdminLTE-3.1.0/plugins/bootstrap-colorpicker/css/bootstrap-colorpicker.min.css" rel="stylesheet" />
<script src="~/Content/vendor/AdminLTE-3.1.0/plugins/bootstrap-colorpicker/js/bootstrap-colorpicker.min.js"></script>
<input id="Id" value="@Model" type="hidden" />
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card card-primary">
                    <div class="card-header">
                        <div class="card-title">
                            <b>@ViewBag.Title</b>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            @Html.CustomTextBox(id: "Ten", label: "Tên lý do", col: 6, required: true, length: 100)
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Mã màu: <span class="text-danger">*</span></label>
                                    <div class="input-group" id="colorpicker-group">
                                        <div class="input-group-append">
                                            <span class="input-group-text" id="color-preview" style="background-color: #ffffff; min-width: 40px; cursor: pointer;"><i></i></span>
                                        </div>
                                        <input type="text" id="MaMau" class="form-control" placeholder="#fff" />
                                    </div>
                                    <p id="MaMau-error" class="text-danger m-b-0"></p>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="modal-footer text-center d-block">
                                    <a class="btn btn-light mr-2" href="/LyDo"><i class="fa fa-chevron-left"></i> Quay lại</a>
                                    <button id="btn-save" type="button" class="btn btn-success" onclick="addOrUpdate();"><i class="fa fa-save"></i> @action</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<script>
    function loadData() {
         showLoadingModal();
             $.get("/LyDo/GetById?id=" + @Model, function (res) {
                 hideLoadingModal();

                 if (res.Item) {
                     setTimeout(function () {
                         $("#Ten").val(res.Item.Ten);
                         var maMau = res.Item.MaMau || '#1667b0';
                         $("#MaMau").val(maMau);
                         $('#colorpicker-group').colorpicker('setValue', maMau);
                         $('#color-preview').css('background-color', maMau);
                     }, 200);
                 }

              })
    }

    function addOrUpdate() {
        showLoadingModal();
        $.post("/LyDo/ThemOrCapNhat", {
            Id: $("#Id").val(),
            Ten: $("#Ten").val(),
            MaMau: $("#MaMau").val() || null,
        }, function (data) {
            hideLoadingModal();
            if (data.Errors && data.Errors.length > 0) {
                data.Errors.map((item) => {
                    var idError = "#" + item.Name;
                    $(idError).show();
                    $(idError).text(item.Description);

                    return "";
                });
            }
            else {
                window.location.href="/LyDo";
            }
        })
    }

    document.addEventListener('DOMContentLoaded', function () {
        // Khởi tạo color picker
        $('#colorpicker-group').colorpicker({
            format: 'hex',
            useAlpha: false,
            color: '#1667b0'
        });

        // Lắng nghe sự kiện thay đổi màu
        $('#colorpicker-group').on('colorpickerChange', function(event) {
            var colorValue = event.color.toString();
            $('#MaMau').val(colorValue);
            $('#color-preview').css('background-color', colorValue);
        });

        // Cập nhật màu preview khi người dùng nhập trực tiếp vào input
        $('#MaMau').on('input change', function() {
            var colorValue = $(this).val();
            if (colorValue && /^#[0-9A-F]{6}$/i.test(colorValue)) {
                $('#color-preview').css('background-color', colorValue);
                $('#colorpicker-group').colorpicker('setValue', colorValue);
            }
        });

        loadData();
    });
</script>