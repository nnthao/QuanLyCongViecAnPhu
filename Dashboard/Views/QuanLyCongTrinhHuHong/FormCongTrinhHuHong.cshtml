@model int
@using Dashboard.HtmlHelpers;
@using Dashboard.Models.HtmlHelpers
@{
    ViewBag.Title = "Thêm hư hỏng công trình";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card card-primary">
                    <div class="card-header">
                        <div class="card-title">
                            <b>@ViewBag.Title</b>
                        </div>
                    </div>
                    <div class="card-body">
                        <form id="form-cong-trinh-hu-hong">
                            <div class="row">
                                <input id="Id" value="@Model" type="hidden" />
                                
                                <!-- Thông tin công trình (chỉ đọc) -->
                                <div class="col-12">
                                    <h5 class="text-primary">Thông tin công trình</h5>
                                </div>
                                
                                <div class="row">
                                    @Html.CustomTextBox(id: "TenCongTrinh", label: "Tên công trình", col: 6, required: true, length: 500, isReadonly: true)
                                    @Html.CustomTextBox(id: "Diadiem", label: "Địa điểm", col: 6, required: false, length: 500, isReadonly: true)
                                </div>

                                <div class="row">
                                    @Html.CustomDropDownList(id: "LoaiCongTrinh", label: "Loại công trình", col: 6, required: true, 
                                        options: new List<SelectListItem> { 
                                            new SelectListItem { Text = "--- Chọn ---", Value = "0" }, 
                                            new SelectListItem { Text = "Cầu", Value = "1" }, 
                                            new SelectListItem { Text = "Đường", Value = "2" }, 
                                            new SelectListItem { Text = "Cống", Value = "3" }, 
                                            new SelectListItem { Text = "Đê", Value = "4" }, 
                                            new SelectListItem { Text = "Khác", Value = "5" } 
                                        }, isDisabled: true)
                                    @Html.CustomTextBox(id: "NamXayDung", label: "Năm xây dựng", col: 6, required: false, length: 50, isReadonly: true)
                                </div>

                                <div class="row">
                                    @Html.CustomTextBox(id: "ChuDauTu", label: "Chủ đầu tư", col: 6, required: false, length: 500, isReadonly: true)
                                    @Html.CustomTextBox(id: "QuyMo", label: "Quy mô", col: 6, required: false, length: 500, isReadonly: true)
                                </div>

                                <div class="row">
                                    @Html.CustomTextBox(id: "DienTich", label: "Diện tích", col: 6, required: false, length: 500, isReadonly: true)
                                    @Html.CustomTextBox(id: "ThongSoKiThuat", label: "Thông số kỹ thuật", col: 6, required: false, length: 500, isReadonly: true)
                                </div>

                                <div class="row">
                                    @Html.CustomTextArea(id: "GhiChu", label: "Ghi chú", isReadonly: true, col: 12, row: 3, required: false, maxlength: 1000)
                                </div>

                                <!-- Thông tin hư hỏng -->
                                <div class="col-12 mt-4">
                                    <h5 class="text-danger">Thông tin hư hỏng</h5>
                                </div>

                                <!-- Hàng 1: 4 trường thông tin hư hỏng -->
                                <div class="row">
                                    @Html.CustomDatePicker(id: "NgayPhatHien", label: "Ngày phát hiện", col: 3, required: true)
                                    @Html.CustomDropDownList(id: "MucDoHuHong", label: "Mức độ hư hỏng", col: 3, required: true,
                                        options: new List<SelectListItem> {
                                            new SelectListItem { Text = "--- Chọn ---", Value = "0" },
                                            new SelectListItem { Text = "Nhẹ", Value = "1" },
                                            new SelectListItem { Text = "Trung bình", Value = "2" },
                                            new SelectListItem { Text = "Nặng", Value = "3" }
                                        })
                                    @Html.CustomDropDownList(id: "TrangThaiXuLy", label: "Trạng thái xử lý", col: 3, required: true,
                                        options: new List<SelectListItem> {
                                            new SelectListItem { Text = "--- Chọn ---", Value = "0" },
                                            new SelectListItem { Text = "Chưa xử lý", Value = "1" },
                                            new SelectListItem { Text = "Đang xử lý", Value = "2" },
                                            new SelectListItem { Text = "Đã khắc phục", Value = "3" }
                                        })
                                    @Html.CustomTextArea(id: "NguyenNhan", label: "Nguyên nhân", isReadonly: false, col: 3, row: 2, required: false, maxlength: 1000)
                                </div>

                                <!-- Hàng 2: Tệp đính kèm -->
                                <div class="row">
                                    @Html.FileDinhKem(id: "FileDinhKem")
                                </div>

                                <!-- Hàng 3: File đã đính kèm (placeholder) -->
                                @*<div class="row">
                                    <div class="col-12">
                                        <label class="form-label">File đã đính kèm</label>
                                        <div class="alert alert-info">
                                            <i class="fa fa-info-circle"></i> Chưa có file nào được đính kèm
                                        </div>
                                    </div>
                                </div>*@

                                <!-- Hàng 4: Nút Lưu và Quay lại -->
                                <div class="row">
                                    <div class="col-sm-12">
                                        <div class="modal-footer text-center d-block">
                                            <button id="btn-loading" type="button" class="btn btn-default invisible" data-dismiss="modal">
                                                <i class="fa fa-spinner fa-spin"></i> Đang xử lý...
                                            </button>
                                            <button id="btn-save" type="button" class="btn btn-primary" onclick="addOrUpdate();">
                                                <i class="fa fa-save"></i> Lưu
                                            </button>
                                            <a class="btn btn-light mr-2" href="/QuanLyCongTrinhHuHong/CongTrinhHuHong">
                                                <i class="fa fa-chevron-left"></i> Quay lại
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<script>
    function loadData() {
        showLoadingModal();
        $.get("/QuanLyCongTrinhHuHong/GetCongTrinhHuHongById?id=" + @Model, function (res) {
            if (res.Item) {
                $("#TenCongTrinh").val(res.Item.TenCongTrinh);
                $("#Diadiem").val(res.Item.Diadiem);
                $("#LoaiCongTrinh").val(res.Item.LoaiCongTrinh);
                $("#NamXayDung").val(res.Item.NamXayDung);
                $("#ChuDauTu").val(res.Item.ChuDauTu);
                $("#QuyMo").val(res.Item.QuyMo);
                $("#DienTich").val(res.Item.DienTich);
                $("#ThongSoKiThuat").val(res.Item.ThongSoKiThuat);
                $("#GhiChu").val(res.Item.GhiChu);
            }
            hideLoadingModal();
        })
    }

    function addOrUpdate() {
        showLoadingModal();
        $.post("/QuanLyCongTrinhHuHong/ThemOrCapNhatChiTiet", {
            Id: 0, // Always new damage record
            CongTrinhHuHongId: $("#Id").val(),
            TenCongTrinh: $("#TenCongTrinh").val(),
            Diadiem: $("#Diadiem").val(),
            LoaiCongTrinh: $("#LoaiCongTrinh").val(),
            NamXayDung: $("#NamXayDung").val(),
            ChuDauTu: $("#ChuDauTu").val(),
            QuyMo: $("#QuyMo").val(),
            DienTich: $("#DienTich").val(),
            ThongSoKiThuat: $("#ThongSoKiThuat").val(),
            GhiChu: $("#GhiChu").val(),
            NgayPhatHien: $("#NgayPhatHien").val(),
            MucDoHuHong: $("#MucDoHuHong").val(),
            NguyenNhan: $("#NguyenNhan").val(),
            TrangThaiXuLy: $("#TrangThaiXuLy").val()
        }, function (data) {
            hideLoadingModal();
            if (data.Errors && data.Errors.length > 0) {
                data.Errors.map((item) => {
                    var idError = "#" + item.Name;
                    $(idError).show();
                    $(idError).text(item.Description);
                    return "";
                });
            }
            else {
                window.location.href="/QuanLyCongTrinhHuHong/CongTrinhHuHong";
            }
        })
    }

    document.addEventListener('DOMContentLoaded', function () {
        loadData();
    });
</script>
