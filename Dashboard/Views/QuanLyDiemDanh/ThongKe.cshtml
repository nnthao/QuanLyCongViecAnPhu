
@using Dashboard.HtmlHelpers;
@using Dashboard.Common;
@using System;
@{
    ViewBag.Title = "Thống kê nghỉ phép";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card card-primary">
                    <div class="card-header">
                        <div class="card-title">
                            <b>Thống kê nghỉ phép & đi trễ</b>
                        </div>
                        <div class="card-tools">
                            <button type="button" class="btn btn-success btn-sm" id="btnExportExcel">
                                <i class="fa fa-file-excel-o"></i> Xuất Excel
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <!-- Bộ lọc -->
                        <div class="row">
                            <div class="col-md-2">
                                @Html.CustomDatePicker(id: "FromDate", label: "Từ ngày",
                                    value: DateTimeHelper.NgayDauThang(DateTime.Now).ToString("dd/MM/yyyy"),
                                    col: 12, required: false)
                            </div>
                            <div class="col-md-2">
                                @Html.CustomDatePicker(id: "ToDate", label: "Đến ngày",
                                    value: DateTimeHelper.NgayCuoiThang(DateTime.Now).ToString("dd/MM/yyyy"),
                                    col: 12, required: false)
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Loại thống kê</label>
                                    <select class="form-control" id="LoaiThongKe">
                                        <option value="">Tất cả</option>
                                        <option value="1">Nghỉ phép</option>
                                        <option value="2">Đi trễ</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>&nbsp;</label>
                                    <button class="btn btn-primary btn-block" id="btnXemThongKe">
                                        <i class="fa fa-search"></i> Xem thống kê
                                    </button>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>&nbsp;</label>
                                    <a href="/QuanLyDiemDanh" class="btn btn-default btn-block">
                                        <i class="fa fa-arrow-left"></i> Quay lại
                                    </a>
                                </div>
                            </div>
                        </div>

                        <!-- Thống kê tổng quan -->
                        <div class="row" id="summaryStats">
                            <div class="col-lg-3 col-6">
                                <div class="small-box bg-success">
                                    <div class="inner">
                                        <h3 id="totalHalfDays">0</h3>
                                        <p>Tổng buổi lẻ</p>
                                    </div>
                                    <div class="icon">
                                        <i class="fa fa-clock-o"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-3 col-6">
                                <div class="small-box bg-warning">
                                    <div class="inner">
                                        <h3 id="totalFullDays">0</h3>
                                        <p>Tổng ngày full</p>
                                    </div>
                                    <div class="icon">
                                        <i class="fa fa-calendar"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-3 col-6">
                                <div class="small-box bg-danger">
                                    <div class="inner">
                                        <h3 id="totalDaysOff">0</h3>
                                        <p>Tổng ngày nghỉ</p>
                                    </div>
                                    <div class="icon">
                                        <i class="fa fa-calendar-times-o"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-3 col-6">
                                <div class="small-box" style="background-color: #17a2b8; color: white;">
                                    <div class="inner">
                                        <h3 id="totalLateDays">0</h3>
                                        <p>Tổng lần đi trễ</p>
                                    </div>
                                    <div class="icon">
                                        <i class="fa fa-exclamation-triangle"></i>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-sm-12">
                                <table id="tableThongKe"
                                       data-toggle="table"
                                       data-url="/QuanLyDiemDanh/GetBaoCao"
                                       data-pagination="true"
                                       data-side-pagination="client"
                                       data-page-size="30"
                                       data-page-list="[30, 50, 100, 200]"
                                       data-locale="vi-VN"
                                       data-query-params="queryParams"
                                       data-sort-name="TongNgayNghi"
                                       data-sort-order="desc"
                                       data-show-columns="true"
                                       data-show-export="false">
                                    <thead>
                                        <tr>
                                            <th data-field="Stt" data-width="60" data-align="center">STT</th>
                                            <th data-field="UserName" data-sortable="true">Nhân viên</th>
                                            <th data-field="SoLanNghiLe" data-sortable="true" data-align="center">Số buổi lẻ</th>
                                            <th data-field="SoLanNghiCaNgay" data-sortable="true" data-align="center">Số ngày full</th>
                                            <th data-field="SoLanDiTre" data-sortable="true" data-align="center">Số lần đi trễ</th>
                                            <th data-field="TongNgayNghi" data-formatter="tongNgayNghiFormatter" data-sortable="true" data-align="center">TỔNG NGÀY NGHỈ</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="modalChiTietNgayNghi" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalChiTietNgayNghiTitle">Chi tiết ngày nghỉ</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped mb-0">
                        <thead>
                            <tr>
                                <th class="text-center" style="width: 60px;">STT</th>
                                <th class="text-center" style="width: 140px;">Ngày nghỉ</th>
                                <th class="text-center" style="width: 140px;">Loại nghỉ</th>
                                <th>Lý do</th>
                                <th class="text-center" style="width: 120px;">Quy đổi</th>
                            </tr>
                        </thead>
                        <tbody id="chiTietNgayNghiBody">
                            <tr>
                                <td colspan="5" class="text-center text-muted">Chưa có dữ liệu</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        loadThongKe();
        loadSummaryStats();
    });

    function queryParams(params) {
        params.FromDateStr = $('#FromDate').val();
        params.ToDateStr = $('#ToDate').val();
        var loaiThongKe = $('#LoaiThongKe').val();
        if (loaiThongKe) {
            params.LoaiThongKe = loaiThongKe;
        }
        return params;
    }

    function search() {
        loadThongKe();
        loadSummaryStats();
    }

    function loadThongKe() {
        var fromDate = $('#FromDate').val();
        var toDate = $('#ToDate').val();

        if (!fromDate || !toDate) {
            toastr.error("Vui lòng chọn khoảng thời gian");
            return;
        }

        $('#tableThongKe').bootstrapTable('refresh', { silent: true });
    }

    function loadSummaryStats() {
        var fromDate = $('#FromDate').val();
        var toDate = $('#ToDate').val();
        var loaiThongKe = $('#LoaiThongKe').val();

        var summaryUrl = `/QuanLyDiemDanh/GetBaoCaoSummary?FromDateStr=${encodeURIComponent(fromDate)}&ToDateStr=${encodeURIComponent(toDate)}`;
        if (loaiThongKe) {
            summaryUrl += `&LoaiThongKe=${loaiThongKe}`;
        }

        ajaxGet(summaryUrl, function (res) {
            if (res) {
                $('#totalHalfDays').text(res.TotalHalfDays || 0);
                $('#totalFullDays').text(res.TotalFullDays || 0);
                $('#totalDaysOff').text((res.TotalDaysOff || 0).toFixed(1));
                $('#totalLateDays').text(res.TotalLateDays || 0);
            }
        });
    }

    function boldFormatter(value) {
        return `<b style="color:red; font-size: 1.1em;">${value}</b>`;
    }

    function tongNgayNghiFormatter(value, row) {
        if (!value || value <= 0) {
            return boldFormatter(value || 0);
        }

        var encodedUserName = encodeURIComponent(row.UserName || '');
        return `<a href="javascript:void(0)" onclick="showNgayNghiDetails(${row.UserId}, decodeURIComponent('${encodedUserName}'))" style="font-weight: 700; color: red; font-size: 1.1em; text-decoration: underline;">${value}</a>`;
    }

    function showNgayNghiDetails(userId, userName) {
        var fromDate = $('#FromDate').val();
        var toDate = $('#ToDate').val();

        if (!fromDate || !toDate) {
            toastr.error("Vui lòng chọn khoảng thời gian");
            return;
        }

        $('#modalChiTietNgayNghiTitle').text(`Chi tiết ngày nghỉ - ${userName}`);
        $('#chiTietNgayNghiBody').html('<tr><td colspan="5" class="text-center text-muted">Đang tải dữ liệu...</td></tr>');
        $('#modalChiTietNgayNghi').modal('show');

        var detailUrl = `/QuanLyDiemDanh/GetChiTietNgayNghi?UserId=${userId}&FromDateStr=${encodeURIComponent(fromDate)}&ToDateStr=${encodeURIComponent(toDate)}`;
        ajaxGet(detailUrl, function (res) {
            renderNgayNghiDetails(res || []);
        });
    }

    function renderNgayNghiDetails(items) {
        if (!items.length) {
            $('#chiTietNgayNghiBody').html('<tr><td colspan="5" class="text-center text-muted">Không có ngày nghỉ trong khoảng thời gian đã chọn</td></tr>');
            return;
        }

        var html = '';
        items.forEach(function (item, index) {
            html += `<tr>
                        <td class="text-center">${index + 1}</td>
                        <td class="text-center">${item.NgayNghiStr || ''}</td>
                        <td class="text-center">${item.ChiTietNghi || ''}</td>
                        <td>${item.LyDo || ''}</td>
                        <td class="text-center">${Number(item.SoNgayNghi || 0).toFixed(1).replace('.0', '')}</td>
                    </tr>`;
        });

        $('#chiTietNgayNghiBody').html(html);
    }

    document.getElementById('btnXemThongKe').addEventListener('click', function () {
        search();
    });

    document.getElementById('btnExportExcel').addEventListener('click', function () {
        exportToExcel();
    });

    function exportToExcel() {
        var allData = $('#tableThongKe').bootstrapTable('getData');
        if (!allData || allData.length === 0) {
            toastr.warning("Không có dữ liệu để xuất");
            return;
        }

        var fromDate = $('#FromDate').val();
        var toDate = $('#ToDate').val();

        var csv = 'STT,Nhân viên,Số buổi lẻ,Số ngày full,Số lần đi trễ,Tổng ngày nghỉ\n';
        allData.forEach(function (item, index) {
            csv += `${index + 1},"${item.UserName}",${item.SoLanNghiLe},${item.SoLanNghiCaNgay},${item.SoLanDiTre},${item.TongNgayNghi}\n`;
        });

        var blob = new Blob(["\uFEFF" + csv], { type: 'text/csv;charset=utf-8;' });
        var link = document.createElement("a");
        var url = URL.createObjectURL(blob);
        link.setAttribute("href", url);
        link.setAttribute("download", `ThongKeNghiPhep_${fromDate.replace(/\//g, '')}_${toDate.replace(/\//g, '')}.csv`);
        link.style.visibility = 'hidden';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }
</script>
