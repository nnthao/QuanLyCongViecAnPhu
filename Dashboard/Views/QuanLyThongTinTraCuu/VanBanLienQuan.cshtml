<div class="row">
    <div class="col-sm-12">
        <p class="text-right">
            <button class="btn btn-primary" id="openVanBanModal"><i class="fa fa-file-text-o"></i> Thêm văn bản</button>
        </p>
        <table class="table table-bordered table-striped">
            <thead class="thead-light">
                <tr>
                    <th>Số kí hiệu</th>
                    <th>Trích yếu</th>
                    <th>Ngày văn bản</th>
                    <th>Đơn vị ban hành</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="listVanBan">
            </tbody>
        </table>
    </div>
</div>
<script>
    function loadDataVanBan() {
        ajaxGet("/QuanLyThongTinTraCuu/GetListVanBanPhapLuat?id=" + @Model, function funcCallback(res) {
            for (let i = 0; i < res.length; i++) {
                let item = res[i];
                // Không cần push vào selectedVanBanList nữa, chỉ cần add vào table
                addVanBanToTable(item);
            }
        }, function funcError() {
            toastr.error("Đã có lỗi xảy ra. Vui lòng tải lại trang.");
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
        loadDataVanBan();
    });
</script>
