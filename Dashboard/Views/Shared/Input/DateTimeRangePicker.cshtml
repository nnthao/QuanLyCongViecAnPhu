@model Dashboard.Models.HtmlHelpers.Input.InputTextViewModel

<div class="col-md-@Model.Col @Model.MoreClass">
    <div class="form-group">
        <label>
            @Model.Label:
            @if (Model.Required)
            {
                <span class="text-danger" id="@Model.Id-Required">*</span>
            }
        </label>

        <div id="@Model.Id" style="background: #fff; cursor: pointer; padding: 5px 10px; border: 1px solid #ccc; width: 100%">
            <i class="fa fa-calendar"></i>&nbsp;
            <span class="dateShow"></span> <i class="fa fa-caret-down"></i>
        </div>

        <p id="@Model.ErrorId" class="text-danger m-b-0"></p>
    </div>
</div>
<script type="text/javascript">
     document.addEventListener('DOMContentLoaded', function () {
        $('#' + '@Model.Id').daterangepicker({
            linkedCalendars: false,
            showDropdowns: true,
            timePicker: true,
            minDate: moment("01/01/1950", "DD/MM/YYYY"),//[moment().subtract(20, 'years'), 'inclusive'],
            maxDate: moment("31/12/2070", "DD/MM/YYYY"), //[moment(), 'inclusive'],
            //startDate: window['startDate' + '@Model.Id'],
            //endDate: window['endDate' + '@Model.Id'],
            ranges: {
                'Today': [moment(), moment()],
                'Yesterday': [moment().subtract(1, 'days'), moment().subtract(1, 'days')],
                'Last 7 Days': [moment().subtract(6, 'days'), moment()],
                'Last 30 Days': [moment().subtract(29, 'days'), moment()],
                'This Month': [moment().startOf('month'), moment().endOf('month')],
                'Last Month': [moment().subtract(1, 'month').startOf('month'), moment().subtract(1, 'month').endOf('month')]
            }
        }, function (start, end) {
            $('#' + '@Model.Id' + ' .dateShow').html(start.format("DD/MM/YYYY")
                + ' - ' + end.format("DD/MM/YYYY"));
        });

        DateTimeHelper.dateRangePickerDateDefault('@Model.Id');
    });
</script>