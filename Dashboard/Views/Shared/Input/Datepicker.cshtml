@model Dashboard.Models.HtmlHelpers.Input.InputTextViewModel
@{
    var isEnabled = !Model.IsReadonly;
}

<div class="col-md-@Model.Col @Model.MoreClass">
    <div class="form-group">
        <label>
            @if (!string.IsNullOrEmpty(@Model.Label))
            {
                <psan>@Model.Label:</psan>
            }
            else
            {
                <span>&nbsp;</span>
            }

            @if (Model.Required)
            {
                <span class="text-danger">*</span>
            }
        </label>
        <div class="input-group">
            <input @(Model.IsReadonly ? "disabled" : "") type="text" id="@Model.Id" class="form-control" value="@Model.value" />
            <div class="input-group-append">
                <span class="input-group-text" id="@Model.Id-Calendar"><i class="fa fa-calendar"></i></span>
            </div>
        </div>
        <p id="@Model.ErrorId" class="text-danger m-b-0"></p>
    </div>
</div>
<script type="text/javascript">
     document.addEventListener('DOMContentLoaded', function () {
        var id = '@Model.Id';
        var idElement = "#" + id;
        $(idElement).datepicker({
            autoclose: true,
            todayHighlight: true,
            format: 'dd/mm/yyyy'
        });
    });
</script>
