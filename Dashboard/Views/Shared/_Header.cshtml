<script>
    function daXemTatCaThongBao() {
        if (confirm("Xác nhận đã xem tất cả thông báo")) {
            ajaxGet("/ThongBao/DanhDauDaXemTatCa", function calFunction(res) {
                toastr.success("Thục hiện thành công");
                getThongBao();
            }, function errFunct(err) {
                toastr.error("Đã có lỗi xảy ra. Vui lòng tải lại trang.");
            });

        }
    }

    function getThongBao() {
        ajaxGet("/ThongBao/GetListThongBaoBellIcon", function calFunction(res) {
            if (res.ChuaXem && res.ChuaXem != 0) {
                $("#spanBell").show();
                $("#spanBell").text(res.ChuaXem);
            }
            else {
                $("#spanBell").hide();
            }

            $("#divBell").empty();
            if (res.Data && res.Data.rows) {
                if (res.Data.rows.length != 0) {
                    for (let i = 0; i < res.Data.rows.length; i++) {
                        let item = res.Data.rows[i];
                        $("#divBell").append(`<a href="javascript:void(0)" onclick="thongBaoClickFunc('${item.Id}','${item.Link}' )" class="dropdown-item d-flex align-items-start ${!item.IsDaXem ? "font-weight-bold" : ""}">
                          <div class="icon-col">
                            <i class="fa fa-envelope mr-2"></i>
                          </div>
                          <div class="text-col">
                            <div class='tieude'> ${item.TieuDe}</div>
                            <span class="message-text">
                               ${item.NoiDung}
                            </span>
                            <span class="float-right text-muted text-sm d-block">${item.KhoangThoiGian}</span>
                          </div>
                        </a><div class="dropdown-divider"></div>`)
                    }
                }
                else {
                    $("#divBell").append(`<p class="p-3 text-center">Không có thông báo để hiển thị</p>
                                <div class="dropdown-divider"></div>`)
                }
            }
        }, function errFunct(err){

        })
    }

    function thongBaoClickFunc(id, link) {
        var fd = new FormData();
        fd.append("Id", id);
        ajaxPostFormData("/ThongBao/DanhDauDaXem", fd, function funcCallback(data) {
            getThongBao();
        }, function funcError() {
            toastr.error("Đã có lỗi xảy ra. Vui lòng tải lại trang.");
        })

        if (link != "#") {
            window.location.href = link;
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        $.get("/ThongTinTaiKhoan/GetHeaderInfo", function (res) {
            $("#hoTenTxt").text(res.Name ? res.Name : "...");
            $("#phongBanTxt").text(res.PhongBan ? res.PhongBan : "...");
            $("#chucDanhTxt").text(res.ChucDanh ? res.ChucDanh : "...");
        })

        getThongBao();
    });
</script>