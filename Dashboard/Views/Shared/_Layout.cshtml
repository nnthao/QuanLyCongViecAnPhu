@using Dashboard.Models.HtmlHelpers

<!DOCTYPE html>
<html>
<head>
    <title>@ViewBag.Title</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="zalo-platform-site-verification" content="ElY1ESJ5CoOsoxujq-ix2opxwpJ0ZJ5ZE3Kn" />
    <link rel="shortcut icon" type="image/png" href="/Content/img/favicon.ico" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
    @Html.Partial("_Meta")

    <link href="~/Content/vendor/AdminLTE-3.1.0/dist/css/adminlte.min.css" rel="stylesheet" />
    <link href="~/Content/vendor/bootstrap-table-1.18.3/dist/bootstrap-table.min.css" rel="stylesheet" />
    <link href="~/Content/fonts/font-awesome-4.7.0/css/font-awesome.min.css" rel="stylesheet" />
    <link href="~/Content/vendor/select2/css/select2.min.css" rel="stylesheet" />
    <link href="~/Content/vendor/select2/css/select2-bootstrap4.min.css" rel="stylesheet" />
    <link href="~/Content/vendor/bootstrap-datepicker/css/bootstrap-datepicker3.standalone.min.css" rel="stylesheet" />
    <link href="~/Content/vendor/jquery-toast-plugin/toastr.min.css" rel="stylesheet" />
    <link href="/Content/vendor/bootstrap-table-1.18.3/dist/extensions/fixed-columns/bootstrap-table-fixed-columns.min.css" rel="stylesheet" />
    <link href="~/Content/vendor/daterangepicker/daterangepicker.min.css" rel="stylesheet" />
    <link href="~/Content/vendor/bootstrap-datetimepicker-4/css/bootstrap-datetimepicker.min.css" rel="stylesheet" />

    <link href="~/Content/vendor/AdminLTE-3.1.0/plugins/overlayScrollbars/css/OverlayScrollbars.min.css" rel="stylesheet" />
    <link href="~/Content/vendor/fullcalendar-5.11.0/main.min.css" rel="stylesheet" />
    <link href="~/Content/vendor/loading-modal/loading-modal.min.css" rel="stylesheet" />

    <link href="@Url.VersionedContent("~/Content/css/dashboard.css")" rel="stylesheet" />
    <link href="@Url.VersionedContent("~/Content/css/media-screen.css")" rel="stylesheet" />

    <script src="~/Content/vendor/jquery/jquery-3.2.1.min.js" type="text/javascript"></script>
    <script src="~/Content/vendor/moment.min.js" type="text/javascript"></script>
    <script src="~/Content/vendor/bootstrap-table-1.18.3/dist/bootstrap-table.min.js" type="text/javascript"></script>
    <script src="~/Content/vendor/bootstrap-table-1.18.3/dist/locale/bootstrap-table-vi-VN.min.js" type="text/javascript"></script>
    <script src="/Content/vendor/bootstrap-table-1.18.3/dist/extensions/fixed-columns/bootstrap-table-fixed-columns.min.js" type="text/javascript"></script>
    <script src="~/Content/vendor/bootstrap-table-1.18.3/dist/bootstrap-table-mobile.min.js"></script>
    <script src="~/Content/vendor/select2/js/select2.min.js" type="text/javascript"></script>
    <script src="~/Content/vendor/bootstrap-datepicker/js/bootstrap-datepicker.min.js" type="text/javascript"></script>
    <script src="~/Content/vendor/select2/js/i18n/vi.js" type="text/javascript"></script>
    <script src="~/Content/vendor/jquery-toast-plugin/toastr.min.js" type="text/javascript"></script>
    <script src="~/Content/vendor/daterangepicker/daterangepicker.min.js" type="text/javascript"></script>
    <script src="~/Content/vendor/AdminLTE-3.1.0/plugins/bootstrap/js/bootstrap.bundle.min.js" type="text/javascript"></script>
    <script src="~/Content/vendor/AdminLTE-3.1.0/plugins/overlayScrollbars/js/jquery.overlayScrollbars.min.js" type="text/javascript"></script>
    <script src="~/Content/vendor/AdminLTE-3.1.0/dist/js/adminlte.js" type="text/javascript"></script>
    <script src="~/Content/vendor/fullcalendar-5.11.0/main.min.js"></script>
    <script src="~/Content/vendor/fullcalendar-5.11.0/locales/vi.js"></script>

    <script src="@Url.VersionedContent("~/Content/js/ultilities/FormHelper.js")" type="text/javascript"></script>
    <script src="@Url.VersionedContent("~/Content/js/ultilities/Helper.js")" type="text/javascript"></script>
</head>
<body class="hold-transition sidebar-mini layout-fixed">
    <div class="wrapper">
        @Html.Partial("_Header")
        @Html.Partial("_MenuSlide")
        <div class="content-wrapper" style="padding-top: 15px;">
            @RenderBody()
        </div>
        @Html.Partial("_Footer")
        @Html.Partial("_PopupInfoList")
        @Html.Partial("_ViewFileModal")


        <script src="~/Content/vendor/bootstrap-datetimepicker-4/js/bootstrap-datetimepicker.min.js"></script>
        <script src="~/Content/vendor/loading-modal/loading-modal.min.js"></script>
        <script src="~/Content/vendor/chart.js-3.3.2/chart.min.js"></script>

        <!-- Thư viện xem file -->
        <script src="https://cdnjs.cloudflare.com/ajax/libs/mammoth/1.6.0/mammoth.browser.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

    </div>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            $('[data-toggle="tooltip"]').tooltip();
            initMainTableAutoHeight();
        });

        toastr.options = {
            "positionClass": "toast-top-center", // hoặc dùng custom class
            "timeOut": "3000"
        };

        moment.locale('en', {
            week: { dow: 1 } // Monday is the first day of the week
        });
    </script>
</body>
</html>
<!-- Global site tag (gtag.js) - Google Analytics -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-JNR5E8JH1K"></script>
<script>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());

    gtag('config', 'G-JNR5E8JH1K');
</script>