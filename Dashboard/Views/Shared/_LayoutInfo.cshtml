<body >
    <div class="container-fluid" >
        <div style="padding:5px;">
            @RenderBody()
        </div>

        <script src="~/Content/vendor/bootstrap-datetimepicker-4/js/bootstrap-datetimepicker.min.js"></script>
        <script src="https://admin-lte-3.vercel.app/plugins/loading-modal/loading-modal.min.js"></script>

        <!-- Thư viện xem file -->
        <script src="https://cdnjs.cloudflare.com/ajax/libs/mammoth/1.6.0/mammoth.browser.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

    </div>
    @Html.Partial("_ViewFileModal")
    <script>
        moment.locale('en', {
            week: { dow: 1 } // Monday is the first day of the week
        });
    </script>
</body>
</html>