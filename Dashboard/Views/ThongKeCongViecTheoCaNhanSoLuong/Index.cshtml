        }

        var fd = new FormData();
        fd.append("TuNgayStr", tuNgay);
        fd.append("DenNgayStr", denNgay);
        fd.append("PhongBanIdsStr", phongBanIds);

        showLoadingModal();
        ajaxPostFormData("/ThongKeCongViecTheoCaNhanSoLuong/GetTop10ThanhVienCoItCongViec", fd,
            function funcCallback(response) {
                hideLoadingModal();

                if (response.Errors && response.Errors.length > 0) {
                    var errorMessages = response.Errors.map(function (error) {
                        return error.Description;
                    }).join('<br/>');
                    $("#top10ThanhVienItContainer").html('<div class="error-state">' + errorMessages + '</div>');
                } else if (response.Data && response.Data.length > 0) {
                    var html = '<table class="table table-bordered table-striped stat-table">';
                    html += '<thead><tr><th style="width: 8%">STT</th><th>Tên thành viên</th><th>Phòng ban</th><th style="width: 15%; text-align: center;">Số lượng</th></tr></thead>';
                    html += '<tbody>';
                    response.Data.forEach(function (item, index) {
                        html += '<tr>';
                        html += '<td style="text-align: center; font-weight: 600;">' + (index + 1) + '</td>';
                        html += '<td>' + (item.TenThanhVien || 'Không xác định') + '</td>';
                        html += '<td>' + (item.TenPhongBan || '') + '</td>';
                        var badgeClass = item.SoLuong === 0 ? 'stat-badge stat-badge-danger' : 'stat-badge stat-badge-warning';
                        html += '<td style="text-align: center;"><span class="' + badgeClass + '">' + item.SoLuong + '</span></td>';
                        html += '</tr>';
                    });
                    html += '</tbody></table>';
                    $("#top10ThanhVienItContainer").html(html);
                } else {
                    $("#top10ThanhVienItContainer").html('<div class="empty-state"><div class="empty-state-icon">📭</div><p>Không có dữ liệu</p></div>');
                }
            },
            function funcError() {
                hideLoadingModal();
                $("#top10ThanhVienItContainer").html('<div class="error-state">Đã có lỗi xảy ra. Vui lòng thử lại.</div>');
            }
        );
    }

    function thongKe() {
        loadTop10ThanhVien();
        loadTop10ThanhVienIt();
        loadTop10ThanhVienSomHan();
        loadTop10ThanhVienTreHan();
    }

    // Gọi loadTop10ThanhVien và loadTop10ThanhVienIt khi thay đổi điều kiện
    document.addEventListener("DOMContentLoaded", function () {
        // Load dữ liệu khi trang load
        setTimeout(function () {
            loadTop10ThanhVien();
            loadTop10ThanhVienIt();
            loadTop10ThanhVienSomHan();
            loadTop10ThanhVienTreHan();
        }, 500);
    });

