<style>
    #vanBanChiTietModal card-title {
        font-weight: bold;
    }

    #chiTietBody td:first-child {
        font-weight: bold;
    }
</style>
<div class="modal fade" id="vanBanChiTietModal" tabindex="-1" role="dialog" aria-labelledby="vanBanChiTietModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="vanBanChiTietModalLabel">Chi tiết văn bản</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div id="vanBanChiTietContent">
                    <div class="card-header">
                        <h3 class="card-title">Thông tin cơ bản</h3>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-sm-12">
                                <table class="table  table-bordered" >
                                    <tbody id="chiTietBody">

                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="vanBanChiTietContent">
                    <div class="card-header">
                        <h3 class="card-title">File đính kèm</h3>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-12">
                                <table id="bsTaiLieuDinhKemVanBan"
                                       data-locale="vi-VN">
                                    <thead class="thead-light">
                                        <tr>
                                            <th data-field="TenFile" data-formatter="tenVanBanFormat">File</th>
                                            @*<th data-width="200" data-align="center" data-field="operate"
                                                data-formatter="actionTaiLieuDinhKemVanBan">&nbsp;</th>*@
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer" style="display: inline;text-align:center">
                <button type="button" class="btn btn-default" data-dismiss="modal"><i class="fa fa-times"></i> Đóng</button>
            </div>
        </div>
    </div>
</div>

<script>
    function xemChiTietVanBan(vanBanId) {
        $('#vanBanChiTietModal').modal('show');
        loadVanBanChiTiet(vanBanId);
        loadFileDinhKemVanBan(vanBanId);
    }

    function loadVanBanChiTiet(vanBanId) {
        ajaxGet("/VanBanPhapLuat/GetChiTietViewById?id=" + vanBanId, function funcCallback(data) {
            if (data.Item) {
                displayVanBanChiTiet(data.Item);
            }
        }, function funcError() {
          
        });
    }

    function displayVanBanChiTiet(item) {
        var html = `
           <tr><td>Số kí hiệu</td><td>${item.SoKiHieu}</td></tr>
           <tr><td>Trích yếu</td><td>${item.TrichYeu}</td></tr>
           <tr><td>Ngày ban hành</td><td>${item.NgayBanHanhStr}</td></tr>
           <tr><td>Hình thức văn bản</td><td>${item.HinhThucVanBan}</td></tr>
           <tr><td>Cơ quan ban hành</td><td>${item.CoQuanBanHanh}</td></tr>
        `;
        $('#chiTietBody').html(html);
    }

    function loadFileDinhKemVanBan(vanBanId) {
        ajaxGet("/VanBanPhapLuat/GetFileDinhKemById?id=" + vanBanId, function funcCallback(data) {
            TaiLieuDinhKemDatas = data;
            $("#bsTaiLieuDinhKemVanBan").bootstrapTable("destroy");
            $("#bsTaiLieuDinhKemVanBan").bootstrapTable({ data: TaiLieuDinhKemDatas });
        }, function funcError() {
           
        });
    }

    function actionTaiLieuDinhKemVanBan(value, row, index) {
        return `<button onclick="downloadFromLink('${row.DuongDan}', '${row.TenFile}')" class='btn btn-primary btn-sm m-l-5 m-r-5 m-t-5 m-b-5'>
            <i class='fa fa-download'></i> Tải xuống</button>`;
    }

    function tenVanBanFormat(value, row, index) {
        return `<a href="javascript:void(0);" onclick="downloadFromLink('${row.DuongDan}', '${row.TenFile}')" >${row.TenFile}</a>`;
    }
</script>

