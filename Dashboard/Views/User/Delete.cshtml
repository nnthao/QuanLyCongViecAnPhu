@using Dashboard.HtmlHelpers;
@using Dashboard.Models.HtmlHelpers
@{
    Layout = null;
}

<div data-backdrop="static" data-keyboard="false" class="modal p-0" id="xoaModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Xóa</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                Bạn muốn xóa người dùng: <strong><span id="maCVDelete"></span></strong>
            </div>
            <div class="modal-footer">
                <button id="btn-loading" type="button" class="btn btn-default invisible" data-dismiss="modal">
                    <img src="~/Content/img/loading.gif" height="25" />
                </button>
                <button type="button" class="btn btn-light" data-dismiss="modal"><i class="fa fa-times"></i> Đóng</button>
                <button type="button" id="btn-delete" class="btn btn-danger"><i class="fa fa-trash"></i> Xóa</button>
            </div>

        </div>
    </div>
</div>