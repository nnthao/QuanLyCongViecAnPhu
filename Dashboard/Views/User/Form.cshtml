@using Dashboard.HtmlHelpers;
@using Dashboard.Models.HtmlHelpers
@{
    var action = Model != 0 ? "Cập nhật" : "Thêm mới";//
    ViewBag.Title = action + " người dùng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model int

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card card-primary">
                    <div class="card-header">
                        <div class="card-title">
                            <b>@ViewBag.Title</b>
                        </div>
                    </div>
                    <div class="card-body">
                        <input type="hidden" id="Id" value="1231" />
                        <div class="row">
                            @Html.CustomTextBox(id: "Name", label: "Tên", col: 6, required: true, length: 100, moreClass: "col-sm-6 col-xs-12")
                            @Html.CustomTextBox(id: "Email", label: "Email", col: 6, required: true, length: 100, moreClass: "col-sm-6 col-xs-12")
                        </div>
                        <div class="row">
                            @Html.CustomTextBox(id: "Phone", label: "Số điện thoại", col: 4, length: 100, moreClass: "col-sm-4 col-xs-12")
                            @Html.CustomTextBox(id: "TelegramId", label: "TelegramId", col: 4, length: 100, moreClass: "col-sm-4 col-xs-12")
                            @Html.CustomTextBox(id: "UserZaloId", label: "ZaloId", col: 4, length: 100, moreClass: "col-sm-4 col-xs-12")
                        </div>
                        <div class="row">
                         
                            @Html.CustomSelect2Empty(id: "VaiTroId", label: "Vai trò", col: 4, moreClass: "col-sm-4 col-xs-12", required: true)
                            @Html.CustomSelect2Empty(id: "NhomVaiTroId", label: "Vai trò khác", col: 8, moreClass: "col-sm-8 col-xs-12")
                        </div>
                        <div class="row">
                            @Html.CustomSelect2Empty(id: "ChucDanhId", label: "Chức danh", col: 4,
                            moreClass: "col-sm-4 col-xs-12", required: true)
                            @Html.CustomSelect2Empty(id: "PhongBanId", label: "Phòng ban", col: 4,
                            moreClass: "col-sm-4 col-xs-12", required: true)
                        </div>
                        <div class="row">
                            @Html.CustomCheckBox(id: "IsLanhDaoPhong", label: "Lãnh đạo phòng", col: 4, moreClass: "col-sm-4 col-xs-12 p-t-15")
                        </div>
                        <div class="row">
                            <div class="txt-middle-line"><span><b>Mật khẩu</b></span></div>
                        </div>
                        <div class="row">
                            @Html.CustomTextBox(id: "NewPassword", label: "Mật khẩu", col: 6, required: true,
                            length: 100, isPasswordType: true, moreClass: "col-sm-12")
                            @Html.CustomTextBox(id: "RePassword", label: "Nhập lại Mật khẩu",
                           required: true, col: 6, length: 100, isPasswordType: true, moreClass: "col-sm-12")
                        </div>
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="modal-footer text-center d-block">
                                    <button id="btn-loading" type="button" class="btn btn-default invisible" data-dismiss="modal">
                                        <img src="~/Content/img/loading.gif" height="25" />
                                    </button>
                                    <a class="btn btn-light mr-2" href="/user">
                                        <i class="fa fa-chevron-left"></i> Quay lại
                                    </a>
                                    <button onclick="addOrUpdate()" class="btn btn-success">
                                        <i class="fa fa-save"></i> @action
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<script>
    const textFields = ["Id", "Name", "Email", "Phone", "NewPassword", "RePassword", "TelegramId", "UserZaloId"];
    const selectFields = ["VaiTroId", "PhongBanId", "ChucDanhId"];
    const radioFields = [];
    const checkBoxFields = ["IsLanhDaoPhong"];
    const select2MultiFields = ["NhomVaiTroId"];

    function loadData() {
        showLoadingModal();
        ajaxGet("/User/GetUserById?id=" + @Model, function funcCallback(res) {
            let rolesData = res.Roles.Data.slice(1);
            $("#NhomVaiTroId").select2({
                data: rolesData,
                language: "vi",
                multiple: true
            });

            $("#VaiTroId").select2({
                data: res.Roles.Data,
                language: "vi"
            });

            $("#ChucDanhId").select2({
                data: res.ChucDanh.Data,
                language: "vi"
            });

            $("#PhongBanId").select2({
                data: res.PhongBan.Data,
                language: "vi"
            });

            if (res.Item) {
                setTimeout(function () {
                    FormHelper.setValueForUpdate(res.Item, textFields, selectFields, radioFields, checkBoxFields);

                    for (let i = 0; i < select2MultiFields.length; i++) {
                        if ($("#" + select2MultiFields[i])) {
                            $("#" + select2MultiFields[i])
                                .val(res.Item[select2MultiFields[i]] ? res.Item[select2MultiFields[i]].split(',') : "")
                                .trigger("change");
                        }
                    }

                    hideLoadingModal();
                }, 300);
            }
        }, function funcError() {
            toastr.error("Đã có lỗi xảy ra. Vui lòng tải lại trang.");
        });
    }

    function getFormData() {
        var fd = FormHelper.getFormData(textFields, selectFields, radioFields, checkBoxFields);
        fd.append("NhomVaiTroId", $("#NhomVaiTroId").val().join());
        return fd;
    }

    function addOrUpdate() {
        showLoadingModal();

        var selectAll = selectFields.concat(select2MultiFields);
        FormHelper.clearError(textFields, selectAll, radioFields, checkBoxFields);

        ajaxPostFormData("/user/ThemOrCapNhat", getFormData(), function funcCallback(data) {
            hideLoadingModal();
            if (data.Errors && data.Errors.length > 0) {
                data.Errors.map((item) => {
                    var idError = "#" + item.Name;
                    $(idError).show();
                    $(idError).text(item.Description);
                    return "";
                });
            } else {
                window.location.href = "/user";
            }
        }, function funcError() {
            toastr.error("Đã có lỗi xảy ra. Vui lòng tải lại trang.");
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
        loadData();
    });
</script>