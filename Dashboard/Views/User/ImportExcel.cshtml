@using Dashboard.HtmlHelpers;
@using Dashboard.Models.HtmlHelpers
@{
    Layout = null;
}

<div data-backdrop="static" data-keyboard="false" class="modal p-0 them-sua-dv" id="importExcelModal" >
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Import Excel</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row">
                    @Html.CustomSingleFileInput(id: "FileDinhKem", label: "File import", col: 6,
                     moreClass: "col-sm-6 col-xs-12", required: true)
                    <div class="col-sm-12 text-center m-t-10">
                        <a href="javascript:void(0);" onclick="taiFileMau();">
                            <i class="fa fa-cloud-download"></i> Tải file mẫu
                        </a>
                    </div>
                    <div class="col-sm-12">
                        <p id="customFileError" class="text-danger m-t-5"></p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button id="btn-loading" type="button" class="btn btn-default invisible" data-dismiss="modal">
                    <img src="~/Content/img/loading.gif" height="25" />
                </button>
                <button type="button" class="btn btn-success" id="btn-Import"><i class="fa fa-save"></i> Import</button>
                <button type="button" class="btn btn-light" data-dismiss="modal"><i class="fa fa-times"></i> Đóng</button>
            </div>

        </div>
    </div>
</div>