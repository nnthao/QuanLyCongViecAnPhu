@using Dashboard.HtmlHelpers;
@using Dashboard.Models.HtmlHelpers
@using Dashboard.Models.HtmlHelpers.Input
@{
    var action = Model != 0 ? "Cập nhật" : "Thêm";
    ViewBag.Title = action + " văn bản pháp luật";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model int

<style>
    .tbVaiTroGrid th, .tbVaiTroGrid td {
        padding: 5px 10px;
    }
</style>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card card-primary">
                    <div class="card-header">
                        <div class="card-title">
                            <b>@ViewBag.Title </b>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <input id="Id" value="@Model" type="hidden" />
                            @Html.CustomTextArea(id: "TrichYeu", label: "Trích yếu", col: 12, required: true, row: 3)
                            @Html.CustomTextBox(id: "SoKiHieu", label: "Số ký hiệu", col: 3, required: true, length: 100)
                            @Html.CustomDatePicker(id: "NgayBanHanhStr", label: "Ngày ban hành", col: 4, required: true)
                        </div>

                        <div class="row">
                            @Html.CustomSelect2Empty(id: "HinhThucVanBanId", label: "Hình thức văn bản", col: 4, required: true)
                            @Html.CustomSelect2Empty(id: "CoQuanBanHanhId", label: "Cơ quan ban hành", col: 4, required: true)
                            @Html.CustomSelect2Empty(id: "DoKhanId", label: "Độ khẩn", col: 4, required: true)
                        </div>
                        @Html.Partial("~/Views/VanBanPhapLuat/_TaiLieu.cshtml")
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="modal-footer text-center d-block">
                                    <button id="btn-loading" type="button" class="btn btn-default invisible" data-dismiss="modal">
                                        <img src="~/Content/img/loading.gif" height="25" />
                                    </button>
                                    <a class="btn btn-light mr-2" href="/VanBanPhapLuat"><i class="fa fa-chevron-left"></i> Quay lại</a>
                                    <button onclick="addOrUpdate()" class="btn btn-success"><i class="fa fa-save"></i> @action</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
<script>
    const textFields = ["Id", "TrichYeu", "SoKiHieu", "NgayBanHanhStr"];
    const selectFields = ["HinhThucVanBanId", "CoQuanBanHanhId", "DoKhanId"];
    const radioFields = [];
    const checkBoxFields = [];
    const select2MultiFields = ["NhomVaiTroId"];


    function loadData() {
        showLoadingModal();

        showLoadingModal();
        ajaxGet("/VanBanPhapLuat/GetById?id=" + @Model, function calFunction(res) {
            $("#HinhThucVanBanId").select2({
                data: res.HinhThucs.Data,
                language: "vi"
            });
            $("#CoQuanBanHanhId").select2({
                data: res.CoQuans.Data,
                language: "vi"
            });
            $("#DoKhanId").select2({
                data: res.DoKhans.Data,
                language: "vi"
            });
            if (res.Item) {
                setTimeout(function () {
                    FormHelper.setValueForUpdate(res.Item, textFields, selectFields, radioFields, checkBoxFields);

                    for (let i = 0; i < select2MultiFields.length; i++) {
                        if ($("#" + select2MultiFields[i])) {
                            $("#" + select2MultiFields[i]).val(res.Item[select2MultiFields[i]] ? res.Item[select2MultiFields[i]].split(',') : "").trigger("change");
                        }
                    }

                    hideLoadingModal();
                }, 300);
            }
            hideLoadingModal();
        }, function errFunct(err) {
            toastr.error("Đã có lỗi xảy ra. Vui lòng tải lại trang.");
        });
    }

    function getFormData() {
        var fd = FormHelper.getFormData(textFields, selectFields, radioFields, checkBoxFields);
        //lay file ID
        let listIds = TaiLieuDinhKemDatas.map(x => x.Id);
        fd.append("TaiLieuDinhKemIds", listIds.join(','));
        // save file
        for (let i = 0; i < TaiLieuDinhKemDatas.length; i++) {
            if (TaiLieuDinhKemDatas[i].IsUpload == false) {
                fd.append("FileDinhKems", TaiLieuDinhKemDatas[i].File, TaiLieuDinhKemDatas[i].TenFile || TaiLieuDinhKemDatas[i].File.name);
            }
        }
        return fd;
    }

    function addOrUpdate() {
        showLoadingModal();

        var selectAll = selectFields.concat(select2MultiFields);
        FormHelper.clearError(textFields, selectAll, radioFields, checkBoxFields);

        ajaxPostFormData("/VanBanPhapLuat/ThemOrCapNhat", getFormData(), function funcCallback(data) {
            hideLoadingModal();
            if (data.Errors && data.Errors.length > 0) {
                data.Errors.map((item) => {
                    var idError = "#" + item.Name;
                    $(idError).show();
                    $(idError).text(item.Description);
                    return "";
                });
            } else {
                window.location.href = "/VanBanPhapLuat";
            }
        }, function funcError() {
            toastr.error("Đã có lỗi xảy ra. Vui lòng tải lại trang.");
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
        loadData();
    });
</script>

